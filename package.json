{
  "name": "letsauth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate:data && astro build && pnpm check:links",
    "preview": "astro preview",
    "generate:brand": "tsx scripts/generate-brand-assets.ts",
    "generate:readme": "tsx scripts/generate-readme-assets.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:append-only": "tsx scripts/check-observations-append-only.ts",
    "observe": "tsx scripts/observe.ts",
    "scan": "tsx scripts/scan.ts",
    "scan:nightly": "tsx scripts/scan-nightly.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm validate:data && pnpm lint && pnpm check:prose && pnpm typecheck && pnpm test && astro build && pnpm check:links && pnpm check:budgets",
    "check:budgets": "tsx scripts/check-budgets.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:prose": "tsx scripts/check-prose.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "^7.3.8",
    "astro-pagefind": "^2.0.1",
    "svelte": "^5.57.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  }
}
