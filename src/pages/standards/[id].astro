---
import Citation from "@/components/Citation.astro";
import Crumbs from "@/components/Crumbs.astro";
import Facts from "@/components/Facts.astro";
import MaturityTag from "@/components/MaturityTag.astro";
import Plate from "@/components/Plate.astro";
import RelationList from "@/components/RelationList.astro";
import Base from "@/layouts/Base.astro";
import { ATLAS_SPEC } from "@/lib/atlas";
import { getDataset } from "@/lib/data";
import {
  BODY_LABEL,
  CATEGORY_LABEL,
  FAMILY_LABEL,
  MATURITY_LABEL,
  PARTY_LABEL,
} from "@/lib/labels";
import {
  adjacentRevisionPairs,
  currentRevisionOf,
  featuresDefinedBy,
  relationsOf,
  specRevisionsNewestFirst,
} from "@/lib/standards";
import { featureLevel, type Spec } from "@/schema";

export function getStaticPaths() {
  return getDataset().specs.map((spec) => ({ params: { id: spec.id }, props: { spec } }));
}

const { spec } = Astro.props as { spec: Spec };
const data = getDataset();
const current = currentRevisionOf(spec);
const revisions = specRevisionsNewestFirst(spec);
const groups = relationsOf(data, spec.id);
const defined = featuresDefinedBy(data, spec.id);
// the MCP atlas renders revision diffs for its spec; this page links to them (FR-016)
const diffHref = new Map<string, string>();
if (spec.id === ATLAS_SPEC) {
  for (const [older, newer] of adjacentRevisionPairs(spec)) {
    diffHref.set(newer.id, `/mcp/changes/${older.id}/${newer.id}/`);
  }
}
// features by topic, in the order the matrix uses, and how many carry each level
const topics = [...Map.groupBy(defined, (d) => d.feature.category)];
const levels = [...Map.groupBy(defined, (d) => d.entry.level)]
  .map(([level, items]) => [level, items.length] as const)
  .sort((a, b) => featureLevel.options.indexOf(a[0]) - featureLevel.options.indexOf(b[0]));
const gone = spec.maturity === "withdrawn" || spec.maturity === "expired";
const repoFile = `https://github.com/letsauthlab/letsauth/blob/main/data/specs/${spec.id}.yaml`;
---

<Base
  title={spec.name}
  description={`${spec.name}: what it is, who publishes it, its revisions and how it relates to the other standards for agent authorization.`}
  path={`/standards/${spec.id}/`}
  noindex={spec.maturity === "withdrawn"}
>
  <div class="wrap">
    <Crumbs trail={[{ href: "/standards/", label: "Standards" }]} current={spec.name} />
    <header class="page-head">
      <Plate id={spec.id} title={spec.name} />
      <p class="eyebrow">{BODY_LABEL[spec.body]} / {FAMILY_LABEL[spec.family]}</p>
      <h1>{spec.name}</h1>
      <p class="lede">{spec.summary}</p>
      <p class="page-head__meta">
        <MaturityTag maturity={spec.maturity} variant="label" />
        {spec.maturityNote && <span class="note">{spec.maturityNote}</span>}
        <span aria-hidden="true">/</span>
        <a href={spec.url} rel="noopener">Canonical document</a>
        <span aria-hidden="true">/</span>
        <code>{spec.id}</code>
      </p>
    </header>

    <div class="entry">
      <div class="entry__main">
        {
          gone && (
            <section class="notice gone" aria-labelledby="gone">
              <h2 id="gone">{MATURITY_LABEL[spec.maturity]}</h2>
              <p>
                {spec.maturity === "withdrawn"
                  ? "This document was withdrawn. It no longer appears on the map, but its page, its revisions and its relations stay so that links and history keep working."
                  : "This document has expired. It stays on the map, marked as expired, because other documents still relate to it."}
                {spec.maturityNote && <> {spec.maturityNote}.</>}
              </p>
            </section>
          )
        }

        <section aria-labelledby="relations">
          <h2 id="relations">
            Relations <span class="n">{groups.total}</span>
          </h2>
          <RelationList groups={groups} />
        </section>

        {
          defined.length > 0 && (
            <section aria-labelledby="defines">
              <h2 id="defines">
                Features <span class="n">{defined.length}</span>
              </h2>
              <p class="note">
                What revision <code>{current.id}</code> asks of clients and servers, as the MCP
                auth atlas observes it, grouped by topic.
              </p>
              <p class="levels" data-levels>
                <span class="levels__bar" aria-hidden="true">
                  {levels.map(([level, n]) => (
                    <span class={`level-${level}`} style={`flex-grow:${n}`} />
                  ))}
                </span>
                {levels.map(([level, n]) => (
                  <span class="levels__key">
                    <span class:list={["level", `level-${level}`]}>{level}</span> {n}
                  </span>
                ))}
              </p>
              <div class="topics" data-defines>
                {topics.map(([category, items]) => (
                  <section class="topic" aria-labelledby={`topic-${category}`}>
                    <h3 id={`topic-${category}`}>
                      {CATEGORY_LABEL[category]} <span class="n">{items.length}</span>
                    </h3>
                    <ul class="features" role="list">
                      {items.map(({ feature, entry }) => (
                        <li data-feature={feature.id}>
                          <span class="features__head">
                            <a href={`/mcp/features/${feature.id}/`}>{feature.name}</a>
                            <span class:list={["level", `level-${entry.level}`]}>{entry.level}</span>
                          </span>
                          <span class="meta">
                            {PARTY_LABEL[feature.party]} / <Citation entry={entry} />
                          </span>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="entry__side panel" aria-label="Facts">
        <Facts
          label="In numbers"
          items={[
            { label: "Revisions", value: revisions.length },
            { label: "Relations", value: groups.total },
            ...(defined.length > 0 ? [{ label: "Features", value: defined.length }] : []),
          ]}
        />
        {
          defined.length === 0 && (
            <p class="note" data-no-features>
              No features of this document are recorded yet. They are added when the atlases
              observe them or the explorer cites them.
            </p>
          )
        }
        <section aria-labelledby="revisions">
          <h2 id="revisions">Revisions</h2>
          <ol class="timeline revisions" data-revisions>
            {
              revisions.map((r) => (
                <li data-revision={r.id} data-status={r.status}>
                  <time datetime={r.date}>{r.date}</time>
                  <div class="rev-head">
                    <a href={r.url} rel="noopener" class="rev-id">
                      {r.id}
                    </a>
                    <span class:list={["chip", { signal: r.status === "current" }]}>{r.status}</span>
                  </div>
                  {r.changes && <p class="changes">{r.changes}</p>}
                  {diffHref.has(r.id) && (
                    <a class="diff" href={diffHref.get(r.id)}>
                      What changed since {r.supersedes}
                    </a>
                  )}
                </li>
              ))
            }
          </ol>
        </section>
      </aside>
    </div>

    <footer class="page-foot prose">
      <p>
        Maturity is the publisher's own status, and dates are the document's own. To correct this
        entry, edit <a href={repoFile} rel="noopener">its data file</a> and open a pull request;
        see <a href="https://github.com/letsauthlab/letsauth/blob/main/docs/atlas-maintenance.md" rel="noopener">the maintenance guide</a>.
      </p>
      <p class="page-foot__links">
        <a href="/standards/">Back to the map</a>
        <a href="/standards/data.json">Download the data</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  /* M2: the map node or list entry the reader followed grows into this title */
  .page-head h1 {
    view-transition-name: spec-title;
  }
  .gone {
    margin-bottom: var(--space-7);
    font-size: var(--small);
  }
  .gone h2 {
    font-size: var(--h3);
    margin-top: 0;
  }

  /*
   * The entry: relations and features in the wide column, the figures and the revisions beside
   * them in one panel that stays in view, as on a breach page. One column below 60rem, where
   * the panel follows the relations.
   */
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 21rem);
    gap: var(--space-7);
    align-items: start;
  }
  .entry__main {
    min-width: 0;
  }
  .entry__main > section + section {
    margin-top: var(--space-7);
  }
  .entry h2 {
    font-size: var(--h3);
    margin: 0 0 var(--space-4);
  }
  .entry__side {
    position: sticky;
    top: var(--space-5);
    display: grid;
    gap: var(--space-5);
  }
  .entry__side h2 {
    font-size: var(--small);
    font-weight: 600;
    letter-spacing: 0;
    margin-bottom: var(--space-3);
  }
  .entry__side .facts {
    gap: var(--space-4) var(--space-6);
  }
  .entry__side > .note {
    margin: 0;
  }

  .revisions {
    margin: 0;
  }
  .rev-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-1);
    font-size: var(--small);
  }
  .rev-id {
    font-family: var(--font-mono);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .changes {
    margin: var(--space-2) 0 0;
    font-size: var(--small);
    color: var(--ink-2);
  }
  .diff {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--tiny);
  }

  /* M13: the rail draws in from the top, then the entries fade in behind it; once, on load */
  @media (prefers-reduced-motion: no-preference) {
    .revisions::before {
      transform-origin: top;
      animation: rail-down var(--dur-slow) var(--ease-draw) both;
    }
    .revisions > li {
      animation: fade-in var(--dur) var(--ease) both;
      animation-delay: calc(var(--dur-slow) * 0.6);
    }
    .revisions > li + li {
      animation-delay: var(--dur-slow);
    }
  }
  @keyframes rail-down {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  /* how many features carry each level: a bar in the level inks, with the words beside it */
  .levels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-6);
    max-width: none;
    font-size: var(--small);
    font-variant-numeric: tabular-nums;
  }
  .levels__bar {
    display: flex;
    gap: 2px;
    flex: 1 1 12rem;
    max-width: 24rem;
    height: 6px;
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .levels__bar > span {
    background: currentColor;
  }
  .levels__key {
    white-space: nowrap;
  }

  /* topics pack into columns like the relation groups */
  .topics {
    columns: 19rem;
    column-gap: var(--space-6);
  }
  .topic {
    break-inside: avoid;
    margin-bottom: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule-strong);
  }
  .topic h3 {
    font-size: var(--small);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink-2);
    margin: 0 0 var(--space-3);
  }
  .features {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--small);
  }
  .features li {
    display: grid;
    gap: 0.15rem;
    margin: 0;
  }
  .features__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .features__head a {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .features__head a:hover {
    color: var(--signal);
  }
  .features .meta {
    color: var(--ink-2);
    font-size: var(--tiny);
  }
  .features .meta :global(.citation) {
    font-size: var(--tiny);
  }

  @media (max-width: 60rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7);
    }
    .entry__side {
      position: static;
    }
  }
</style>
