---
import MaturityTag from "@/components/MaturityTag.astro";
import StandardsMap from "@/components/StandardsMap.astro";
import StandardsMapIsland from "@/components/StandardsMap.svelte";
import Base from "@/layouts/Base.astro";
import { getDataset } from "@/lib/data";
import { layoutGraph } from "@/lib/graph";
import {
  BODY_LABEL,
  FAMILY_LABEL,
  MATURITY_LABEL,
  MATURITY_ORDER,
  RELATION_DESCRIPTION,
  RELATION_LABEL,
} from "@/lib/labels";
import {
  currentRevisionOf,
  mapRelations,
  RELATION_TYPES,
  recentlyRevised,
  specNodes,
  specsByBody,
  withdrawnSpecs,
} from "@/lib/standards";

const data = getDataset();
const nodes = specNodes(data);
const relations = mapRelations(data);
const layout = layoutGraph(nodes, relations);
const groups = specsByBody(nodes);
const withdrawn = withdrawnSpecs(data);
const recent = recentlyRevised(data, 5);
const bodies = groups.map((g) => g.body);
const usedTypes = RELATION_TYPES.filter((t) => relations.some((r) => r.type === t));
const usedMaturities = MATURITY_ORDER.filter((m) => nodes.some((s) => s.maturity === m));
const repo = "https://github.com/letsauthlab/letsauth";
---

<Base
  title="Agent auth atlas"
  description={`The standards map for agent authorization: ${nodes.length} specifications, drafts and EU acts from ${bodies.length} publishing bodies and the ${relations.length} relations between them, each with its maturity and dated revisions.`}
  path="/standards/"
>
  <div class="wrap">
    <header class="page-head standards-head">
      <div class="standards-head__copy">
        <p class="eyebrow">Agent auth atlas</p>
        <h1>The standards that decide how agents are authorized, and how they relate</h1>
        <p class="lede">
          One map of the OAuth extensions, workload identity drafts, agent protocols, credential
          formats and EU acts that an agent, an MCP server or an identity provider has to follow.
          Every node is a specification with dated revisions; every line is a typed relation with
          a note on what it is based on.
        </p>
      </div>
      <dl class="facts" aria-label="Map at a glance">
        <div>
          <dt>Specifications</dt>
          <dd class="num">{nodes.length}</dd>
        </div>
        <div>
          <dt>Relations</dt>
          <dd class="num">{relations.length}</dd>
        </div>
        <div>
          <dt>Publishing bodies</dt>
          <dd class="num">{bodies.length}</dd>
        </div>
      </dl>
      <p class="recent">
        <span class="recent__label">Recently revised</span>
        {
          recent.map(({ spec, revision }, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={`/standards/${spec.id}/`}>{spec.name}</a>{" "}
              <time datetime={revision.date}>{revision.date}</time>
            </>
          ))
        }
      </p>
    </header>

    <form id="map-filters" class="filters card" method="get" action="/standards/">
      <fieldset>
        <legend>Relation types</legend>
        {
          usedTypes.map((t) => (
            <label class="check">
              <input type="checkbox" name="type" value={t} />
              <span class:list={["sample", `sample-${t}`]} aria-hidden="true" />
              {RELATION_LABEL[t].forward}
            </label>
          ))
        }
      </fieldset>
      <fieldset>
        <legend>Publishing bodies</legend>
        {
          bodies.map((b) => (
            <label class="check">
              <input type="checkbox" name="body" value={b} />
              {BODY_LABEL[b]}
            </label>
          ))
        }
      </fieldset>
      <div class="actions">
        <button type="submit" class="button small">Apply</button>
        <button type="reset" class="button small">Reset</button>
        <p id="map-count" class="count" aria-live="polite">
          {nodes.length} of {nodes.length} specifications, {relations.length} of{" "}
          {relations.length} relations
        </p>
      </div>
      <noscript>
        <p class="note" data-noscript-note>
          Filtering needs JavaScript; the full map and list are shown below.
        </p>
      </noscript>
    </form>

    <StandardsMap layout={layout} />
    <StandardsMapIsland client:idle />

    <section class="legend" aria-labelledby="legend-title">
      <h2 id="legend-title">Legend</h2>
      <div class="legend__cols">
        <dl class="legend__list">
          {
            usedTypes.map((t) => (
              <>
                <dt>
                  <span class:list={["sample", `sample-${t}`]} aria-hidden="true" />
                  {RELATION_LABEL[t].forward}
                </dt>
                <dd>{RELATION_DESCRIPTION[t]}</dd>
              </>
            ))
          }
        </dl>
        <dl class="legend__list">
          {
            usedMaturities.map((m) => (
              <>
                <dt>
                  <MaturityTag maturity={m} variant="label" />
                </dt>
                <dd>{MATURITY_LABEL[m]} is the publisher's status, not a grade.</dd>
              </>
            ))
          }
        </dl>
      </div>
    </section>

    <section id="spec-list" class="list" aria-labelledby="list-title">
      <h2 id="list-title">Every specification on the map</h2>
      {
        groups.map((g) => (
          <section class="body-group" data-body-group={g.body} aria-labelledby={`body-${g.body}`}>
            <h3 id={`body-${g.body}`}>{BODY_LABEL[g.body]}</h3>
            <ul>
              {g.specs.map((spec) => {
                const current = currentRevisionOf(spec);
                return (
                  <li data-spec={spec.id} data-body={spec.body}>
                    <span class="who">
                      <a href={`/standards/${spec.id}/`}>{spec.name}</a>
                      <MaturityTag maturity={spec.maturity} note={spec.maturityNote} />
                    </span>
                    <span class="meta">
                      {FAMILY_LABEL[spec.family]} · {current.id}{" "}
                      <time datetime={current.date}>{current.date}</time> ·{" "}
                      <a href={spec.url} rel="noopener">
                        Document
                      </a>
                    </span>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
      {
        withdrawn.length > 0 && (
          <section class="body-group" aria-labelledby="body-withdrawn">
            <h3 id="body-withdrawn">Withdrawn</h3>
            <p class="note">
              Withdrawn documents leave the map but keep their page and their relations.
            </p>
            <ul>
              {withdrawn.map((spec) => (
                <li data-withdrawn={spec.id}>
                  <span class="who">
                    <a href={`/standards/${spec.id}/`}>{spec.name}</a>
                    <MaturityTag maturity={spec.maturity} note={spec.maturityNote} />
                  </span>
                  <span class="meta">{BODY_LABEL[spec.body]}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </section>

    <footer class="page-foot prose">
      <h2>Contribute</h2>
      <p>
        Specifications live one per file under <code>data/specs/</code>; relations in
        <code>data/relations.yaml</code>. A relation of a judgement type (competes with, solves
        the same problem as) carries a note saying what it is based on. The build rejects a
        relation to an unknown document and names the field. See
        <a href={`${repo}/blob/main/docs/atlas-maintenance.md`} rel="noopener">the maintenance guide</a>.
      </p>
      <p>
        <a href="/standards/data.json">Download the map as JSON</a> ·
        <a href={`${repo}/tree/main/data`} rel="noopener">Browse the data</a> ·
        <a href="/mcp/">MCP auth atlas</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  .standards-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-4) var(--space-7);
    align-items: end;
  }
  .standards-head__copy .lede {
    margin-bottom: 0;
  }
  .facts {
    display: flex;
    gap: var(--space-6);
    margin: 0 0 var(--space-2);
    padding-left: var(--space-6);
    border-left: 1px solid var(--line);
  }
  .facts dt {
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
  }
  .recent {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    max-width: none;
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    line-height: 1.8;
  }
  .recent__label {
    font-size: var(--text-2xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-right: var(--space-2);
  }
  .recent time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin-bottom: var(--space-4);
    padding: var(--space-4) var(--space-5);
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: center;
  }
  legend {
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: 0;
    margin-bottom: var(--space-2);
    width: 100%;
  }
  .check {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .check input {
    accent-color: var(--accent);
    width: 1rem;
    height: 1rem;
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    width: 100%;
  }
  .count {
    margin: 0 0 0 auto;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .note {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin: 0;
  }
  /* Line samples match the SVG edge styles: dash pattern first, colour second. */
  .sample {
    display: inline-block;
    width: 2.2rem;
    height: 0;
    border-top: 2px solid var(--ink-faint);
    vertical-align: middle;
  }
  .sample-builds-on {
    border-top-color: var(--accent);
  }
  .sample-profiles {
    border-top-style: dashed;
    border-top-color: var(--accent);
  }
  .sample-replaces {
    border-top-width: 3px;
    border-top-color: var(--level-deprecated);
  }
  .sample-references {
    border-top-style: dotted;
  }
  .sample-competes-with {
    border-top-style: dashed;
    border-top-width: 3px;
    border-top-color: var(--accent-2);
  }
  .sample-solves-same-problem-as {
    border-top-style: dotted;
    border-top-width: 3px;
    border-top-color: var(--level-may);
  }
  .legend {
    margin-top: var(--space-6);
  }
  .legend h2,
  .list h2 {
    font-size: var(--text-xl);
  }
  .legend__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .legend__list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-sm), var(--inset-highlight);
    align-content: start;
  }
  .legend__list dt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }
  .legend__list dd {
    margin: 0;
    color: var(--ink-muted);
  }
  .body-group {
    margin-bottom: var(--space-6);
  }
  .body-group h3 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--ink-muted);
    font-size: var(--text-2xs);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }
  .body-group h3::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .body-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: var(--space-3) var(--space-5);
  }
  .body-group li {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    background: color-mix(in oklch, var(--bg-elevated) 60%, transparent);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .body-group li:hover {
    border-color: var(--line-strong);
  }
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }
  .who a {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .who a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .meta {
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }
  .meta time {
    font-family: var(--font-mono);
  }
  .page-foot {
    margin-top: var(--space-6);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .page-foot h2 {
    font-size: var(--text-lg);
    color: var(--ink);
  }
  @media (max-width: 56rem) {
    .standards-head {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .facts {
      border-left: 0;
      padding-left: 0;
      gap: var(--space-5);
    }
  }
  @media (max-width: 40rem) {
    .count {
      margin-left: 0;
    }
    .legend__list {
      grid-template-columns: 1fr;
      gap: var(--space-1) 0;
    }
    .legend__list dd {
      margin-bottom: var(--space-3);
    }
  }
</style>
