---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Page not found"
  description="There is no page at this address on letsauth.eu."
  path="/404.html"
  noindex
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">404</p>
      <h1>No page at this address</h1>
      <p class="lede">
        The link may be old, or the address may have a typo. Ids in the atlas never change once
        published, so a missing server or feature page usually means a typo.
      </p>
    </header>
    <p class="cta">
      <a class="button" href="/">Go to the home page</a>
      <a class="button quiet" href="/mcp/">Servers</a>
      <a class="button quiet" href="/standards/">Standards</a>
    </p>
    <p class="muted">
      If a link on this site brought you here, please{" "}
      <a href="https://github.com/letsauthlab/letsauth/issues/new" rel="noopener">report it</a>.
    </p>
  </div>
</Base>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0 0 var(--space-5);
  }
</style>
