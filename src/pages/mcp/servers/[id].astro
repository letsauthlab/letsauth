---
import Citation from "@/components/Citation.astro";
import Crumbs from "@/components/Crumbs.astro";
import StatusCell from "@/components/StatusCell.astro";
import Base from "@/layouts/Base.astro";
import {
  cellHistory,
  currentCell,
  currentRevision,
  featureInRevision,
  matrixColumns,
  revisionsNewestFirst,
} from "@/lib/atlas";
import {
  ACCESS_DESCRIPTION,
  ACCESS_LABEL,
  AUTH_DESCRIPTION,
  AUTH_LABEL,
  accessOf,
  authOf,
} from "@/lib/classes";
import { getDataset } from "@/lib/data";
import { CATEGORY_LABEL, METHOD_LABEL, PARTY_LABEL } from "@/lib/labels";
import { latestScan } from "@/lib/scanner";
import type { Server } from "@/schema";

export function getStaticPaths() {
  return getDataset().servers.map((server) => ({ params: { id: server.id }, props: { server } }));
}

const { server } = Astro.props as { server: Server };
const data = getDataset();
const revision = currentRevision(data);
const revisions = revisionsNewestFirst(data);
const columns = matrixColumns(data, revision.id);
const parties = ["mcp-server", "authorization-server"] as const;

const LISTED_LABEL: Record<Server["listed"], string> = {
  "opt-in": "The maintainer asked for this server to be listed.",
  "public-directory": "Listed because it appears in a public directory of MCP servers.",
  "maintainer-added": "Added by the atlas maintainer from the vendor's own documentation.",
};
const TRANSPORT_LABEL: Record<Server["transport"], string> = {
  "streamable-http": "Streamable HTTP",
  sse: "HTTP with SSE",
  "stdio-only": "stdio only (no HTTP transport)",
};
const evidenceUrl = (s: string) => s.match(/^(https:\/\/\S+)/)?.[1];
const issueBase = "https://github.com/letsauthlab/letsauth/issues/new?template=observation.yml";
const counts = { supported: 0, partial: 0, unsupported: 0, unknown: 0, "not-applicable": 0 };
for (const f of columns) counts[currentCell(data, server, f, revision.id).status] += 1;
const STATUSES = ["supported", "partial", "unsupported", "unknown", "not-applicable"] as const;
const pct = (n: number) => Math.round((n / columns.length) * 1000) / 10;
const scanView = latestScan(data, server);
const access = accessOf(server);
const auth = authOf(server);
const classes = [
  {
    key: "access",
    label: "Access",
    view: access,
    name: ACCESS_LABEL[access.value],
    description: ACCESS_DESCRIPTION[access.value],
    statement: server.access,
  },
  {
    key: "auth",
    label: "Auth",
    view: auth,
    name: AUTH_LABEL[auth.value],
    description: AUTH_DESCRIPTION[auth.value],
    statement: server.auth,
  },
];
---

<Base
  title={server.name}
  description={`${server.name}'s support for the MCP Authorization specification, revision ${revision.id}: current status per feature with the observations behind it.`}
  path={`/mcp/servers/${server.id}/`}
  noindex={Boolean(server.withdrawn)}
>
  <div class="wrap">
    <Crumbs trail={[{ href: "/mcp/", label: "MCP auth atlas" }]} current={server.name} />
    <header class="page-head">
      <p class="eyebrow">Server</p>
      <h1>{server.name}</h1>
      {server.vendor && server.vendor !== server.name && <p class="lede">by {server.vendor}</p>}
    </header>

    {
      server.withdrawn ? (
        <section class="card notice" aria-labelledby="withdrawn">
          <h2 id="withdrawn">Withdrawn from the atlas</h2>
          <p>
            This server was withdrawn on{" "}
            <time datetime={server.withdrawn.at}>{server.withdrawn.at}</time> and no longer
            appears in the matrix. Reason given: {server.withdrawn.reason}.
          </p>
          <p>
            Its observations stay in the repository history, but no status is shown here. The
            maintainer can ask to be relisted through the <a href="/contribute/">contribution page</a>.
          </p>
        </section>
      ) : (
        <>
          <div class="profile">
            <section class="card profile__facts" aria-label="Profile">
              <dl class="kv">
                <dt>Endpoint</dt>
                <dd>
                  <code>{server.url}</code>
                </dd>
                <dt>Transport</dt>
                <dd>{TRANSPORT_LABEL[server.transport]}</dd>
                {classes.map((c) => (
                  <>
                    <dt>{c.label}</dt>
                    <dd data-class={c.key} data-value={c.view.value} data-derived={c.view.derived ? "true" : "false"}>
                      <span class:list={["pill", { accent: !c.view.derived && c.view.value !== "unknown" }]}>{c.name}</span>
                      {c.statement ? (
                        <span class="class-statement">
                          {" "}
                          {c.description}{" "}
                          <span class="muted">
                            {METHOD_LABEL[c.statement.method]} · {c.statement.observedBy} ·{" "}
                            <time datetime={c.statement.observedAt}>{c.statement.observedAt.slice(0, 10)}</time> ·{" "}
                            {evidenceUrl(c.statement.evidence) ? (
                              <>
                                <a href={evidenceUrl(c.statement.evidence)} rel="noopener">
                                  evidence
                                </a>
                                {c.statement.evidence.replace(/^https:\/\/\S+\s*/, "").replace(/^—\s*/, "") && (
                                  <> · {c.statement.evidence.replace(/^https:\/\/\S+\s*/, "").replace(/^—\s*/, "")}</>
                                )}
                              </>
                            ) : (
                              c.statement.evidence
                            )}
                          </span>
                        </span>
                      ) : (
                        <span class="muted"> nobody has stated this yet</span>
                      )}
                    </dd>
                  </>
                ))}
                <dt>Why it is listed</dt>
                <dd>
                  {LISTED_LABEL[server.listed]}{" "}
                  {server.source && (
                    <a href={server.source} rel="noopener">
                      Source
                    </a>
                  )}
                </dd>
                {server.homepage && (
                  <>
                    <dt>Homepage</dt>
                    <dd>
                      <a href={server.homepage} rel="noopener">
                        {server.homepage}
                      </a>
                    </dd>
                  </>
                )}
                {server.notes && (
                  <>
                    <dt>Notes</dt>
                    <dd>{server.notes}</dd>
                  </>
                )}
              </dl>
            </section>

            <section class="card profile__status" aria-label="Status summary">
              <p class="profile__status-title">
                Against <strong>MCP Authorization {revision.id}</strong>
                <span class="pill accent">current</span>
              </p>
              <div
                class="bar"
                role="img"
                aria-label={`Of ${columns.length} requirements: supported ${counts.supported}, partial ${counts.partial}, unsupported ${counts.unsupported}, unknown ${counts.unknown}, not applicable ${counts["not-applicable"]}`}
              >
                {STATUSES.filter((st) => counts[st] > 0).map((st) => (
                  <span class={`seg seg-${st}`} style={`flex-basis:${pct(counts[st])}%`} />
                ))}
              </div>
              <ul class="summary">
                {STATUSES.filter((st) => counts[st] > 0).map((st) => (
                  <li>
                    <StatusCell status={st} variant="label" /> <span class="n num">{counts[st]}</span>
                  </li>
                ))}
              </ul>
              <p class="scan" data-scan={scanView.scanned ? "scanned" : "not-scanned"}>
                <span class="scan__label">Passive scan</span>
                {scanView.scanned ? (
                  <>
                    <strong>{scanView.grade.letter ? `Grade ${scanView.grade.letter}` : scanView.grade.label}</strong>
                    {" · "}
                    <time datetime={scanView.scannedAt}>{scanView.scannedAt?.slice(0, 10)}</time>
                    {" · "}
                    <a href={`/mcp/servers/${server.id}/scan/`}>Report</a>
                  </>
                ) : (
                  <>
                    <span class="muted">not scanned yet</span>
                    {" · "}
                    <a href={`/mcp/servers/${server.id}/scan/`}>Report</a>
                  </>
                )}
              </p>
              <p class="actions">
                <a class="button small" href={`${issueBase}&title=${encodeURIComponent(`Correction: ${server.name}`)}&server=${server.id}`} rel="noopener">
                  Contribute a correction
                </a>
                <a class="button small" href={`${issueBase}&title=${encodeURIComponent(`Withdraw ${server.name}`)}&server=${server.id}&kind=withdraw`} rel="noopener">
                  Withdraw this server
                </a>
                <a class="button small" href={`/mcp/servers/${server.id}.json`}>JSON</a>
              </p>
            </section>
          </div>

          {revisions.length > 1 && (
            <p class="revision-note">
              Older revisions of the matrix:{" "}
              {revisions
                .filter((r) => r.id !== revision.id)
                .map((r) => (
                  <a href={`/mcp/${r.id}/`}>{r.id}</a>
                ))}
            </p>
          )}

          {parties.map((party) => {
            const features = columns.filter((f) => f.party === party);
            return (
              <section class="party" aria-labelledby={`party-${party}`}>
                <h2 id={`party-${party}`}>
                  {PARTY_LABEL[party]} features <span class="n">{features.length}</span>
                </h2>
                <div class="table-wrap">
                  <table class="features">
                    <thead>
                      <tr>
                        <th scope="col">Feature</th>
                        <th scope="col">Level</th>
                        <th scope="col">Status</th>
                        <th scope="col">Observed</th>
                        <th scope="col">Evidence</th>
                      </tr>
                    </thead>
                    <tbody>
                      {features.map((feature) => {
                        const cell = currentCell(data, server, feature, revision.id);
                        const history = cellHistory(data, server.id, feature.id, revision.id);
                        const entry = featureInRevision(feature, revision.id);
                        const obs = cell.observation;
                        return (
                          <tr data-feature={feature.id} data-status={cell.status}>
                            <th scope="row">
                              <a href={`/mcp/features/${feature.id}/`}>{feature.name}</a>
                              <span class="meta">
                                <code>{feature.id}</code> · {CATEGORY_LABEL[feature.category]}
                                {entry && (
                                  <>
                                    {" · "}
                                    <Citation entry={entry} />
                                  </>
                                )}
                              </span>
                            </th>
                            <td>
                              {entry && <span class:list={["level", `level-${entry.level}`]}>{entry.level}</span>}
                            </td>
                            <td>
                              <StatusCell status={cell.status} derived={cell.derived} variant="label" />
                            </td>
                            <td>
                              {obs ? (
                                <>
                                  <time datetime={obs.observedAt}>{obs.observedAt.slice(0, 10)}</time>
                                  <span class="meta">
                                    {METHOD_LABEL[obs.method]} · {obs.observedBy}
                                  </span>
                                </>
                              ) : (
                                <span class="muted">no observation yet</span>
                              )}
                            </td>
                            <td class="evidence">
                              {obs &&
                                (evidenceUrl(obs.evidence) ? (
                                  <>
                                    <a href={evidenceUrl(obs.evidence)} rel="noopener">
                                      source
                                    </a>
                                    <span class="meta">{obs.evidence.replace(/^https:\/\/\S+\s*/, "")}</span>
                                  </>
                                ) : (
                                  obs.evidence
                                ))}
                              {history.length > 0 && (
                                <details class="history">
                                  <summary>
                                    {history.length} earlier observation{history.length > 1 ? "s" : ""}
                                  </summary>
                                  <ol>
                                    {history.map((h) => (
                                      <li>
                                        <StatusCell status={h.status} variant="label" />{" "}
                                        <time datetime={h.observedAt}>{h.observedAt.slice(0, 10)}</time>
                                        {" · "}
                                        {METHOD_LABEL[h.method]} · {h.observedBy} ·{" "}
                                        {evidenceUrl(h.evidence) ? (
                                          <a href={evidenceUrl(h.evidence)} rel="noopener">
                                            evidence
                                          </a>
                                        ) : (
                                          h.evidence
                                        )}
                                      </li>
                                    ))}
                                  </ol>
                                </details>
                              )}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </section>
            );
          })}
        </>
      )
    }
  </div>
</Base>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .profile__status-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-bottom: var(--space-3);
  }
  .profile__status-title strong {
    color: var(--ink);
    font-weight: 600;
  }
  .class-statement {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
  }
  .class-statement .muted {
    display: block;
    font-size: var(--text-xs);
    margin-top: 0.15rem;
  }
  .bar {
    display: flex;
    gap: 2px;
    height: 0.6rem;
    border-radius: 999px;
    overflow: hidden;
    background: var(--bg-sunken);
    margin: 0 0 var(--space-3);
  }
  .seg {
    display: block;
    flex-grow: 0;
    flex-shrink: 0;
  }
  .seg-supported {
    background: var(--status-supported);
  }
  .seg-partial {
    background: var(--status-partial);
  }
  .seg-unsupported {
    background: var(--status-unsupported);
  }
  .seg-unknown {
    background: color-mix(in oklch, var(--status-unknown) 35%, transparent);
  }
  .seg-not-applicable {
    background: repeating-linear-gradient(
      -45deg,
      transparent 0 3px,
      color-mix(in oklch, var(--status-unknown) 35%, transparent) 3px 6px
    );
  }
  .summary {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .summary .n {
    margin-left: 0.3em;
    font: inherit;
    font-weight: 600;
    color: inherit;
    vertical-align: baseline;
  }
  .scan {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-soft);
  }
  .scan__label {
    font-size: var(--text-2xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--ink-muted);
  }
  .actions {
    margin: 0;
  }
  .revision-note {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }
  .revision-note a {
    margin-right: var(--space-2);
    font-family: var(--font-mono);
  }
  .party h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .table-wrap {
    overflow-x: auto;
    margin-bottom: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-sm), var(--inset-highlight);
  }
  .features {
    margin: 0;
  }
  .features thead th {
    background: var(--bg-sunken);
    border-bottom: 1px solid var(--line);
    padding-block: var(--space-2);
  }
  .features th,
  .features td {
    padding-inline: var(--space-4);
    border-bottom-color: var(--line-soft);
  }
  .features tbody tr:last-child > * {
    border-bottom: 0;
  }
  .features tbody tr:hover > * {
    background: color-mix(in oklch, var(--accent-soft) 40%, transparent);
  }
  .features th[scope="row"] {
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
    min-width: 18rem;
  }
  .features th[scope="row"] > a {
    color: var(--ink);
    text-decoration: none;
  }
  .features th[scope="row"] > a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .meta {
    display: block;
    font-weight: 400;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin-top: var(--space-1);
    line-height: 1.5;
  }
  .meta code {
    font-size: 0.85em;
  }
  .features td:nth-child(4) {
    min-width: 9rem;
  }
  .evidence {
    min-width: 16rem;
    max-width: 24rem;
    overflow-wrap: anywhere;
  }
  .history {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
  }
  .history summary {
    cursor: pointer;
    color: var(--accent);
  }
  .history ol {
    padding-left: 1.2em;
    margin: var(--space-2) 0 0;
  }
  @media (max-width: 56rem) {
    .profile {
      grid-template-columns: 1fr;
    }
  }
</style>
