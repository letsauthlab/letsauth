---
import Crumbs from "@/components/Crumbs.astro";
import ScanReport from "@/components/ScanReport.astro";
import Base from "@/layouts/Base.astro";
import { getDataset } from "@/lib/data";
import { latestScan, reportFromView, requestLadder, unscannedFeatures } from "@/lib/scanner";
import { SUMMARY_RULE } from "@/scanner/summary";
import type { Server } from "@/schema";

export function getStaticPaths() {
  return getDataset().servers.map((server) => ({ params: { id: server.id }, props: { server } }));
}

const { server } = Astro.props as { server: Server };
const data = getDataset();
const view = latestScan(data, server);
const report = reportFromView(view, "1970-01-01T00:00:00Z");
const ladder = requestLadder(view);
const unscanned = unscannedFeatures(data);
const repo = "https://github.com/letsauthlab/letsauth";
---

<Base
  title={`${server.name} · Scanner`}
  description={`Passive scan report for ${server.name} against MCP Authorization ${view.revisionId}: ${view.scanned ? `${view.summary.label}, newest observation ${view.scannedAt?.slice(0, 10)}` : "not scanned yet"}.`}
  path={`/mcp/servers/${server.id}/scan/`}
  noindex={Boolean(server.withdrawn)}
>
  <div class="wrap">
    <Crumbs
      trail={[
        { href: "/mcp/", label: "Servers" },
        { href: `/mcp/servers/${server.id}/`, label: server.name },
      ]}
      current="Scan report"
    />
    <header class="page-head">
      <p class="eyebrow">Scan report</p>
      <h1>{server.name}</h1>
      <p class="lede">
        <code>{server.url}</code> against MCP Authorization {view.revisionId}
        {view.scannedAt && (
          <span data-nightly>
            {" "}· newest scanner observation <time datetime={view.scannedAt}>{view.scannedAt.slice(0, 10)}</time>
          </span>
        )}
      </p>
      <p class="page-head__meta">
        <a class="button small quiet" href={`/mcp/servers/${server.id}/`}>Atlas page</a>
        {!server.withdrawn && <a class="button small quiet" href={`/mcp/servers/${server.id}/scan.json`}>JSON</a>}
        <a class="button small quiet" href={`${repo}/blob/main/data/observations/${server.id}.yaml`} rel="noopener">Data file</a>
      </p>
    </header>

    {
      server.withdrawn ? (
        <section class="notice" aria-labelledby="withdrawn">
          <h2 id="withdrawn">Withdrawn from the atlas</h2>
          <p>
            This server was withdrawn on <time datetime={server.withdrawn.at}>{server.withdrawn.at}</time>{" "}
            and is not scanned. Reason given: {server.withdrawn.reason}.
          </p>
        </section>
      ) : (
        <>
          <ScanReport report={report} ladder={ladder} scannedAt={view.scannedAt} />

          <div class="after">
            <section class="panel" aria-labelledby="rule-title">
              <h2 id="rule-title">How the summary is counted</h2>
              <ol class="rule">{SUMMARY_RULE.map((line) => <li>{line}</li>)}</ol>
              <p class="muted">
                Counted from the statuses above at build time; never used to sort or rank
                servers. <a href="/mcp/scanner/#summary-rule">About the scanner</a>.
              </p>
            </section>
            <section aria-labelledby="not-title">
              <h2 id="not-title">Not checked by the scanner</h2>
              <p class="muted">
                These requirements need a token, a scope or a reading of the implementation. Their cells on the <a href={`/mcp/servers/${server.id}/`}>atlas page</a>{" "}
                come from documentation and manual checks.
              </p>
              <ul class="rows unscanned">
                {unscanned.map((f) => (
                  <li class="rows__head">
                    <a href={`/mcp/features/${f.id}/`}>{f.name}</a>
                    <span class="chip">{f.observable}</span>
                  </li>
                ))}
              </ul>
            </section>
          </div>
          <footer class="page-foot">
            <p class="self">
              Reproduce this report: <code>pnpm scan {server.id}</code> in the{" "}
              <a href={repo} rel="noopener">repository</a>. Corrections are new observations, never
              edits; see <a href={`${repo}/blob/main/docs/scanner.md`} rel="noopener">docs/scanner.md</a>.
            </p>
          </footer>
        </>
      )
    }
  </div>
</Base>

<style>
  .page-head .lede {
    font-size: var(--text-md);
  }
  .page-head code {
    overflow-wrap: anywhere;
  }
  .after {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5) var(--space-6);
    align-items: start;
    margin: var(--space-7) 0 var(--space-5);
  }
  .after h2 {
    font-size: var(--h3);
    margin: 0 0 var(--space-3);
  }
  .rule {
    padding-left: 1.3em;
    font-size: var(--small);
    margin-bottom: var(--space-3);
  }
  .rule li {
    margin-bottom: var(--space-1);
  }
  .rule li::marker {
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  .muted {
    font-size: var(--small);
    color: var(--ink-2);
  }
  .unscanned {
    font-size: var(--small);
  }
  .unscanned > li {
    margin: 0;
    padding: var(--space-2) 0;
  }
  .self {
    margin: 0;
    max-width: none;
  }
</style>
