---
import Citation from "@/components/Citation.astro";
import Crumbs from "@/components/Crumbs.astro";
import StatusCell from "@/components/StatusCell.astro";
import Base from "@/layouts/Base.astro";
import {
  currentCell,
  currentRevision,
  featureInRevision,
  featureShare,
  matrixRows,
  revisionsNewestFirst,
} from "@/lib/atlas";
import { getDataset } from "@/lib/data";
import { CATEGORY_LABEL, PARTY_LABEL, STATUS_ORDER } from "@/lib/labels";
import type { Feature, ObservationStatus, Server } from "@/schema";

export function getStaticPaths() {
  return getDataset().features.map((feature) => ({
    params: { id: feature.id },
    props: { feature },
  }));
}

const { feature } = Astro.props as { feature: Feature };
const data = getDataset();
const revision = currentRevision(data);
const revisions = revisionsNewestFirst(data);
const entry = featureInRevision(feature, revision.id);
const inMatrix = feature.party !== "client" && Boolean(entry);
const share = inMatrix ? featureShare(data, feature.id, revision.id) : undefined;
const byStatus = new Map<ObservationStatus, Server[]>(STATUS_ORDER.map((s) => [s, []]));
if (inMatrix) {
  for (const server of matrixRows(data)) {
    byStatus.get(currentCell(data, server, feature, revision.id).status)?.push(server);
  }
}
const known = share ? share.supported + share.partial + share.unsupported : 0;
const pct = (n: number) => (known === 0 ? 0 : Math.round((n / known) * 1000) / 10);
const OBSERVABLE_LABEL = {
  passive: "Observable by reading published metadata, without any request to the server.",
  active:
    "Only observable by sending requests to the server; recorded by hand or by a future active scanner, never by this site.",
  manual: "Requires reading documentation or source; recorded by people.",
};
const supersededBy = data.features.find((f) => f.supersedes === feature.id);
---

<Base
  title={feature.name}
  description={`${feature.name} in the MCP Authorization specification: what it requires, which revision defines it, and which public MCP servers support it.`}
  path={`/mcp/features/${feature.id}/`}
>
  <div class="wrap">
    <Crumbs trail={[{ href: "/mcp/", label: "MCP auth atlas" }]} current={feature.name} />
    <header class="page-head">
      <p class="eyebrow">{PARTY_LABEL[feature.party]} · {CATEGORY_LABEL[feature.category]}</p>
      <h1>{feature.name}</h1>
      <p class="lede">{feature.description}</p>
      <p class="page-head__meta">
        <code>{feature.id}</code>
        {feature.supersedes && (
          <>
            {" · supersedes "}
            <a href={`/mcp/features/${feature.supersedes}/`}>{feature.supersedes}</a>
          </>
        )}
        {supersededBy && (
          <>
            {" · superseded by "}
            <a href={`/mcp/features/${supersededBy.id}/`}>{supersededBy.id}</a>
          </>
        )}
      </p>
    </header>

    <div class="grid">
      <section class="card" aria-labelledby="definition">
        <h2 id="definition">In revision {revision.id}</h2>
        {
          entry ? (
            <dl class="kv">
              <dt>Level</dt>
              <dd>
                <span class:list={["level", `level-${entry.level}`]}>{entry.level}</span>
                {entry.levelNote && <span class="note"> {entry.levelNote}</span>}
              </dd>
              <dt>Defined in</dt>
              <dd>
                <Citation entry={entry} withRevision />
              </dd>
              <dt>Party</dt>
              <dd>{PARTY_LABEL[feature.party]}</dd>
              <dt>Observable</dt>
              <dd>
                <code>{feature.observable}</code> <span class="note">{OBSERVABLE_LABEL[feature.observable]}</span>
              </dd>
            </dl>
          ) : (
            <p>This feature is not defined in revision {revision.id}.</p>
          )
        }
        {
          feature.party === "client" && (
            <p class="note">
              Client-side requirement: not shown in the server matrix. It is recorded so later
              tools can cite it.
            </p>
          )
        }
      </section>

      <section class="card" aria-labelledby="levels">
        <h2 id="levels">Level by revision</h2>
        <table class="levels">
          <thead>
            <tr>
              <th scope="col">Revision</th>
              <th scope="col">Level</th>
              <th scope="col">Section</th>
            </tr>
          </thead>
          <tbody>
            {
              revisions.map((r) => {
                const e = featureInRevision(feature, r.id);
                return (
                  <tr>
                    <th scope="row">
                      <a href={r.id === revision.id ? "/mcp/" : `/mcp/${r.id}/`}>{r.id}</a>
                      {r.status === "current" && <span class="pill">current</span>}
                    </th>
                    <td>
                      {e ? (
                        <>
                          <span class:list={["level", `level-${e.level}`]}>{e.level}</span>
                          {e.levelNote && <span class="note"> {e.levelNote}</span>}
                        </>
                      ) : (
                        <span class="note">not defined</span>
                      )}
                    </td>
                    <td>{e && <Citation entry={e} />}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </section>
    </div>

    {
      share && (
        <section class="adoption" aria-labelledby="adoption">
          <p class="eyebrow">Adoption</p>
          <h2 id="adoption">Across the listed servers</h2>
          <p class="share-line">
            {share.share === null ? (
              <>
                <strong>No server has been observed yet</strong> for this feature. The share is
                not computed from unknowns.
              </>
            ) : (
              <>
                <strong>{Math.round(share.share * 100)}%</strong> of the {known} server
                {known === 1 ? "" : "s"} with a recorded observation support it
                {share.partial > 0 ? ` (${share.partial} partially)` : ""}.
              </>
            )}{" "}
            <span class="note">
              {share.unknown} unknown and {share.notApplicable} not applicable are left out of the
              denominator.
            </span>
          </p>
          <div class="bar" role="img" aria-label={`Supported ${share.supported}, partial ${share.partial}, unsupported ${share.unsupported}, unknown ${share.unknown}, not applicable ${share.notApplicable}`}>
            <span class="seg supported" style={`flex-basis:${pct(share.supported)}%`} />
            <span class="seg partial" style={`flex-basis:${pct(share.partial)}%`} />
            <span class="seg unsupported" style={`flex-basis:${pct(share.unsupported)}%`} />
            {known === 0 && <span class="seg empty" style="flex-basis:100%" />}
          </div>
          <div class="status-lists">
            {STATUS_ORDER.map((s) => {
              const servers = byStatus.get(s) ?? [];
              if (servers.length === 0) return null;
              return (
                <section aria-labelledby={`list-${s}`}>
                  <h3 id={`list-${s}`}>
                    <StatusCell status={s} variant="label" /> <span class="n num">{servers.length}</span>
                  </h3>
                  <ul>
                    {servers.map((server) => (
                      <li>
                        <a href={`/mcp/servers/${server.id}/`}>{server.name}</a>
                      </li>
                    ))}
                  </ul>
                </section>
              );
            })}
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .card h2 {
    font-size: var(--text-md);
    margin-bottom: var(--space-4);
  }
  .note {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .levels {
    margin: 0;
  }
  .levels th[scope="row"] {
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
  }
  .levels tbody tr:last-child > * {
    border-bottom: 0;
  }
  .levels .pill {
    margin-left: var(--space-2);
  }
  .adoption h2 {
    font-size: var(--text-xl);
  }
  .share-line {
    max-width: none;
  }
  .share-line strong {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    margin-right: var(--space-2);
  }
  .bar {
    display: flex;
    gap: 2px;
    height: 0.75rem;
    border-radius: 999px;
    overflow: hidden;
    background: var(--bg-sunken);
    margin: var(--space-4) 0 var(--space-6);
    max-width: 48rem;
  }
  .seg {
    display: block;
    flex-grow: 0;
    flex-shrink: 0;
  }
  .seg.supported {
    background: var(--status-supported);
  }
  .seg.partial {
    background: var(--status-partial);
  }
  .seg.unsupported {
    background: var(--status-unsupported);
  }
  .seg.empty {
    background: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      var(--status-unknown-soft) 6px 12px
    );
  }
  .status-lists {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-4);
  }
  .status-lists section {
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-sm), var(--inset-highlight);
  }
  .status-lists h3 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line-soft);
  }
  .status-lists ul {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2;
    column-gap: var(--space-4);
    font-size: var(--text-sm);
  }
  .status-lists li {
    break-inside: avoid;
  }
  .status-lists li a {
    display: inline-block;
    padding: 0.2em 0;
    color: var(--ink);
    text-decoration: none;
  }
  .status-lists li a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
