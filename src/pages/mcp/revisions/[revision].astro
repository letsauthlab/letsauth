---
import MatrixPage from "@/components/MatrixPage.astro";
import Base from "@/layouts/Base.astro";
import { currentRevision, getSpec, revisionObserved } from "@/lib/atlas";
import { getDataset } from "@/lib/data";

// a page per revision with observations (the current one redirects home); one without any
// would be a matrix of unknowns, so it gets no page
export function getStaticPaths() {
  const data = getDataset();
  return getSpec(data)
    .revisions.filter((r) => r.status === "current" || revisionObserved(data, r.id))
    .map((r) => ({ params: { revision: r.id } }));
}

const { revision } = Astro.params;
// The current revision lives at the atlas root; its revision URL is a redirect page there.
if (currentRevision(getDataset()).id === revision) return Astro.redirect("/", 301);
---

<Base
  title={`MCP auth atlas, revision ${revision}`}
  description={`Which public MCP servers support which features of the MCP Authorization specification as of revision ${revision}.`}
  path={`/mcp/revisions/${revision}/`}
>
  <MatrixPage
    revisionId={revision}
    crumbs={{ trail: [{ href: "/", label: "Matrix" }], current: `Revision ${revision}` }}
  />
</Base>
