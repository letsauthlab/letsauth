---
import Crumbs from "@/components/Crumbs.astro";
import Base from "@/layouts/Base.astro";
import { currentRevision } from "@/lib/atlas";
import { getDataset } from "@/lib/data";
import { passiveChecks, scannerFacts, scannerIndex, unscannedFeatures } from "@/lib/scanner";
import { MAX_REQUESTS } from "@/scanner/discovery";
import { GRADE_RULE } from "@/scanner/grade";
import { wellKnownAsUrls, wellKnownPrmUrls } from "@/scanner/urls";
import { USER_AGENT } from "@/scanner/version";

const data = getDataset();
const revision = currentRevision(data);
const views = scannerIndex(data);
const checks = passiveChecks(data);
const unscanned = unscannedFeatures(data);
const facts = scannerFacts(views);
const repo = "https://github.com/letsauthlab/letsauth";
const issue = `${repo}/issues/new?template=observation.yml`;

// One scan of an example server, built from the same URL rules the scanner uses.
const example = {
  server: "https://mcp.example.com/mcp",
  issuer: "https://auth.example.com/tenant",
};
const [prmPath, prmRoot] = wellKnownPrmUrls(example.server);
const ladder = [
  { method: "GET", url: prmPath, note: "protected resource metadata (RFC 9728), path-aware" },
  { method: "GET", url: prmRoot, note: "if nothing there: the same at the root" },
  {
    method: "GET",
    url: example.server,
    note: "no credentials, the Accept header an MCP client sends; only the status and the WWW-Authenticate header are read, never the body",
  },
  {
    method: "POST",
    url: example.server,
    note: "if the GET was routed elsewhere (405, a redirect): an empty body with the JSON content type, no JSON-RPC message",
  },
  {
    method: "GET",
    url: "<resource_metadata>",
    note: "if the well-known locations had nothing and the challenge names a metadata URL",
  },
  ...wellKnownAsUrls(example.issuer).map((url, i) => ({
    method: "GET",
    url,
    note:
      i === 0
        ? "authorization server metadata for the first issuer the metadata names (RFC 8414)"
        : `if not found yet: OpenID Connect Discovery, ${i === 1 ? "path-inserted" : "path-appended"}`,
  })),
];
---

<Base
  title="Scanner"
  description={`The passive scanner behind the MCP auth atlas: what it reads, how it grades, and where its reports for the ${facts.servers} listed servers show against MCP Authorization ${revision.id}.`}
  path="/mcp/scanner/"
>
  <div class="wrap">
    <Crumbs trail={[{ href: "/mcp/", label: "Servers" }]} current="Scanner" />
    <header class="page-head">
      <p class="eyebrow">Scanner</p>
      <h1>The nightly scanner</h1>
      <p class="lede">
        Every night the scanner reads the public authorization metadata of each listed MCP server
        and judges the {checks.length} requirements of MCP Authorization {revision.id} that this
        metadata can answer. It sends no token and no credentials, and starts no authorization
        flow. Its results reach the atlas as observations, by pull request.
      </p>
      <dl class="facts" aria-label="Scanner at a glance">
        <div>
          <dt>Servers listed</dt>
          <dd class="num">{facts.servers}</dd>
        </div>
        <div>
          <dt>Scanned</dt>
          <dd class="num" data-nightly>{facts.scanned}</dd>
        </div>
        <div>
          <dt>Checks per server</dt>
          <dd class="num">{checks.length}</dd>
        </div>
        <div>
          <dt>Newest scan</dt>
          <dd class:list={["num", { muted: !facts.newest }]} data-nightly>
            {facts.newest ? <time datetime={facts.newest}>{facts.newest.slice(0, 10)}</time> : "none yet"}
          </dd>
        </div>
      </dl>
    </header>

    <section class="how" aria-labelledby="how-title">
      <h2 id="how-title">What it reads</h2>
      <p class="how__lede">
        One scan of a server listed at <code>{example.server}</code>, request by request. A line
        marked "if" is sent only when the answers before it leave the question open.
      </p>
      <div class="explainer ladder">
        <ol class="transcript" aria-label="The requests of one scan, in order">
          {ladder.map((line) => (
            <li>
              <span class="transcript__method">{line.method}</span>
              <span class="transcript__url">{line.url}</span>
              <span class="transcript__note">{line.note}</span>
            </li>
          ))}
        </ol>
      </div>
      <p class="how__after">
        At most {MAX_REQUESTS} requests over HTTPS, no credentials, no body sent, redirects
        followed only on the same host. It identifies itself as <code>{USER_AGENT}</code>. The
        challenge is the only thing read from the endpoint, and it is what every anonymous client
        receives; that is why it still counts as a passive scan (<a
          href={`${repo}/blob/main/specs/008-discovery-challenge/spec.md`}
          rel="noopener">why</a>, and <a
          href={`${repo}/blob/main/specs/010-discovery-strategies/spec.md`}
          rel="noopener">why the empty POST is too</a>).
      </p>
      <div class="how__grid">
        <section class="panel" aria-labelledby="status-title">
          <h3 id="status-title">What a status means</h3>
          <p>
            <strong>Supported</strong> and <strong>unsupported</strong> are written only when a
            document was fetched and the deciding field is present or absent.{" "}
            <strong>Unknown</strong> means the scanner could not tell: the document could not be
            fetched, no authorization server was named, or nothing was advertised to judge. A
            fetch failure is never written as a failure of the server.
          </p>
          <p>
            A requirement a server can announce in more than one place is read from each in turn,
            the server's own metadata first, then its challenge, then its authorization server,
            and the evidence names the one that decided.
          </p>
          <p>
            Every observation starts with the URL that decided it and names the field and
            value, so a reviewer can open it.
          </p>
        </section>
        <section class="panel" id="grade-rule" aria-labelledby="grade-title">
          <h3 id="grade-title">How the grade is derived</h3>
          <ol class="rule">
            {GRADE_RULE.map((line) => <li>{line}</li>)}
          </ol>
          <p>
            The grade is a property of one report at one time, derived from the statuses shown.
            The atlas never sorts or ranks servers by it.
          </p>
        </section>
      </div>
    </section>

    <section class="where" aria-labelledby="where-title">
      <h2 id="where-title">Where the results show</h2>
      <p>
        The scanner has no list of its own. Its results live in the{" "}
        <a href="/mcp/">MCP auth atlas</a>: the letter next to each server name in the matrix is
        that server's latest grade, and every <a href="/mcp/">server page</a> carries the
        same grade with a link to the full report at <code>/mcp/servers/&lt;server&gt;/scan/</code>, which lists
        each of the {checks.length} checks with the metadata it read. A server without a scanner
        observation reads "not scanned": the nightly run has not yet been able to read its metadata, or
        has not run since it was listed. Servers whose <a href="/mcp/#f-auth">auth class</a> is API
        key or no authentication read "no OAuth" and are not scanned; a server whose class is not yet
        stated is scanned, and the run summary says what its endpoint's answer suggests.
      </p>
    </section>

    <div class="split">
      <section class="prose" aria-labelledby="self-title">
        <h2 id="self-title">Run it yourself</h2>
        <p>
          The site never scans on request. In a clone of the repository, the command the nightly
          job runs works from your terminal too:
        </p>
        <pre tabindex="0"><code>pnpm scan https://mcp.example.com/mcp   # any server, nothing written
pnpm scan notion                        # a listed server by id
pnpm scan notion --write                # append what the nightly rule would</code></pre>
        <p>
          <code>--write</code> appends observations to <code>data/observations/&lt;id&gt;.yaml</code>
          following the same append rule as the nightly run; open a pull request with the result.
          See <a href={`${repo}/blob/main/docs/scanner.md`} rel="noopener">docs/scanner.md</a>.
        </p>
      </section>
      <section class="prose" aria-labelledby="not-title">
        <h2 id="not-title">What it does not check</h2>
        <p>
          {unscanned.length} server-side requirements need a token, a scope or a reading of the
          implementation and stay out of a passive scan: for example{" "}
          {unscanned.slice(0, 3).map((f, i) => (
            <>
              {i > 0 && ", "}
              <a href={`/mcp/features/${f.id}/`}>{f.name}</a>
            </>
          ))}. Their cells come from documentation and manual checks until active probes exist for
          verified owners.
        </p>
        <h3 id="opt-out">Opting out</h3>
        <p>
          If you run a listed server and do not want it scanned,{" "}
          <a href={issue} rel="noopener">withdraw it</a> from the atlas; a withdrawn server is never
          contacted again. The scanner only reads what a server publishes for every client: its
          metadata documents and the challenge it sends to anyone without a token.
        </p>
      </section>
    </div>
  </div>
</Base>

<style>
  .how,
  .where {
    margin-bottom: var(--space-7);
  }
  .how h2,
  .where h2,
  .split h2 {
    font-size: var(--h2);
  }
  .how__lede,
  .how__after,
  .where p {
    max-width: var(--measure);
    color: var(--ink-2);
  }
  .how__after {
    margin-top: var(--space-4);
  }
  .where a {
    color: var(--ink);
  }
  .ladder .transcript {
    margin: 0;
  }
  /* method and address on one line, the note under the address; addresses break, never scroll */
  .ladder .transcript > li {
    display: grid;
    grid-template-columns: 4.5ch minmax(0, 1fr);
    gap: 0 var(--space-3);
    white-space: normal;
    overflow-wrap: anywhere;
    margin-bottom: var(--space-2);
  }
  .ladder .transcript > li:last-child {
    margin-bottom: 0;
  }
  .transcript__url {
    overflow-wrap: anywhere;
  }
  .ladder .transcript__note {
    grid-column: 2;
    font-family: var(--font-body);
  }
  @media (max-width: 40rem) {
    .ladder,
    .ladder .transcript {
      padding: var(--space-3);
    }
  }
  .how__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    align-items: start;
    margin-top: var(--space-6);
  }
  .how__grid h3 {
    font-size: var(--h3);
    margin: 0 0 var(--space-3);
  }
  .how__grid p,
  .how__grid ol {
    font-size: var(--small);
    color: var(--ink-2);
  }
  .how__grid ol {
    padding-left: 1.3em;
  }
  .how__grid li {
    margin-bottom: var(--space-2);
  }
  .how__grid strong {
    color: var(--ink);
  }
  .rule li::marker {
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-6) var(--space-8);
    margin-bottom: var(--space-7);
  }
  .split h2 {
    margin-top: 0;
  }
  .split pre {
    max-width: 100%;
    overflow-x: auto;
  }
</style>
