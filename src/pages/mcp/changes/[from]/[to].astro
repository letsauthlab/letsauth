---
import Citation from "@/components/Citation.astro";
import Crumbs from "@/components/Crumbs.astro";
import Base from "@/layouts/Base.astro";
import { currentRevision, featureInRevision, revisionDiff, revisionPairs } from "@/lib/atlas";
import { getDataset } from "@/lib/data";
import { PARTY_LABEL } from "@/lib/labels";
import type { Feature } from "@/schema";

export function getStaticPaths() {
  return revisionPairs(getDataset()).map(([older, newer]) => ({
    params: { from: older.id, to: newer.id },
  }));
}

const { from, to } = Astro.params;
const data = getDataset();
const diff = revisionDiff(data, from, to);
const current = currentRevision(data);
const href = (id: string) => (id === current.id ? "/mcp/" : `/mcp/revisions/${id}/`);
const unchanged = data.features.filter(
  (f) =>
    featureInRevision(f, from) &&
    featureInRevision(f, to) &&
    !diff.changed.some((c) => c.feature.id === f.id),
).length;
const FeatureLine = (f: Feature) => ({ name: f.name, id: f.id, party: PARTY_LABEL[f.party] });
---

<Base
  title={`What changed from ${from} to ${to}`}
  description={`Requirements of the MCP Authorization specification whose level changed, or that were added or removed, between revisions ${from} and ${to}.`}
  path={`/mcp/changes/${from}/${to}/`}
>
  <div class="wrap">
    <Crumbs trail={[{ href: "/mcp/", label: "MCP auth atlas" }]} current={`Changes ${from} to ${to}`} />
    <header class="page-head">
      <p class="eyebrow">Revision diff</p>
      <h1>
        What changed from <a href={href(from)}>{from}</a> to <a href={href(to)}>{to}</a>
      </h1>
      <p class="lede">
        {diff.to.changes ?? "Differences in the requirement levels between the two revisions."}
      </p>
      <p class="page-head__meta">
        <a href={diff.from.url} rel="noopener">Read {from}</a> ·
        <a href={diff.to.url} rel="noopener">Read {to}</a> ·
        {unchanged} feature{unchanged === 1 ? "" : "s"} unchanged
      </p>
    </header>

    <div class="cols">
      <section class="card" aria-labelledby="changed">
        <h2 id="changed">Level changed <span class="n">{diff.changed.length}</span></h2>
        {
          diff.changed.length === 0 ? (
            <p class="note">No feature changed level.</p>
          ) : (
            <ul class="list">
              {diff.changed.map(({ feature, from: a, to: b }) => {
                const line = FeatureLine(feature);
                const entry = featureInRevision(feature, to);
                return (
                  <li data-feature={feature.id}>
                    <a href={`/mcp/features/${feature.id}/`}>{line.name}</a>
                    <span class="levels">
                      <span class:list={["level", `level-${a}`]}>{a}</span>
                      <span aria-hidden="true"> → </span>
                      <span class="visually-hidden">to</span>
                      <span class:list={["level", `level-${b}`]}>{b}</span>
                    </span>
                    <span class="meta">
                      <code>{line.id}</code> · {line.party}
                      {entry?.levelNote && <> · {entry.levelNote}</>}
                      {entry && (
                        <>
                          {" · "}
                          <Citation entry={entry} />
                        </>
                      )}
                    </span>
                  </li>
                );
              })}
            </ul>
          )
        }
      </section>

      <section class="card" aria-labelledby="added">
        <h2 id="added">Added in {to} <span class="n">{diff.added.length}</span></h2>
        {
          diff.added.length === 0 ? (
            <p class="note">Nothing was added.</p>
          ) : (
            <ul class="list">
              {diff.added.map((feature) => {
                const line = FeatureLine(feature);
                const entry = featureInRevision(feature, to);
                return (
                  <li data-feature={feature.id}>
                    <a href={`/mcp/features/${feature.id}/`}>{line.name}</a>
                    {entry && <span class:list={["level", `level-${entry.level}`]}>{entry.level}</span>}
                    <span class="meta">
                      <code>{line.id}</code> · {line.party}
                      {entry && (
                        <>
                          {" · "}
                          <Citation entry={entry} />
                        </>
                      )}
                    </span>
                  </li>
                );
              })}
            </ul>
          )
        }
      </section>

      <section class="card" aria-labelledby="removed">
        <h2 id="removed">Removed since {from} <span class="n">{diff.removed.length}</span></h2>
        {
          diff.removed.length === 0 ? (
            <p class="note">Nothing was removed.</p>
          ) : (
            <ul class="list">
              {diff.removed.map((feature) => {
                const line = FeatureLine(feature);
                const entry = featureInRevision(feature, from);
                return (
                  <li data-feature={feature.id}>
                    <a href={`/mcp/features/${feature.id}/`}>{line.name}</a>
                    {entry && <span class:list={["level", `level-${entry.level}`]}>{entry.level}</span>}
                    <span class="meta">
                      <code>{line.id}</code> · {line.party}
                      {entry && (
                        <>
                          {" · "}
                          <Citation entry={entry} />
                        </>
                      )}
                    </span>
                  </li>
                );
              })}
            </ul>
          )
        }
      </section>
    </div>
  </div>
</Base>

<style>
  .page-head h1 a {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.75em;
    letter-spacing: -0.01em;
    text-decoration-thickness: 2px;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-4);
    align-items: start;
  }
  .card h2 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-md);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line-soft);
  }
  .note {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .list li {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line-soft);
  }
  .list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .list li > a {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .list li > a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .levels {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }
  .meta {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: 1.5;
  }
</style>
