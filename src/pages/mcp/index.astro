---
import MatrixPage from "@/components/MatrixPage.astro";
import Base from "@/layouts/Base.astro";
import { currentRevision } from "@/lib/atlas";
import { getDataset } from "@/lib/data";

const data = getDataset();
const revision = currentRevision(data);
---

<Base
  title="MCP auth atlas"
  description={`Which public MCP servers support which features of the MCP Authorization specification, revision ${revision.id}. Every cell cites an observation.`}
  path="/mcp/"
>
  <MatrixPage revisionId={revision.id} />
</Base>
