---
/*
 * The ledger (spec 019): every change of status on record for the current revision, newest
 * first. The matrix is the state today; this page is how it got there. In the head, the matrix
 * in small lights the cells that have changed at least once.
 */
import Ledger from "@/components/Ledger.astro";
import MatrixThumb from "@/components/MatrixThumb.astro";
import Base from "@/layouts/Base.astro";
import { cellKey, currentRevision, matrixFor } from "@/lib/atlas";
import { changesByDay, statusChanges } from "@/lib/changes";
import { getDataset } from "@/lib/data";

const data = getDataset();
const revision = currentRevision(data);
const matrix = matrixFor(data, revision.id);
const changes = statusChanges(data, revision.id).filter((c) =>
  matrix.cells.has(cellKey(c.server, c.feature)),
);
const cells = new Set(changes.map((c) => cellKey(c.server, c.feature)));
const servers = new Set(changes.map((c) => c.server)).size;
const days = changesByDay(changes).length;
---

<Base
  title="Ledger"
  description={`Every change of status on record in the letsauth matrix for MCP Authorization ${revision.id}, newest first, each with its evidence and the earlier observations of the cell.`}
  path="/ledger/"
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Ledger</p>
      <h1>The ledger</h1>
      <p class="lede">
        Every change of status on record, newest first. The matrix shows where each server
        stands today. The ledger shows how it got there, and nothing in it is ever edited or
        removed.
      </p>
      <dl class="facts" aria-label="The ledger at a glance">
        <div>
          <dt>Status changes</dt>
          <dd>{changes.length}</dd>
        </div>
        <div>
          <dt>Cells that changed</dt>
          <dd>{cells.size}</dd>
        </div>
        <div>
          <dt>Servers</dt>
          <dd>{servers}</dd>
        </div>
        <div>
          <dt>Days with a change</dt>
          <dd>{days}</dd>
        </div>
      </dl>
      <a class="page-head__aside" href="/">
        <MatrixThumb revisionId={revision.id} cells={cells} label="the cells that have changed" />
        <span>Lit: the cells that have changed at least once</span>
      </a>
    </header>

    <Ledger changes={changes} />

    <footer class="page-foot prose">
      <p>
        A status change is two observations of one cell, one after the other, whose statuses
        differ. The observations are append-only lists under <code>data/observations/</code>: a
        correction is a newer observation, never an edit. Changes are read against revision{" "}
        {revision.id}; an observation of another revision is not counted here.
      </p>
      <p class="page-foot__links">
        <a class="button small quiet" href="/mcp/data.json">Download the data as JSON</a>
        <a class="button small quiet" href="/contribute/">Add an observation</a>
      </p>
    </footer>
  </div>
</Base>
