---
import Document from "@/layouts/Document.astro";
import { LAB, OPERATOR, REPO } from "@/lib/site";

const products = [
  {
    name: "MCP auth atlas",
    href: "/mcp/",
    status: "Live",
    text: "Public MCP servers against every requirement of the MCP Authorization specification, one cited observation per cell.",
  },
  {
    name: "Agent auth atlas",
    href: "/standards/",
    status: "Live",
    text: "The specifications, drafts and EU acts behind agent authorization as one map of what builds on and competes with what.",
  },
  {
    name: "Scanner",
    href: "/mcp/scanner/",
    status: "Live",
    text: "A nightly job that reads listed servers' public metadata and proposes new observations as pull requests.",
  },
  {
    name: "Delegation chain explorer",
    href: "/explorer/",
    status: "Live",
    text: "Scenarios you play step by step, with the decoded token at each hop. Toggles add the attacks and misconfigurations that break a chain.",
  },
  {
    name: "Breach anatomy",
    href: "/breaches/",
    status: "Live",
    text: "Published vulnerabilities and incidents in agent authorization. Each one names the control that was missing and links to the atlas rows and the explorer replay for it.",
  },
  {
    name: "Agents under EU rules",
    status: "Planned",
    text: "Scenarios and long reads on what eIDAS 2.0 and the EUDI wallet, the AI Act and NIS2 ask of agent delegation.",
  },
];
const principles = [
  {
    name: "Cited",
    text: "Each claim names a specification revision and section. A claim without one does not ship.",
  },
  {
    name: "Neutral",
    text: "We rank and score nothing. Rows are in alphabetical order, and no vendor pays for anything.",
  },
  {
    name: "Unknown means no observation",
    text: "A cell with no observation on record reads <em>unknown</em>. It never reads as a failure.",
  },
  {
    name: "Passive",
    text: "We read public metadata only. A scheduled job does the reading, without credentials. A visitor can never start a scan.",
  },
  {
    name: "Open",
    text: "The code is MIT and the data is CC BY 4.0. The history is in a public repository, where anyone can propose a correction.",
  },
  {
    name: "European",
    text: 'We build in Berlin, and EU companies host and measure the site. <a href="/made-in-europe/">Made in Europe</a> lists every service.',
  },
];
---

<Document
  title="About"
  heading={LAB}
  description={`${LAB} is an independent, vendor-neutral lab for how AI agents are authenticated and authorized. It publishes its work on letsauth.eu.`}
  path="/about/"
  eyebrow="About"
  lede="An independent, vendor-neutral lab for how AI agents are authenticated and authorized. We record what the protocols require and what real servers do, and publish it all as open data."
  updated="2026-10-22"
>
  <h2>Why a lab</h2>
  <p>
    Agents now call APIs, use tools and act for people. The rules for how they get authority and
    pass it on sit where agent protocols (MCP, A2A) meet identity standards (OAuth, OpenID
    Connect, token exchange, workload identity). Both sides change every month.
  </p>
  <p>
    Much of what is written about this rests on claims that nobody can check. {LAB} keeps the
    evidence instead. Each requirement cites a specification revision, and each status cites a
    dated observation. You can download all of the data and check it yourself.
  </p>

  <h2>What we build</h2>
  <ul class="rows" role="list">
    {
      products.map((p) => (
        <li>
          <div class="rows__head">
            <h3 class="rows__title">{p.href ? <a href={p.href}>{p.name}</a> : p.name}</h3>
            <span class:list={["chip", { signal: p.status === "Live" }]}>{p.status}</span>
          </div>
          <p>{p.text}</p>
        </li>
      ))
    }
  </ul>
  <p>
    All of them read from one shared data model. The{" "}
    <a href={`${REPO}/blob/main/docs/roadmap.md`} rel="noopener">roadmap</a> shows what comes
    next.
  </p>

  <h2>How we work</h2>
  <ul class="rows" role="list">
    {
      principles.map((p) => (
        <li>
          <h3 class="rows__title">{p.name}</h3>
          <p set:html={p.text} />
        </li>
      ))
    }
  </ul>

  <h2>Who is behind it</h2>
  <p>
    {LAB} is run by <a href={OPERATOR.site} rel="noopener">{OPERATOR.name}</a>, a security
    engineer in Berlin who works on usable security and web authentication. The lab is a
    personal, independent project. The <a href="/disclaimer/">disclaimer</a> says what that
    means for affiliation.
  </p>

  <h2>Get involved</h2>
  <p>
    If you know how a server behaves, <a href="/contribute/">add an observation</a>. If you
    found a mistake or want a specification on the map, open an issue in the{" "}
    <a href={REPO} rel="noopener">repository</a>. For anything else, write to{" "}
    <a href={`mailto:${OPERATOR.email}`}>{OPERATOR.email}</a>.
  </p>

  <Fragment slot="aside">
    <div class="panel">
      <p class="eyebrow">Contact</p>
      <p class="contact">
        <a href={OPERATOR.site} rel="noopener">{OPERATOR.name}</a><br />
        <a href={`mailto:${OPERATOR.email}`}>{OPERATOR.email}</a><br />
        <a href={REPO} rel="noopener">Source on GitHub</a>
      </p>
    </div>
  </Fragment>
</Document>

<style>
  .contact {
    margin: 0;
    font-size: var(--small);
    line-height: 1.8;
  }
  .contact a {
    color: var(--ink);
    text-decoration: none;
  }
  .contact a:hover {
    color: var(--signal);
  }
</style>
