---
import Plate from "@/components/Plate.astro";
import Base from "@/layouts/Base.astro";
import { getDataset } from "@/lib/data";
import { scenarioList } from "@/lib/explorer";
import { TOGGLE_KIND_LABEL } from "@/lib/labels";
import { SECTION_PLATES, sectionCard } from "@/lib/plate";

const data = getDataset();
const scenarios = scenarioList(data);
const toggleCount = scenarios.reduce((n, s) => n + s.toggles.length, 0);
const stepCount = scenarios.reduce((n, s) => n + s.stepCount, 0);
const citedSpecs = new Set<string>();
for (const { scenario } of scenarios) {
  for (const s of scenario.steps) citedSpecs.add(s.cites.spec);
  for (const t of scenario.toggles) {
    citedSpecs.add(t.cites.spec);
    for (const steps of Object.values(t.replaces))
      for (const s of steps) citedSpecs.add(s.cites.spec);
  }
}
---

<Base
  title="Delegation chain explorer"
  description={`${scenarios.length} scenarios of how authority moves through agent systems: ${stepCount} steps, each with the decoded token and the specification section it follows, and ${toggleCount} attack and misconfiguration toggles.`}
  path="/explorer/"
  image={sectionCard("explorer")}
>
  <div class="wrap">
    <header class="page-head">
      <Plate id="explorer" title={SECTION_PLATES.explorer.title} />
      <p class="eyebrow">Delegation chain explorer</p>
      <h1>Delegation chains</h1>
      <p class="lede">
        Each scenario is a chain of requests between a user, agents, MCP servers and
        authorization servers, written from the specification sections it cites. Every step
        shows the token it carries, decoded, with the claims that changed since the previous hop.
      </p>
      <dl class="facts" aria-label="Explorer at a glance">
        <div>
          <dt>Scenarios</dt>
          <dd class="num">{scenarios.length}</dd>
        </div>
        <div>
          <dt>Steps</dt>
          <dd class="num">{stepCount}</dd>
        </div>
        <div>
          <dt>Toggles</dt>
          <dd class="num">{toggleCount}</dd>
        </div>
        <div>
          <dt>Specifications cited</dt>
          <dd class="num">{citedSpecs.size}</dd>
        </div>
      </dl>
    </header>

    <ul id="scenario-list" class="rows scenarios" role="list">
      {
        scenarios.map(({ scenario, stepCount, toggles, features }) => (
          <li class="scenario" data-scenario={scenario.id}>
            <div class="rows__head">
              <h2 class="rows__title">
                <a href={`/explorer/${scenario.id}/`} style={`view-transition-name: scenario-${scenario.id}`}>
                  {scenario.title}
                </a>
              </h2>
              <span class="rows__meta">
                {stepCount} steps · {features.length} requirements
              </span>
            </div>
            <p class="scenario__summary">{scenario.summary}</p>
            <p class="scenario__actors">
              <span class="scenario__label">Actors</span>
              {scenario.actors.map((a) => a.name).join(", ")}
            </p>
            {toggles.length > 0 && (
              <div class="scenario__toggles">
                <span class="scenario__label">Toggles</span>
                <ul role="list">
                  {toggles.map((t) => (
                    <li>
                      <a class:list={["toggle", `kind-${t.kind}`]} href={`/explorer/${scenario.id}/${t.id}/`} data-toggle={t.id}>
                        <span class="toggle__dot" aria-hidden="true" />
                        {t.name}
                        <span class="visually-hidden">({TOGGLE_KIND_LABEL[t.kind]})</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))
      }
    </ul>
    <p class="key">
      <span><span class="toggle__dot kind-attack" aria-hidden="true"></span> Attack</span>
      <span><span class="toggle__dot kind-misconfiguration" aria-hidden="true"></span> Misconfiguration</span>
    </p>

    <section class="panel about" aria-labelledby="about-title">
      <h2 id="about-title">How to read a chain</h2>
      <p>
        Actors are columns and steps are arrows between them. A step cites the section of the
        revision it follows. A step that carries a token shows it decoded, and a claim is marked
        added or changed when it differs from the token one hop earlier.
      </p>
      <p>
        A toggle replaces or removes steps, and the page marks which. It names the atlas
        requirements the toggle defeats, with how many listed servers meet them. The scenarios
        illustrate the specifications and describe no product. The domains are examples and no
        real token is involved.
      </p>
      <p>
        Each scenario is one YAML file, validated at build time against the shared model and
        open under CC BY 4.0. All of them are also <a href="/explorer/data.json">one JSON
        document</a>. To add or correct one, edit its file in the <a
          href="https://github.com/letsauthlab/letsauth/tree/main/data/scenarios"
          rel="noopener">repository</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .kind-attack {
    --kind: var(--toggle-attack);
  }
  .kind-misconfiguration {
    --kind: var(--toggle-misconfiguration);
  }
  .scenarios {
    margin-bottom: var(--space-3);
  }
  .scenario__summary {
    max-width: var(--measure);
  }
  .scenario__actors {
    font-size: var(--small);
    color: var(--ink);
  }
  .scenario__label {
    margin-right: var(--space-3);
    font-size: var(--tiny);
    font-weight: 500;
    color: var(--ink-2);
  }
  .scenario__toggles {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) 0;
    margin-top: var(--space-3);
  }
  .scenario__toggles ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    max-width: 100%;
    padding: 0.3em 0.8em;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--small);
    line-height: 1.4;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .toggle:hover {
    border-color: var(--rule-strong);
  }
  .toggle__dot {
    flex: none;
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--kind);
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--tiny);
    color: var(--ink-2);
  }
  .key > span {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .about {
    margin-top: var(--space-7);
  }
  .about h2 {
    font-size: var(--h3);
  }
</style>
