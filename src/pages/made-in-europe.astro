---
import Document from "@/layouts/Document.astro";
import { LAB, REPO } from "@/lib/site";

/** Every service the site depends on, where it sits, and whether that is in the EU. */
const WHERE = { eu: "EU", outside: "Outside the EU" } as const;
const stack: { what: string; who: string; note: string; where: keyof typeof WHERE }[] = [
  {
    what: "Made",
    who: `${LAB}, Berlin, Germany`,
    note: "Written, researched and maintained in the EU.",
    where: "eu",
  },
  {
    what: "Domain",
    who: "EURid, Brussels, Belgium",
    note: "letsauth.eu sits under the .eu top-level domain, which only EU residents and organisations can hold.",
    where: "eu",
  },
  {
    what: "Hosting and delivery",
    who: "Bunny.net (BunnyWay d.o.o.), Ljubljana, Slovenia",
    note: "The pre-rendered site is stored in an EU storage zone and delivered through Bunny's CDN.",
    where: "eu",
  },
  {
    what: "Analytics",
    who: "Plausible Analytics (Plausible Insights OÜ), Tartu, Estonia",
    note: "Cookieless, aggregate page counts, stored in the EU. See the privacy note.",
    where: "eu",
  },
  {
    what: "Fonts",
    who: "Served from letsauth.eu itself",
    note: "Geist and Geist Mono are open-source fonts bundled with the site; no font service is contacted.",
    where: "eu",
  },
  {
    what: "Scanner",
    who: "Scaleway (Scaleway SAS), Paris, France",
    note: "The nightly scan of public metadata runs as a scheduled job in a Scaleway EU region.",
    where: "eu",
  },
  {
    what: "Source code, issues and CI",
    who: "GitHub (GitHub, Inc.), San Francisco, USA",
    note: "The public repository, contributions and automated checks live on GitHub. The published site loads nothing from it.",
    where: "outside",
  },
];
---

<Document
  title="Made in Europe"
  description="letsauth.eu is made in Berlin and hosted, delivered and measured by EU companies. Every service it depends on, where it sits, and the one exception."
  path="/made-in-europe/"
  eyebrow="Made in Europe"
  heading="Made in Europe, hosted in the EU"
  lede="letsauth is built in Berlin and runs on European infrastructure: EU hosting, EU analytics, an .eu domain. Here is every service the site depends on, including the one that is not European."
  updated="2026-10-14"
>
  <h2>Why it matters here</h2>
  <p>
    This lab studies who gets to act on whose behalf. Where your data goes, and under which law,
    is part of the same question. European rules (the GDPR, eIDAS 2.0 and the EUDI wallet, the
    AI Act, NIS2) shape how agents may be delegated authority, so the site that writes about them
    keeps to them too: no cookies that need consent, visitor data handled only by EU companies,
    and no third-party scripts beyond EU analytics.
  </p>

  <h2>What the site runs on</h2>
  <ul class="stack" role="list">
    {
      stack.map((s) => (
        <li class="stack__row">
          <div class="stack__what">
            <span class="stack__label">{s.what}</span>
            <span class:list={["pill", { accent: s.where === "eu" }]}>{WHERE[s.where]}</span>
          </div>
          <div class="stack__detail">
            <strong>{s.who}</strong>
            <span>{s.note}</span>
          </div>
        </li>
      ))
    }
  </ul>

  <h2>The exception</h2>
  <p>
    The code, the data and the automated checks live on GitHub, a US company, because that is where open-source
    contributors already are and where a pull request can be reviewed in public. Visitors to
    letsauth.eu never touch it: no script, font or image on the site is loaded from GitHub. If
    you contribute, GitHub's terms apply to what you do there; the{" "}
    <a href="/privacy/">privacy note</a> has the details. The whole history is in git, so the
    project can move to a European forge without losing anything.
  </p>

  <h2>Check it yourself</h2>
  <p>
    Open your browser's network panel on any page: every request goes to letsauth.eu, plus
    plausible.io when analytics are on. The deployment and hosting setup is documented in the{" "}
    <a href={`${REPO}/blob/main/docs/deploy.md`} rel="noopener">repository</a>.
  </p>
</Document>

<style>
  .stack {
    padding: 0;
    margin: 0 0 var(--space-4);
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-sm), var(--inset-highlight);
    overflow: hidden;
  }
  .stack__row {
    display: grid;
    grid-template-columns: minmax(10rem, 13rem) minmax(0, 1fr);
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: var(--space-4);
    border-bottom: 1px solid var(--line-soft);
  }
  .stack__row:last-child {
    border-bottom: 0;
  }
  .stack__what {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .stack__label {
    font-size: var(--text-2xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--ink-muted);
  }
  .stack__detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }
  .stack__detail span {
    color: var(--ink-muted);
  }
  @media (max-width: 40rem) {
    .stack__row {
      grid-template-columns: 1fr;
    }
    .stack__what {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
