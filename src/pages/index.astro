---
/*
 * The home page is the matrix (spec 019): the state of the record today, and under it the
 * ledger since the last run. There is no second matrix page; /mcp/ forwards here. No script of
 * its own: the matrix island is the same one the revision pages use.
 */
import Ledger from "@/components/Ledger.astro";
import MatrixPage from "@/components/MatrixPage.astro";
import Base from "@/layouts/Base.astro";
import { cellKey, currentRevision, matrixFor } from "@/lib/atlas";
import { changedSince, dayOf, scanRunsAfter, statusChanges } from "@/lib/changes";
import { getDataset } from "@/lib/data";

const data = getDataset();
const revision = currentRevision(data);
const matrix = matrixFor(data, revision.id);
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

// what changed: only cells the current matrix shows
const changes = statusChanges(data, revision.id).filter((c) =>
  matrix.cells.has(cellKey(c.server, c.feature)),
);
const newest = changes[0]?.observation.observedAt;
const newestDay = newest ? dayOf(newest) : undefined;
const runsSince = newest ? scanRunsAfter(data, newest) : [];
// the dots in the matrix: the cells of the newest day with a change
const changed = newestDay ? changedSince(changes, newestDay) : new Set<string>();
---

<Base
  title="letsauth"
  description={`letsauth is an independent lab for agent authorization. See how public MCP servers handle authorization for AI agents, checked against the MCP Authorization specification (revision ${revision.id}), with the results as open data.`}
  path="/"
>
  <MatrixPage revisionId={revision.id} home changed={changed}>
    {
      newestDay && (
        <p class="page-head__meta home-latest" slot="aside">
          <span>
            Latest change <time datetime={newestDay}>{newestDay}</time>:{" "}
            {plural(changed.size, "cell")}, dotted below
          </span>
          <a href="#since">The ledger since the last run</a>
        </p>
      )
    }
    <section slot="after" aria-labelledby="since">
      <div class="section-head">
        <h2 id="since">The ledger, since the last run</h2>
        <span>{plural(changes.length, "status change")} on record</span>
      </div>
      {
        runsSince.length > 0 && (
          <p class="home-quiet">
            <time datetime={runsSince.at(-1)}>{dayOf(runsSince.at(-1) ?? "")}</time>
            <span>
              {runsSince.length === 1
                ? "One scan run since the last change. No status changed."
                : `${runsSince.length} scan runs since the last change. No status changed.`}
            </span>
          </p>
        )
      }
      <Ledger changes={changes} limit={6} />
      <p class="section-more">
        <a href="/ledger/">Open the ledger: all {plural(changes.length, "status change")}</a>
      </p>
    </section>
  </MatrixPage>
</Base>

<style>
  .home-latest time {
    font-family: var(--font-mono);
  }
  /* a run without a change is still a line of the ledger */
  .home-quiet {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    column-gap: var(--space-5);
    margin: 0;
    padding-block: var(--space-4);
    max-width: none;
    border-top: 1px solid var(--rule-strong);
    color: var(--ink-2);
  }
  .home-quiet time {
    font-family: var(--font-mono);
    font-size: var(--tiny);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 56rem) {
    .home-quiet {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
