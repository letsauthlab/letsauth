---
import Citation from "@/components/Citation.astro";
import Crumbs from "@/components/Crumbs.astro";
import Base from "@/layouts/Base.astro";
import { missingControls, replayOf } from "@/lib/breaches";
import { getDataset } from "@/lib/data";
import { PARTY_LABEL, TOGGLE_KIND_LABEL, VULNERABILITY_CLASS_LABEL } from "@/lib/labels";
import { REPO } from "@/lib/site";
import type { Vulnerability } from "@/schema";

export function getStaticPaths() {
  return getDataset().vulnerabilities.map((vulnerability) => ({
    params: { id: vulnerability.id },
    props: { vulnerability },
  }));
}

const { vulnerability: v } = Astro.props as { vulnerability: Vulnerability };
const data = getDataset();
const replay = replayOf(data, v);
const controls = missingControls(data, v);
const featureById = new Map(data.features.map((f) => [f.id, f]));
const date = new Date(`${v.disclosed}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

<Base title={v.title} description={v.summary.trim()} path={`/breaches/${v.id}/`}>
  <div class="wrap">
    <Crumbs trail={[{ href: "/breaches/", label: "Breach anatomy" }]} current={v.id} />
    <header class="page-head">
      <p class="eyebrow">Breach anatomy</p>
      <h1>{v.title}</h1>
      <p class="lede">{v.summary}</p>
    </header>

    <div class="overview">
      <section class="panel" aria-label="Facts">
        <dl class="kv">
          <dt>Class</dt>
          <dd><span class="chip signal" data-class={v.class}>{VULNERABILITY_CLASS_LABEL[v.class]}</span></dd>
          <dt>Affects</dt>
          <dd>
            <ul class="plain" role="list">
              {v.affects.map((a) => <li>{a}</li>)}
            </ul>
          </dd>
          <dt>Sources</dt>
          <dd>
            <ul class="plain" role="list">
              {
                v.sources.map((s) => (
                  <li>
                    <a href={s} rel="noopener">{s}</a>
                    <span class="host"> {host(s)}</span>
                  </li>
                ))
              }
            </ul>
          </dd>
        </dl>
      </section>

      <section id="timeline" class="events" aria-labelledby="timeline-title">
        <h2 id="timeline-title">Timeline</h2>
        <ol class="timeline" role="list">
          <li>
            <time datetime={v.disclosed}>{date}</time>
            <p>Disclosed in the advisory from {host(v.sources[0] ?? "https://example.org")}.</p>
          </li>
          {
            v.fixed && (
              <li>
                <span class="timeline__label">After disclosure</span>
                <p>Fixed: {v.fixed}.</p>
              </li>
            )
          }
        </ol>
      </section>
    </div>

    <section id="controls" class="controls" aria-labelledby="controls-title">
      <h2 id="controls-title">The control that was missing</h2>
      {
        controls.length > 0 ? (
          <ul role="list" class="rows controls__list">
            {controls.map((c) => {
              const current = c.feature.revisions.at(-1);
              return (
                <li data-feature={c.feature.id}>
                  <div class="rows__head">
                    <p class="controls__name">
                      <a href={`/mcp/features/${c.feature.id}/`}>{c.feature.name}</a>
                      <span class="party">{PARTY_LABEL[c.feature.party]}</span>
                    </p>
                    {current && <span class:list={["level", `level-${current.level}`]}>{current.level}</span>}
                  </div>
                  <p class="controls__text">{c.feature.description}</p>
                  {current && (
                    <p class="controls__cite">
                      <Citation entry={{ spec: current.spec, revision: current.revision, section: current.section }} withRevision />
                    </p>
                  )}
                  <p class="controls__counts" data-observed={c.observed ? "true" : "false"}>
                    {c.observed
                      ? `Listed servers under MCP Authorization ${c.revisionId}: ${c.counts.supported} supported, ${c.counts.partial} partial, ${c.counts.unsupported} unsupported, ${c.counts.unknown} unknown${c.counts.notApplicable > 0 ? `, ${c.counts.notApplicable} not applicable` : ""}.`
                      : `${c.reason[0]?.toUpperCase()}${c.reason.slice(1)}.`}
                  </p>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="controls__none" data-no-controls>
            No requirement in the MCP auth atlas stands for this control yet. The summary above
            says what it is. A requirement joins the atlas when a specification revision states
            it.
          </p>
        )
      }
    </section>

    <section id="replay" class="replay" aria-labelledby="replay-title">
      <h2 id="replay-title">Replay in the explorer</h2>
      {
        replay ? (
          <div class:list={["panel", `kind-${replay.toggle.kind}`]}>
            <p class="replay__kind">{TOGGLE_KIND_LABEL[replay.toggle.kind]}</p>
            <p class="replay__head">
              <a href={`/explorer/${replay.scenario.id}/${replay.toggle.id}/`} data-replay={replay.toggle.id}>
                {replay.scenario.title} · {replay.toggle.name}
              </a>
            </p>
            <p class="replay__summary">{replay.toggle.summary}</p>
            <p class="replay__meta">
              {Object.keys(replay.toggle.replaces).length} step{Object.keys(replay.toggle.replaces).length === 1 ? "" : "s"} of the baseline change ·
              Against <Citation entry={replay.toggle.cites} withRevision />
              {replay.toggle.violates && replay.toggle.violates.length > 0 && (
                <>
                  {" · "}Defeats{" "}
                  {replay.toggle.violates.map((id, i) => (
                    <>
                      {i > 0 && ", "}
                      <a href={`/mcp/features/${id}/`}>{featureById.get(id)?.name ?? id}</a>
                    </>
                  ))}
                </>
              )}
            </p>
          </div>
        ) : (
          <p class="replay__none" data-no-replay>
            No scenario in the explorer replays this pattern yet. The incident is recorded here
            from its public notice. A replay follows when a baseline chain exists for it.
          </p>
        )
      }
    </section>

    <footer class="page-foot">
      <p>
        Written from the public notice linked above. The dates and the fixed version are the
        advisory's. To correct this entry, edit its data file and open a pull request.
      </p>
      <p class="page-foot__links">
        <a href="/breaches/">All entries</a>
        <a href="/breaches/data.json">All entries as JSON</a>
        <a href={`${REPO}/blob/main/data/vulnerabilities/${v.id}.yaml`} rel="noopener">Data file</a>
        <a href={`${REPO}/edit/main/data/vulnerabilities/${v.id}.yaml`} rel="noopener">Propose a change</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  .overview {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-6);
    align-items: start;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .plain a {
    overflow-wrap: anywhere;
  }
  .host {
    font-family: var(--font-mono);
    font-size: var(--tiny);
    color: var(--ink-2);
  }
  .events h2,
  .controls h2,
  .replay h2 {
    font-size: var(--h3);
    margin-bottom: var(--space-3);
  }
  .timeline p {
    margin: var(--space-1) 0 0;
    font-size: var(--small);
  }
  .timeline__label {
    display: block;
    font-size: var(--tiny);
    color: var(--ink-2);
  }

  /* M13: the rail draws in from the top, then the dates fade in behind it; once, on load */
  @media (prefers-reduced-motion: no-preference) {
    .timeline::before {
      transform-origin: top;
      animation: rail-down var(--dur-slow) var(--ease-draw) both;
    }
    .timeline > li {
      animation: fade-in var(--dur) var(--ease) both;
      animation-delay: calc(var(--dur-slow) * 0.6);
    }
    .timeline > li + li {
      animation-delay: var(--dur-slow);
    }
  }
  @keyframes rail-down {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  .controls,
  .replay {
    margin-top: var(--space-7);
  }
  .controls__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    font-weight: 500;
    color: var(--ink);
    font-size: var(--text-body);
    max-width: none;
  }
  .party {
    font-size: var(--tiny);
    color: var(--ink-2);
  }
  .controls__text,
  .replay__summary {
    margin: 0 0 var(--space-2);
    color: var(--ink-2);
  }
  .controls__cite {
    margin: 0 0 var(--space-2);
  }
  .controls__counts,
  .replay__meta {
    margin: 0;
    font-size: var(--small);
    color: var(--ink-2);
    max-width: none;
  }
  .controls__none,
  .replay__none {
    color: var(--ink-2);
  }
  .kind-attack {
    --kind: var(--toggle-attack);
  }
  .kind-misconfiguration {
    --kind: var(--toggle-misconfiguration);
  }
  .replay__kind {
    margin: 0 0 var(--space-1);
    font-size: var(--tiny);
    font-weight: 600;
    color: var(--kind);
  }
  .replay__head {
    margin: 0 0 var(--space-2);
    font-weight: 500;
    max-width: none;
  }
  @media (max-width: 48rem) {
    .overview {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
