---
import Citation from "@/components/Citation.astro";
import Crumbs from "@/components/Crumbs.astro";
import Base from "@/layouts/Base.astro";
import { missingControls, replayOf } from "@/lib/breaches";
import { getDataset } from "@/lib/data";
import { PARTY_LABEL, TOGGLE_KIND_LABEL, VULNERABILITY_CLASS_LABEL } from "@/lib/labels";
import { REPO } from "@/lib/site";
import type { Vulnerability } from "@/schema";

export function getStaticPaths() {
  return getDataset().vulnerabilities.map((vulnerability) => ({
    params: { id: vulnerability.id },
    props: { vulnerability },
  }));
}

const { vulnerability: v } = Astro.props as { vulnerability: Vulnerability };
const data = getDataset();
const replay = replayOf(data, v);
const controls = missingControls(data, v);
const featureById = new Map(data.features.map((f) => [f.id, f]));
const date = new Date(`${v.disclosed}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
// the first sentence leads the page; the rest of the summary is the account under it
const [lede = v.summary, ...account] = v.summary.trim().split(/(?<=\.)\s+(?=[A-Z])/);
// a source as a short label: its host and the start of its path
const label = (url: string) => {
  const path = new URL(url).pathname.replace(/\/$/, "");
  return `${host(url)}${path.length > 28 ? `${path.slice(0, 26)}…` : path}`;
};
---

<Base title={v.title} description={v.summary.trim()} path={`/breaches/${v.id}/`}>
  <div class="wrap">
    <Crumbs trail={[{ href: "/breaches/", label: "Breach anatomy" }]} current={v.id} />
    <header class="page-head">
      <p class="eyebrow">Breach anatomy</p>
      <h1>{v.title}</h1>
      <p class="lede">{lede}</p>
      <p class="page-head__meta">
        <span class="chip signal" data-class={v.class}>{VULNERABILITY_CLASS_LABEL[v.class]}</span>
        <code>{v.id}</code>
      </p>
    </header>

    <div class="anatomy">
      <div class="anatomy__main">
        {
          account.length > 0 && (
            <section id="account" aria-labelledby="account-title">
              <h2 id="account-title">What happened</h2>
              <p>{account.join(" ")}</p>
            </section>
          )
        }

        <section id="controls" aria-labelledby="controls-title">
          <h2 id="controls-title">The control that was missing</h2>
          {
            controls.length > 0 ? (
              <ul role="list" class="rows controls__list">
                {controls.map((c) => {
                  const current = c.feature.revisions.at(-1);
                  return (
                    <li data-feature={c.feature.id}>
                      <p class="controls__name">
                        <a href={`/mcp/features/${c.feature.id}/`}>{c.feature.name}</a>
                        {current && <span class:list={["level", `level-${current.level}`]}>{current.level}</span>}
                        <span class="party">{PARTY_LABEL[c.feature.party]}</span>
                      </p>
                      <p class="controls__text">{c.feature.description}</p>
                      <p class="controls__counts" data-observed={c.observed ? "true" : "false"}>
                        {c.observed
                          ? `Listed servers under MCP Authorization ${c.revisionId}: ${c.counts.supported} supported, ${c.counts.partial} partial, ${c.counts.unsupported} unsupported, ${c.counts.unknown} unknown${c.counts.notApplicable > 0 ? `, ${c.counts.notApplicable} not applicable` : ""}.`
                          : `${c.reason[0]?.toUpperCase()}${c.reason.slice(1)}.`}
                      </p>
                      {current && (
                        <p class="controls__cite">
                          <Citation entry={{ spec: current.spec, revision: current.revision, section: current.section }} withRevision />
                        </p>
                      )}
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p class="none" data-no-controls>
                No requirement in the MCP auth atlas stands for this control yet. A requirement joins
                the atlas when a specification revision states it.
              </p>
            )
          }
        </section>

        <section id="replay" aria-labelledby="replay-title">
          <h2 id="replay-title">Replay in the explorer</h2>
          {
            replay ? (
              <div class:list={["replay", `kind-${replay.toggle.kind}`]}>
                <p class="replay__kind">
                  {TOGGLE_KIND_LABEL[replay.toggle.kind]} in {replay.scenario.title}
                </p>
                <p class="replay__head">
                  <a href={`/explorer/${replay.scenario.id}/${replay.toggle.id}/`} data-replay={replay.toggle.id}>
                    {replay.toggle.name}
                  </a>
                </p>
                <p class="replay__summary">{replay.toggle.summary}</p>
                <p class="replay__meta">
                  {Object.keys(replay.toggle.replaces).length} step{Object.keys(replay.toggle.replaces).length === 1 ? "" : "s"} of the baseline change ·
                  Against <Citation entry={replay.toggle.cites} withRevision />
                  {replay.toggle.violates && replay.toggle.violates.length > 0 && (
                    <>
                      {" · "}Defeats{" "}
                      {replay.toggle.violates.map((id, i) => (
                        <>
                          {i > 0 && ", "}
                          <a href={`/mcp/features/${id}/`}>{featureById.get(id)?.name ?? id}</a>
                        </>
                      ))}
                    </>
                  )}
                </p>
              </div>
            ) : (
              <p class="none" data-no-replay>
                No scenario in the explorer replays this pattern yet. A replay follows when a
                baseline chain exists for it.
              </p>
            )
          }
        </section>
      </div>

      <aside class="anatomy__side panel" aria-label="Facts">
        <section id="timeline" aria-labelledby="timeline-title">
          <h2 id="timeline-title">Timeline</h2>
          <ol class="timeline" role="list">
            <li>
              <time datetime={v.disclosed}>{date}</time>
              <p>Disclosed in the advisory from {host(v.sources[0] ?? "https://example.org")}.</p>
            </li>
            {
              v.fixed && (
                <li>
                  <span class="timeline__label">After disclosure</span>
                  <p>Fixed: {v.fixed}.</p>
                </li>
              )
            }
          </ol>
        </section>
        <section aria-labelledby="affects-title">
          <h2 id="affects-title">Affects</h2>
          <ul class="plain" role="list">
            {v.affects.map((a) => <li>{a}</li>)}
          </ul>
        </section>
        <section aria-labelledby="sources-title">
          <h2 id="sources-title">Sources</h2>
          <ul class="plain sources" role="list">
            {
              v.sources.map((s) => (
                <li>
                  <a href={s} rel="noopener" title={s}>{label(s)}</a>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </div>

    <footer class="page-foot">
      <p>
        Written from the public notice linked above. The dates and the fixed version are the
        advisory's. To correct this entry, edit its data file and open a pull request.
      </p>
      <p class="page-foot__links">
        <a href="/breaches/">All entries</a>
        <a href="/breaches/data.json">All entries as JSON</a>
        <a href={`${REPO}/blob/main/data/vulnerabilities/${v.id}.yaml`} rel="noopener">Data file</a>
        <a href={`${REPO}/edit/main/data/vulnerabilities/${v.id}.yaml`} rel="noopener">Propose a change</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  /* the account at reading width on the left, the facts beside it in one panel that stays in view */
  .anatomy {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(16rem, 22rem);
    justify-content: space-between;
    gap: var(--space-7);
    align-items: start;
  }
  .anatomy__main > section + section {
    margin-top: var(--space-7);
  }
  .anatomy h2 {
    font-size: var(--h3);
    margin-bottom: var(--space-3);
  }
  .anatomy__side {
    position: sticky;
    top: var(--space-5);
    display: grid;
    gap: var(--space-5);
  }
  .anatomy__side h2 {
    font-size: var(--small);
    font-weight: 600;
    letter-spacing: 0;
    margin-bottom: var(--space-2);
  }
  .anatomy__side .timeline {
    margin: 0;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--small);
  }
  .sources a {
    overflow-wrap: anywhere;
  }
  .timeline p {
    margin: var(--space-1) 0 0;
    font-size: var(--small);
  }
  .timeline__label {
    display: block;
    font-size: var(--tiny);
    color: var(--ink-2);
  }

  /* M13: the rail draws in from the top, then the dates fade in behind it; once, on load */
  @media (prefers-reduced-motion: no-preference) {
    .timeline::before {
      transform-origin: top;
      animation: rail-down var(--dur-slow) var(--ease-draw) both;
    }
    .timeline > li {
      animation: fade-in var(--dur) var(--ease) both;
      animation-delay: calc(var(--dur-slow) * 0.6);
    }
    .timeline > li + li {
      animation-delay: var(--dur-slow);
    }
  }
  @keyframes rail-down {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  .controls__list {
    margin: 0;
  }
  .controls__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin: 0 0 var(--space-1);
    font-weight: 500;
    max-width: none;
  }
  .rows .controls__name {
    color: var(--ink);
    font-size: var(--text-body);
  }
  .party {
    font-size: var(--tiny);
    font-weight: 400;
    color: var(--ink-2);
  }
  .rows .controls__cite {
    font-size: var(--tiny);
  }
  .none {
    color: var(--ink-2);
  }
  .kind-attack {
    --kind: var(--toggle-attack);
  }
  .kind-misconfiguration {
    --kind: var(--toggle-misconfiguration);
  }
  /* the replay: a rail in the toggle's ink, like the toggled steps it links to */
  .replay {
    padding: var(--space-1) 0 var(--space-1) var(--space-5);
    border-left: 2px solid var(--kind);
  }
  .replay p {
    margin: 0 0 var(--space-2);
  }
  .replay > :last-child {
    margin-bottom: 0;
  }
  .replay__kind {
    font-size: var(--tiny);
    font-weight: 500;
    color: var(--ink-2);
  }
  .replay__head {
    font-size: var(--h3);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }
  .replay__head a {
    color: var(--ink);
    text-decoration: none;
  }
  .replay__head a:hover {
    color: var(--signal);
  }
  .replay__summary {
    color: var(--ink-2);
  }
  .replay__meta {
    font-size: var(--small);
    color: var(--ink-2);
    max-width: none;
  }
  @media (max-width: 60rem) {
    .anatomy {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
    .anatomy__side {
      position: static;
    }
  }
</style>
