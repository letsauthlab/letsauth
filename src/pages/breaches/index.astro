---
import Base from "@/layouts/Base.astro";
import { breachList } from "@/lib/breaches";
import { getDataset } from "@/lib/data";
import { PARTY_LABEL, TOGGLE_KIND_LABEL, VULNERABILITY_CLASS_LABEL } from "@/lib/labels";
import { REPO } from "@/lib/site";

const data = getDataset();
const breaches = breachList(data);
const replays = breaches.filter((b) => b.replay).length;
const linked = new Set(breaches.flatMap((b) => b.vulnerability.features)).size;
const date = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<Base
  title="Breach anatomy"
  description={`${breaches.length} published vulnerabilities and incidents in how agents were authorized, each traced to the control that was missing, the atlas requirements that name it and, where one exists, a replay in the delegation chain explorer.`}
  path="/breaches/"
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Breach anatomy</p>
      <h1>What actually broke, traced to the control that was missing</h1>
      <p class="lede">
        Each entry is a published vulnerability or incident in how an agent system was
        authorized, written from its advisory. It names the class of failure, the requirements
        in the MCP auth atlas that stand for the missing control, and how many listed servers
        meet them today. Where the explorer has a toggle for the pattern, the entry links to that
        replay. Nothing here goes beyond what the advisory states.
      </p>
      <dl class="facts" aria-label="Breach anatomy at a glance">
        <div>
          <dt>Entries</dt>
          <dd>{breaches.length}</dd>
        </div>
        <div>
          <dt>With a replay</dt>
          <dd>{replays}</dd>
        </div>
        <div>
          <dt>Requirements named</dt>
          <dd>{linked}</dd>
        </div>
      </dl>
    </header>

    <ol id="breach-list" class="breaches" role="list">
      {
        breaches.map(({ vulnerability: v, features, replay }) => (
          <li class="breach card" data-breach={v.id} data-class={v.class}>
            <p class="breach__meta">
              <span class="pill">{VULNERABILITY_CLASS_LABEL[v.class]}</span>
              <time datetime={v.disclosed}>{date(v.disclosed)}</time>
              <span class="breach__id">{v.id}</span>
            </p>
            <h2>
              <a href={`/breaches/${v.id}/`}>{v.title}</a>
            </h2>
            <p class="breach__affects">{v.affects[0]}</p>
            <p class="breach__links">
              {features.length > 0 ? (
                <span>
                  {features.map((f, i) => (
                    <>
                      {i > 0 && ", "}
                      <a href={`/mcp/features/${f.id}/`}>{f.name}</a>
                      <span class="breach__party"> {PARTY_LABEL[f.party]}</span>
                    </>
                  ))}
                </span>
              ) : (
                <span class="muted">No atlas requirement covers this control yet</span>
              )}
              {replay && (
                <a
                  class:list={["replay", `kind-${replay.toggle.kind}`]}
                  href={`/explorer/${replay.scenario.id}/${replay.toggle.id}/`}
                  data-replay={replay.toggle.id}
                >
                  Replay: {replay.toggle.name}
                  <span class="replay__kind">{TOGGLE_KIND_LABEL[replay.toggle.kind]}</span>
                </a>
              )}
            </p>
          </li>
        ))
      }
    </ol>

    <footer class="page-foot">
      <h2>How to read an entry</h2>
      <p>
        The class says which kind of control failed. The requirements are the atlas rows that
        stand for that control under the current MCP Authorization revision; the entry's page
        says how many listed servers support each, so a breach reads as "this is what happens
        when that cell is empty". A replay is a toggle in the explorer that turns the same
        pattern on in a baseline chain, step by step, with the token at each hop. Entries are
        written from the advisory and link to it; the dates are the advisory's.
      </p>
      <p>
        Entries are data: one YAML file each under <code>data/vulnerabilities/</code>, validated
        against the shared model, open under CC BY 4.0. To add one, open a pull request with the
        advisory as its first source.
      </p>
      <p class="page-foot__links">
        <a href="/breaches/data.json">All entries as JSON</a>
        <a href={`${REPO}/tree/main/data/vulnerabilities`} rel="noopener">Data files</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  .breaches {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .breach__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    max-width: none;
  }
  .breach__id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }
  .breach h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
  }
  .breach h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  .breach h2 a:hover {
    text-decoration: underline;
  }
  .breach__affects {
    margin: 0 0 var(--space-3);
    color: var(--ink-muted);
  }
  .breach__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font-size: var(--text-sm);
    max-width: none;
  }
  .breach__party {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .muted {
    color: var(--ink-muted);
  }
  .replay {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.35em 0.8em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .replay:hover {
    border-color: var(--line-strong);
  }
  .replay__kind {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .replay.kind-attack .replay__kind {
    color: var(--status-unsupported);
  }
  .replay.kind-misconfiguration .replay__kind {
    color: var(--status-partial);
  }
</style>
