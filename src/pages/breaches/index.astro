---
import Base from "@/layouts/Base.astro";
import { breachList } from "@/lib/breaches";
import { getDataset } from "@/lib/data";
import { PARTY_LABEL, TOGGLE_KIND_LABEL, VULNERABILITY_CLASS_LABEL } from "@/lib/labels";
import { REPO } from "@/lib/site";

const data = getDataset();
const breaches = breachList(data);
const replays = breaches.filter((b) => b.replay).length;
const linked = new Set(breaches.flatMap((b) => b.vulnerability.features)).size;
const date = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<Base
  title="Breach anatomy"
  description={`${breaches.length} published vulnerabilities and incidents in how agents were authorized, each traced to the control that was missing and the atlas requirements that name it.`}
  path="/breaches/"
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Breach anatomy</p>
      <h1>Published failures in how agents were authorized</h1>
      <p class="lede">
        Each entry is a vulnerability or incident written from its advisory, with the control
        that was missing and the MCP auth atlas requirements that stand for it. Where the
        explorer has a toggle for the pattern, the entry links to that replay.
      </p>
      <dl class="facts" aria-label="Breach anatomy at a glance">
        <div>
          <dt>Entries</dt>
          <dd>{breaches.length}</dd>
        </div>
        <div>
          <dt>With a replay</dt>
          <dd>{replays}</dd>
        </div>
        <div>
          <dt>Requirements named</dt>
          <dd>{linked}</dd>
        </div>
      </dl>
    </header>

    <ol id="breach-list" class="rows breaches" role="list">
      {
        breaches.map(({ vulnerability: v, features, replay }) => (
          <li class="breach" data-breach={v.id} data-class={v.class}>
            <p class="breach__meta">
              <span class="chip">{VULNERABILITY_CLASS_LABEL[v.class]}</span>
              <time datetime={v.disclosed}>{date(v.disclosed)}</time>
              <span class="breach__id">{v.id}</span>
            </p>
            <h2 class="rows__title">
              <a href={`/breaches/${v.id}/`}>{v.title}</a>
            </h2>
            <p class="breach__affects">{v.affects[0]}</p>
            <p class="breach__links">
              {features.length > 0 ? (
                <span>
                  {features.map((f, i) => (
                    <>
                      {i > 0 && ", "}
                      <a href={`/mcp/features/${f.id}/`}>{f.name}</a>
                      <span class="breach__party"> {PARTY_LABEL[f.party]}</span>
                    </>
                  ))}
                </span>
              ) : (
                <span class="muted">No atlas requirement covers this control yet</span>
              )}
              {replay && (
                <a
                  class:list={["replay", `kind-${replay.toggle.kind}`]}
                  href={`/explorer/${replay.scenario.id}/${replay.toggle.id}/`}
                  data-replay={replay.toggle.id}
                >
                  <span class="replay__dot" aria-hidden="true" />
                  Replay: {replay.toggle.name}
                  <span class="visually-hidden">({TOGGLE_KIND_LABEL[replay.toggle.kind]})</span>
                </a>
              )}
            </p>
          </li>
        ))
      }
    </ol>

    <footer class="page-foot">
      <h2>How to read an entry</h2>
      <p>
        The class says which kind of control failed. The requirements are the atlas rows that
        stand for that control under the current MCP Authorization revision. The entry's page
        says how many listed servers support each, so a breach shows what happens when that cell
        is empty. A replay is a toggle in the explorer that turns the same pattern on in a
        baseline chain, with the token at each hop. Entries link to their advisory, and the dates
        are the advisory's.
      </p>
      <p>
        Each entry is one YAML file under <code>data/vulnerabilities/</code>, validated against
        the shared model and open under CC BY 4.0. To add one, open a pull request with the
        advisory as its first source.
      </p>
      <p class="page-foot__links">
        <a href="/breaches/data.json">All entries as JSON</a>
        <a href={`${REPO}/tree/main/data/vulnerabilities`} rel="noopener">Data files</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  .breach__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0 0 var(--space-2);
    font-size: var(--small);
    color: var(--ink-2);
    max-width: none;
  }
  .breach__id {
    font-family: var(--font-mono);
    font-size: var(--tiny);
    overflow-wrap: anywhere;
  }
  .breach .rows__title {
    margin-bottom: var(--space-2);
  }
  .breach__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    max-width: none;
  }
  .breach__party {
    font-size: var(--tiny);
    color: var(--ink-2);
  }
  .kind-attack {
    --kind: var(--toggle-attack);
  }
  .kind-misconfiguration {
    --kind: var(--toggle-misconfiguration);
  }
  .replay {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    max-width: 100%;
    padding: 0.3em 0.8em;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .replay:hover {
    border-color: var(--rule-strong);
  }
  .replay__dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--kind);
  }
</style>
