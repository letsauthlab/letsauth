---
import Base from "@/layouts/Base.astro";

/**
 * A long-form page (about, contribute, imprint, privacy and the like). These sit at the top of
 * the tree, so none has a breadcrumb. The page opens with the shared page head, then runs as
 * two columns: the text on the left, and on the right a rail with the page's sections (read
 * from the h2s the page renders), an optional aside and the date the text last changed.
 * Sections are numbered; the rail marks the section the address points at (`:target`) without
 * JavaScript, and a 2px bar at the top of the window shows how far the reader is (M14). Pages
 * put their sections in the default slot and a `.panel` for the rail in the `aside` slot.
 */
interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  /** The h1. Defaults to the title. */
  heading?: string;
  lede?: string;
  /** ISO date (YYYY-MM-DD) the text was last changed; omit on pages that are not dated. */
  updated?: string;
}

const { title, description, path, eyebrow, heading, lede, updated } = Astro.props;
const updatedLabel = updated
  ? new Date(`${updated}T00:00:00Z`).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : undefined;

// The sections of the page are its h2s. Each gets an id (its own, or one from its text) so the
// rail can link to it, and the rail lists them in order.
const slug = (text: string) =>
  text
    .toLowerCase()
    .replace(/&[a-z]+;|&#\d+;/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
const sections: { id: string; title: string }[] = [];
const body = (await Astro.slots.render("default")).replace(
  /<h2(\s[^>]*)?>([\s\S]*?)<\/h2>/g,
  (_match, attrs: string | undefined, inner: string) => {
    const text = inner.replace(/<[^>]+>/g, "").trim();
    let open = attrs ?? "";
    let id = /\sid="([^"]+)"/.exec(open)?.[1];
    if (!id) {
      id = slug(text);
      open += ` id="${id}"`;
    }
    sections.push({ id, title: text });
    return `<h2${open}>${inner}</h2>`;
  },
);
const hasAside = Astro.slots.has("aside");
// The rail marks the section in the address: one :has(:target) selector per section, since a
// link cannot see its target. Ids are slugs or the page's own, so they need no escaping.
const currentRule = sections
  .map((s) => `.doc:has([id="${s.id}"]:target) .doc__toc a[href="#${s.id}"]`)
  .join(",");
---

<Base title={title} description={description} path={path}>
  {
    currentRule && (
      <Fragment slot="head">
        <style is:inline set:html={`${currentRule}{color:var(--ink);border-color:var(--signal)}`} />
      </Fragment>
    )
  }
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="wrap">
    <header class="page-head">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading ?? title}</h1>
      {lede && <p class="lede">{lede}</p>}
    </header>
    <div class="doc">
      <div class="prose doc__body" set:html={body} />
      <aside class="doc__rail">
        {
          sections.length > 1 && (
            <nav class="doc__toc" aria-label="On this page">
              <p class="doc__rail-title">On this page</p>
              <ol>
                {sections.map((s) => (
                  <li>
                    <a href={`#${s.id}`}>{s.title}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          hasAside && (
            <div class="doc__aside">
              <slot name="aside" />
            </div>
          )
        }
        {
          updated && (
            <p class="doc__updated">
              Last updated <time datetime={updated}>{updatedLabel}</time>
            </p>
          )
        }
      </aside>
    </div>
  </article>
</Base>

<style>
  /* the rail sits beside a text column one measure wide */
  .doc {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) 15rem;
    justify-content: space-between;
    gap: var(--space-7) var(--space-8);
    align-items: start;
  }
  .doc__rail {
    position: sticky;
    top: calc(var(--header-h) + var(--space-5));
    display: grid;
    gap: var(--space-5);
    font-size: var(--small);
  }
  .doc__rail-title {
    margin: 0 0 var(--space-3);
    font-size: var(--tiny);
    font-weight: 500;
    color: var(--ink-2);
  }
  .doc__toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: toc;
    display: grid;
    gap: 0.15rem;
  }
  .doc__toc li {
    counter-increment: toc;
  }
  .doc__toc a {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: 0.3em 0 0.3em var(--space-3);
    border-left: 2px solid var(--rule);
    color: var(--ink-2);
    text-decoration: none;
    line-height: 1.35;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .doc__toc a::before {
    content: counter(toc, decimal-leading-zero);
    flex: none;
    font-size: var(--tiny);
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  .doc__toc a:hover,
  .doc__toc a:focus-visible {
    color: var(--ink);
    border-left-color: var(--rule-strong);
  }
  .doc__updated {
    margin: 0;
    font-size: var(--tiny);
    color: var(--ink-2);
  }

  /* M14: reading progress, only where scroll-driven animation exists and motion is welcome */
  .reading-progress {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .reading-progress {
        display: block;
        position: fixed;
        inset: 0 0 auto;
        z-index: 20;
        height: 2px;
        background: var(--signal);
        transform-origin: 0 50%;
        transform: scaleX(0);
        pointer-events: none;
        /* longhands: the minifier would fold a shorthand and the timeline into one invalid rule */
        animation-name: reading-progress;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
      }
    }
  }
  @keyframes reading-progress {
    to {
      transform: scaleX(1);
    }
  }

  @media print {
    .doc {
      display: block;
    }
    .doc__rail {
      display: none;
    }
  }
  @media (max-width: 64rem) {
    .doc {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
    /* The rail reads first on one column: a row of section chips, then the text. */
    .doc__rail {
      position: static;
      order: -1;
      gap: var(--space-4);
    }
    .doc__toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .doc__toc a {
      padding: 0.2em 0.75em;
      border: 1px solid var(--rule);
      border-radius: var(--radius-pill);
      font-size: var(--tiny);
    }
    .doc__toc a::before {
      content: none;
    }
    .doc__aside {
      display: none;
    }
  }
</style>

<style is:global>
  /* Repeated from global.css so the order holds whichever stylesheet the bundle puts first. */
  @layer reset, tokens, base, layout, components, product, utilities, print;

  /*
   * Body typography for long-form pages, in the layout layer so a page's own (unlayered) classes
   * win. Sections are numbered like the rail; the number sits above the heading as a label.
   */
  @layer layout {
    .doc__body {
      counter-reset: section;
    }
    .doc__body h2 {
      counter-increment: section;
      margin-top: var(--space-8);
      scroll-margin-top: calc(var(--header-h) + var(--space-5));
    }
    .doc__body h2::before {
      content: counter(section, decimal-leading-zero);
      display: block;
      margin-bottom: var(--space-2);
      font-size: var(--tiny);
      font-weight: 500;
      letter-spacing: 0;
      font-variant-numeric: tabular-nums;
      color: var(--ink-2);
    }
    .doc__body h2:first-child {
      margin-top: 0;
    }
    .doc__body h3 {
      margin-top: var(--space-6);
    }
    .doc__body :is(p, ul, ol, dl) {
      max-width: var(--measure);
    }
    .doc__body :is(ul, ol) {
      padding-left: 1.3em;
    }
    .doc__body :is(ul, ol) > li {
      margin-bottom: var(--space-2);
      padding-left: 0.2em;
    }
    .doc__body li::marker {
      color: var(--ink-2);
    }
    .doc__body address {
      font-style: normal;
      max-width: 24rem;
      margin-bottom: var(--space-4);
    }
    .doc__body > :last-child {
      margin-bottom: 0;
    }
  }
</style>
