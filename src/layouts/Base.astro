---
import "@/styles/global.css";
// The two fonts every page paints with, preloaded so text does not reflow when they swap in
// (the fontsource CSS declares them with font-display: swap; Vite gives both the same hashed URL).
import fontBody from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import fontMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import BrandLogo from "@/components/BrandLogo.astro";
import Reach from "@/components/Reach.astro";
import { LAB, LEGAL_LINKS, OPERATOR, REPO } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/mcp/". Defaults to the current path. */
  path?: string;
  /** When set, the page is excluded from search indexing and the sitemap hint. */
  noindex?: boolean;
  /** The social card, a path under public/. Defaults to the home card. */
  image?: string;
}

const { title, description, path, noindex = false, image = "/og.png" } = Astro.props;
const site = Astro.site ?? new URL("https://letsauth.eu");
const canonical = new URL(path ?? Astro.url.pathname, site);
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined;
const fullTitle =
  title === "letsauth" ? "letsauth · the lab for agent authorization" : `${title} · letsauth`;
const here = path ?? Astro.url.pathname;
// Who publishes the site, for search engines: the lab, founded and run by one person.
const author = {
  "@type": "Person",
  name: OPERATOR.name,
  url: OPERATOR.site,
  sameAs: [OPERATOR.mastodon.url, OPERATOR.bluesky],
};
const publisher = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "letsauth",
  url: site.href,
  author,
  publisher: {
    "@type": "Organization",
    name: LAB,
    url: site.href,
    founder: author,
  },
};
// Footer link groups: what you can read, what you can take, and who is behind it.
const footerGroups = [
  {
    title: "Explore",
    links: [
      { href: "/mcp/", label: "Servers" },
      { href: "/mcp/scanner/", label: "Scanner" },
      { href: "/standards/", label: "Standards" },
      { href: "/explorer/", label: "Explorer" },
      { href: "/breaches/", label: "Breaches" },
    ],
  },
  {
    title: "Open data",
    links: [
      { href: "/mcp/data.json", label: "MCP atlas (JSON)" },
      { href: "/standards/data.json", label: "Standards (JSON)" },
      { href: "/explorer/data.json", label: "Scenarios (JSON)" },
      { href: "/breaches/data.json", label: "Breaches (JSON)" },
      { href: "/contribute/", label: "Contribute" },
      { href: REPO, label: "Source on GitHub", external: true },
    ],
  },
  {
    title: "Lab",
    links: [
      { href: "/about/", label: "About" },
      { href: `mailto:${OPERATOR.email}`, label: "Contact" },
      { href: "/.well-known/security.txt", label: "Report a vulnerability" },
    ],
  },
];
// The primary navigation: one entry per top-level section, each matching its whole subtree.
// Pages outside these subtrees (about, the legal pages) light up nothing.
const nav = [
  {
    href: "/mcp/",
    label: "Servers",
    match: (p: string) => p.startsWith("/mcp/"),
  },
  {
    href: "/standards/",
    label: "Standards",
    match: (p: string) => p.startsWith("/standards/"),
  },
  {
    href: "/explorer/",
    label: "Explorer",
    match: (p: string) => p.startsWith("/explorer/"),
  },
  {
    href: "/breaches/",
    label: "Breaches",
    match: (p: string) => p.startsWith("/breaches/"),
  },
  {
    href: "/contribute/",
    label: "Contribute",
    match: (p: string) => p.startsWith("/contribute/"),
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="author" content={OPERATOR.name} />
    <link rel="author" href={OPERATOR.site} />
    <link rel="me" href={OPERATOR.mastodon.url} />
    <link rel="me" href={OPERATOR.bluesky} />
    <meta name="fediverse:creator" content={OPERATOR.mastodon.handle} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="letsauth" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(image, site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* --ground in sRGB: oklch(98.5% 0.003 250) and oklch(21% 0.008 255) (pnpm check:contrast --hex) */}
    <meta name="theme-color" content="#f9fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16191c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      [fontBody, fontMono].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(publisher)} />
    <script is:inline>
      // Apply a stored theme before first paint. Stored value is a per-viewer convenience only.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {plausibleDomain && <Reach notFound={here === "/404.html"} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <aside class="wip" aria-label="Project status">
      <p class="wrap wip__text">
        <strong>Work in progress:</strong> letsauth is an early preview, so the data is partial and
        pages change often. <a href="/contribute/">Help fill the gaps</a>
      </p>
    </aside>
    <header class="site-header">
      <div class="wrap site-header__row">
        <a class="brand" href="/" aria-label="letsauth home">
          <BrandLogo />
        </a>
        <nav class="site-nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.match(here) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a
          class="site-github"
          href={REPO}
          rel="noopener"
          aria-label="Source on GitHub"
          title="Source on GitHub"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
        </a>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Toggle colour theme"
          title="Toggle colour theme"
        >
          <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
          </svg>
          <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__top">
        <div class="site-footer__about">
          <a class="site-footer__brand" href="/" aria-label="letsauth home">
            <BrandLogo />
          </a>
          <p>
            An independent lab for agent authorization, run by{" "}
            <a class="site-footer__author" href={OPERATOR.site} rel="author">{OPERATOR.name}</a>. Each cell cites
            its source and the data is open. Only a nightly scan of public metadata ever contacts a server.
          </p>
          <a class="site-footer__eu" href="/made-in-europe/">Made in Europe, hosted in the EU</a>
        </div>
        <nav class="site-footer__nav" aria-label="Footer">
          {
            footerGroups.map((group) => (
              <div class="site-footer__group">
                <h2 class="site-footer__heading">{group.title}</h2>
                <ul role="list">
                  {group.links.map((l) => (
                    <li>
                      <a
                        href={l.href}
                        rel={"external" in l ? "noopener" : undefined}
                        aria-current={here === l.href ? "page" : undefined}
                      >
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </div>
      <div class="wrap site-footer__bottom">
        <p>
          © {new Date().getFullYear()} {LAB} · Code{" "}
          <a href={`${REPO}/blob/main/LICENSE`} rel="noopener">MIT</a> · Data{" "}
          <a href={`${REPO}/blob/main/LICENSE-DATA`} rel="noopener">CC BY 4.0</a>
        </p>
        <nav aria-label="Legal">
          {
            LEGAL_LINKS.map((l) => (
              <a href={l.href} aria-current={here === l.href ? "page" : undefined}>
                {l.label}
              </a>
            ))
          }
        </nav>
      </div>
    </footer>
    <script>
      // On a narrow screen the navigation scrolls sideways; bring the current section into view.
      const nav = document.querySelector<HTMLElement>(".site-nav");
      const current = nav?.querySelector<HTMLElement>('[aria-current="page"]');
      if (nav && current && nav.scrollWidth > nav.clientWidth) {
        nav.scrollLeft = current.offsetLeft - (nav.clientWidth - current.offsetWidth) / 2;
      }
      const btn = document.getElementById("theme-toggle");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        const current = root.dataset.theme ?? (prefersDark ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--space-4);
    top: -3rem;
    background: var(--signal);
    color: var(--on-signal);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    z-index: 10;
  }
  .skip:focus {
    top: var(--space-2);
  }

  /* work-in-progress banner: one sentence on a band, the link at its end (CLAUDE.md keeps it) */
  .wip {
    background: var(--ground-2);
    border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: var(--tiny);
  }
  .wip__text {
    max-width: none;
    margin-block: 0;
    padding-block: var(--space-2);
    line-height: 1.5;
  }
  .wip__text strong {
    color: var(--ink);
    font-weight: 600;
  }
  .wip__text a {
    color: var(--ink);
    font-weight: 500;
    white-space: nowrap;
  }
  .wip__text a:hover {
    color: var(--signal);
  }

  /* header: brand, text navigation, tools; a hairline under it and nothing sticky */
  .site-header {
    background: var(--ground);
    border-bottom: 1px solid var(--rule);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 3.75rem;
  }
  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }
  .site-nav {
    position: relative;
    display: flex;
    align-items: stretch;
    align-self: stretch;
    gap: var(--space-1);
    margin-left: auto;
    font-size: var(--small);
    font-weight: 500;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.5em 0.6em;
    border-bottom: 2px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .site-nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--rule-strong);
  }
  .site-nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }
  .site-nav a:focus-visible {
    outline-offset: -2px;
  }
  /* the repository as an icon beside the theme toggle; its name is in the label */
  .site-github {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    color: var(--ink-2);
    transition: color var(--dur-fast) var(--ease);
  }
  .site-github:hover {
    color: var(--ink);
  }

  /* M16: the theme toggle swaps its icon and does nothing else */
  .theme-toggle {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }
  .theme-toggle .icon-moon {
    display: none;
  }
  :root[data-theme="dark"] .theme-toggle .icon-sun {
    display: none;
  }
  :root[data-theme="dark"] .theme-toggle .icon-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-toggle .icon-sun {
      display: none;
    }
    :root:not([data-theme="light"]) .theme-toggle .icon-moon {
      display: block;
    }
  }

  .site-main {
    flex: 1;
    padding-block: var(--space-7) var(--space-9);
  }

  /* footer: a band with the statement, three link columns and the legal line under a rule */
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--ground-2);
    padding-block: var(--space-7) var(--space-5);
    color: var(--ink-2);
    font-size: var(--small);
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: var(--space-7);
    align-items: start;
  }
  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-bottom: var(--space-3);
  }
  .site-footer__about p {
    margin: 0 0 var(--space-4);
    max-width: 36ch;
  }
  /* the one inline link in the statement: the person behind the lab, a plain followed link */
  .site-footer__author {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-fast) var(--ease);
  }
  .site-footer__author:hover {
    text-decoration-color: currentColor;
  }
  .site-footer__eu {
    display: inline-flex;
    align-items: center;
    padding: 0.15em 0.75em;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-size: var(--tiny);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .site-footer__eu:hover {
    color: var(--ink);
    border-color: var(--ink-2);
  }
  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .site-footer__heading {
    margin: 0 0 var(--space-3);
    font-size: var(--tiny);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-2);
  }
  .site-footer__group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .site-footer__group a {
    color: var(--ink);
    text-decoration: none;
  }
  .site-footer__group a:hover,
  .site-footer__group a[aria-current="page"] {
    color: var(--signal);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-size: var(--tiny);
  }
  .site-footer__bottom p {
    margin: 0;
    max-width: none;
  }
  .site-footer__bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .site-footer__bottom a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .site-footer__bottom a:hover,
  .site-footer__bottom a[aria-current="page"] {
    color: var(--ink);
  }
  @media (max-width: 56rem) {
    .site-footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
  /*
   * Up to a small laptop the navigation takes its own row under the brand and scrolls sideways
   * when it does not fit, from one edge of the screen to the other, with no scrollbar.
   */
  @media (max-width: 64rem) {
    .site-header__row {
      flex-wrap: wrap;
      gap: 0 var(--space-3);
      padding-top: var(--space-2);
    }
    .site-github {
      margin-left: auto;
    }
    .site-nav {
      order: 1;
      flex: 1 0 100%;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: calc(var(--gutter) - 0.6em);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      gap: 0;
    }
    .site-nav::-webkit-scrollbar {
      display: none;
    }
    .site-nav a {
      padding-block: 0.65em;
    }
  }
  @media print {
    .skip,
    .wip,
    .site-nav,
    .site-github,
    .theme-toggle,
    .site-footer__nav {
      display: none;
    }
    .site-footer {
      background: none;
    }
  }
  @media (max-width: 40rem) {
    .site-main {
      padding-block: var(--space-6) var(--space-8);
    }
    .site-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
