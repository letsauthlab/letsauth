---
/*
 * The home page's head (spec 019): the page band with the title, two figures and the ways in,
 * set over every cell of the current matrix (`MatrixField`).
 */
import MatrixField from "@/components/MatrixField.astro";
import PageBand from "@/components/PageBand.astro";
import { currentRevision, matrixFor } from "@/lib/atlas";
import { getDataset } from "@/lib/data";

const data = getDataset();
const matrix = matrixFor(data, currentRevision(data).id);
const fmt = (n: number) => n.toLocaleString("en-GB");
---

<PageBand labelledby="hero-title">
  <MatrixField slot="field" />
  <div class="hero">
    <p class="eyebrow">An independent lab for agent authorization</p>
    <h1 id="hero-title">How MCP servers authorize AI agents</h1>
    <dl class="facts hero__facts">
      <div>
        <dt>Public MCP servers</dt>
        <dd>{fmt(matrix.rows.length)}</dd>
      </div>
      <div>
        <dt>Spec requirements</dt>
        <dd>{fmt(matrix.columns.length)}</dd>
      </div>
    </dl>
    <p class="band__actions">
      <a class="button" href="#matrix">Explore the matrix</a>
      <a class="button quiet" href="/ledger/">See what changed</a>
      <a class="band__link" href="/mcp/data.json">Download the data</a>
    </p>
  </div>
</PageBand>

<style>
  .hero h1 {
    max-width: 14ch;
    margin-bottom: var(--space-6);
  }
  .hero__facts {
    max-width: 38rem;
    column-gap: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .hero .band__actions {
    margin-top: 0;
  }
</style>
