---
/*
 * The home page's head (spec 019): a band across the full width of the page, the title, three
 * figures and the two ways in, set over a drawing of the matrix itself. The drawing is every
 * cell of the current matrix, servers across and requirements down, in the status colours,
 * fading out under the text; a slow wave of light crosses it column by column, like a scan.
 * It is decoration (aria-hidden), and still under reduced motion.
 */
import { cellKey, currentRevision, matrixFor } from "@/lib/atlas";
import { getDataset } from "@/lib/data";

const data = getDataset();
const matrix = matrixFor(data, currentRevision(data).id);
const servers = matrix.rows.length;
const requirements = matrix.columns.length;
let observed = 0;
for (const cell of matrix.cells.values()) if (cell.observation) observed += 1;
const total = servers * requirements;
const fmt = (n: number) => n.toLocaleString("en-GB");

// the matrix, turned so the servers run across the band
type Mark = "s" | "p" | "x" | "u" | "d" | "n";
const STEP = 10;
const CELL = 8;
const columns = matrix.rows.map((server) =>
  matrix.columns.map((feature): Mark => {
    const cell = matrix.cells.get(cellKey(server.id, feature.id));
    const status = cell?.status ?? "unknown";
    if (status === "supported") return "s";
    if (status === "partial") return "p";
    if (status === "unsupported") return "x";
    if (status === "not-applicable") return "n";
    return (cell?.derived ?? true) ? "d" : "u";
  }),
);
const fieldW = servers * STEP;

// the three figures, each with a short note on what it counts (shown on hover, focus or tap)
const facts = [
  {
    label: "Public MCP servers",
    value: fmt(servers),
    tip: "Remote MCP servers that anyone can sign in to, taken from public directories. Each one is a row of the matrix.",
  },
  {
    label: "Spec requirements",
    value: fmt(requirements),
    tip: `The rules the MCP Authorization spec (${matrix.revision.id}) sets, such as PKCE or HTTPS on every endpoint. Each one is a column of the matrix.`,
  },
  {
    label: "Checks done",
    value: fmt(observed),
    of: fmt(total),
    tip: `Every server is checked against every requirement: ${fmt(servers)} × ${fmt(requirements)} = ${fmt(total)} checks. ${fmt(observed)} are done; the rest are still to do.`,
  },
];
const fieldH = requirements * STEP;
---

<section class="hero" aria-labelledby="hero-title">
  <svg
    class="hero__field"
    viewBox={`0 0 ${fieldW} ${fieldH}`}
    preserveAspectRatio="xMaxYMid meet"
    aria-hidden="true"
    focusable="false"
  >
    {
      columns.map((marks, x) => (
        <g style={`--d:${x * -110}ms`}>
          {marks.map((m, y) =>
            m === "u" ? (
              <rect class="u" x={x * STEP + 0.5} y={y * STEP + 0.5} width={CELL - 1} height={CELL - 1} rx="1.5" />
            ) : m === "d" ? (
              <rect class="d" x={x * STEP + 3} y={y * STEP + 3} width="2" height="2" />
            ) : (
              <rect class={m} x={x * STEP} y={y * STEP} width={CELL} height={CELL} rx="1.5" />
            ),
          )}
        </g>
      ))
    }
  </svg>
  <div class="wrap hero__inner">
    <p class="eyebrow">An independent lab for agent authorization</p>
    <h1 id="hero-title">How MCP servers authorize AI agents</h1>
    <dl class="facts hero__facts">
      {
        facts.map((f, i) => (
          <div>
            <dt>
              {f.label}
              <span class="info">
                <button class="info__button" type="button" aria-describedby={`hero-info-${i}`}>
                  <span class="visually-hidden">About {f.label.toLowerCase()}</span>
                </button>
                <span class="info__tip" role="tooltip" id={`hero-info-${i}`}>
                  {f.tip}
                </span>
              </span>
            </dt>
            <dd>
              {f.value}
              {f.of && <span class="of"> of {f.of}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="hero__actions">
      <a class="button" href="#matrix">Explore the matrix</a>
      <a class="button quiet" href="/ledger/">See what changed</a>
      <a class="hero__data" href="/mcp/data.json">Download the data</a>
    </p>
  </div>
</section>

<style>
  /* the band: full width, the field behind, the text in the page's column over it */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    margin-bottom: var(--space-7);
    border-bottom: 1px solid var(--rule);
  }
  .hero__field {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    /* the drawing fades out under the text on the left and towards the matrix below */
    mask-image: linear-gradient(90deg, transparent 0%, transparent 44%, rgb(0 0 0 / 0.5) 56%, #000 72%);
  }
  .hero__inner {
    padding-block: var(--space-8) var(--space-7);
  }
  .hero h1 {
    max-width: 14ch;
    margin-bottom: var(--space-6);
  }
  .hero__facts {
    max-width: 38rem;
    column-gap: var(--space-6);
    margin-bottom: var(--space-6);
  }
  /* the "i" after each label: hover, focus or tap shows what the figure counts */
  .info {
    position: relative;
    display: inline-block;
    margin-left: var(--space-1);
    vertical-align: -0.15em;
  }
  .info__button {
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--ink-2);
    font: italic 600 0.6875rem/1 var(--font-serif);
    cursor: help;
  }
  .info__button::before {
    content: "i";
  }
  /* the target is larger than the ring, for touch */
  .info__button::after {
    content: "";
    position: absolute;
    inset: -0.375rem;
  }
  .info__tip {
    position: absolute;
    z-index: 2;
    top: calc(100% + var(--space-2));
    left: -0.5rem;
    width: max-content;
    max-width: min(17rem, calc(100vw - 2rem));
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--small);
    font-weight: 400;
    line-height: var(--leading-snug);
    white-space: normal;
    visibility: hidden;
    opacity: 0;
    transition: opacity 120ms var(--ease), visibility 0s 120ms;
  }
  .info:hover .info__tip,
  .info:focus-within .info__tip {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }
  .info:hover .info__button,
  .info__button:focus-visible {
    border-color: var(--signal);
    color: var(--signal);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin: 0;
  }
  .hero__data {
    font-size: var(--small);
    color: var(--ink-2);
  }
  .hero__data:hover {
    color: var(--signal);
  }

  /* the matrix field: the status colours, a wave of light crossing it column by column */
  .hero__field g {
    opacity: 0.4;
    animation: hero-wave 8s var(--ease) infinite;
    animation-delay: var(--d);
  }
  .s {
    fill: var(--ok);
  }
  .p {
    fill: var(--caution);
  }
  .x {
    fill: var(--threat);
  }
  .n {
    fill: var(--rule-strong);
  }
  .d {
    fill: var(--ink-2);
  }
  .u {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 0.8;
    stroke-dasharray: 1.5 1;
  }
  @keyframes hero-wave {
    0%,
    100% {
      opacity: 0.4;
    }
    12% {
      opacity: 1;
    }
    30% {
      opacity: 0.4;
    }
  }

  @media (max-width: 56rem) {
    .hero__field {
      mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.25), rgb(0 0 0 / 0.08));
    }
    .hero__inner {
      padding-block: var(--space-7) var(--space-6);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__field g {
      animation: none;
      opacity: 0.7;
    }
  }
</style>

<script>
  // Escape closes an open note: the button loses focus, so only hover can keep it open
  document.addEventListener("keydown", (event) => {
    const active = document.activeElement;
    if (event.key === "Escape" && active instanceof HTMLElement && active.matches(".info__button")) active.blur();
  });
</script>
