---
import { resolveCitation } from "@/lib/citations";
import { getDataset } from "@/lib/data";
import type { Citation } from "@/schema";

interface Props {
  entry: Citation;
  /** Show the revision id after the section. */
  withRevision?: boolean;
}

const { entry, withRevision = false } = Astro.props;
const cite = resolveCitation(getDataset(), entry);
---

<cite class="citation">
  <a href={cite.url} rel="noopener">{cite.section}</a>
  {withRevision && <span class="rev">{cite.specName} {cite.revisionId}</span>}
</cite>

<style>
  .citation {
    font-style: normal;
    font-size: var(--small);
  }
  .rev {
    color: var(--ink-2);
    margin-left: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--tiny);
  }
</style>
