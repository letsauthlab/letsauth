---
import { type Layout, PAD, wrapLabel } from "@/lib/graph";
import {
  BODY_LABEL,
  MATURITY_LABEL,
  MATURITY_ORDER,
  MATURITY_TAG,
  RELATION_DESCRIPTION,
  RELATION_LABEL,
} from "@/lib/labels";
import { buildsOnSpine, RELATION_TYPES } from "@/lib/standards";
import type { RelationType } from "@/schema";
import MaturityTag from "./MaturityTag.astro";

interface Props {
  layout: Layout;
}

const { layout } = Astro.props;
const { nodes, edges, lanes, width, height } = layout;
const byId = new Map(nodes.map((n) => [n.spec.id, n.spec]));
const specs = nodes.map((n) => n.spec);
const relations = edges.map((e) => e.relation);
const usedTypes = RELATION_TYPES.filter((t) => relations.some((r) => r.type === t));
const directed = usedTypes.filter((t) => t !== "competes-with" && t !== "solves-same-problem-as");
const usedMaturities = MATURITY_ORDER.filter((m) => specs.some((s) => s.maturity === m));

// M4: the longest builds-on chain draws in from the oldest document to the newest
const spine = buildsOnSpine(specs, relations);
const spineStep = new Map(spine.map((r, i) => [`${r.from}|${r.type}|${r.to}`, i]));
const spineEdges = edges.filter((e) =>
  spineStep.has(`${e.relation.from}|${e.relation.type}|${e.relation.to}`),
);
const spineFirst = spine[0] ? byId.get(spine[0].to) : undefined;
const spineLast = spine.at(-1) ? byId.get(spine.at(-1)?.from ?? "") : undefined;

const draft = new Set(["individual-draft", "working-group-draft", "candidate"]);
// 13px Geist at weight 500 averages a little under 7px a character
const chipWidth = (text: string) => Math.round(text.length * 7 + 16);

function edgeTitle(type: RelationType, fromId: string, toId: string, note?: string): string {
  const from = byId.get(fromId)?.name ?? fromId;
  const to = byId.get(toId)?.name ?? toId;
  const phrase = `${from} ${RELATION_LABEL[type].forward} ${to}`;
  return note ? `${phrase}. ${note}` : phrase;
}
const key = (e: (typeof edges)[number]) => `${e.relation.from}|${e.relation.type}|${e.relation.to}`;
---

<figure class="map" aria-labelledby="map-caption">
  <div
    class="plate map-frame"
    id="map-frame"
    tabindex="0"
    role="region"
    aria-label="Standards map, scrolls horizontally"
  >
    <svg
      id="map"
      viewBox={`0 0 ${width} ${height}`}
      width={width}
      height={height}
      xmlns="http://www.w3.org/2000/svg"
      aria-labelledby="map-title"
      data-nodes={nodes.length}
      data-edges={edges.length}
    >
      <title id="map-title">
        Specifications for agent authorization, one node each, grouped by publishing body in
        rows and by what they build on in columns, with their relations drawn as lines.
      </title>
      <defs>
        {
          directed.flatMap((t) => [`arrow-${t}`, `arrow-${t}-full`]).map((id) => (
            <marker
              id={id}
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto-start-reverse"
            >
              <path
                d="M0,0 L10,5 L0,10 z"
                class:list={["arrow", `arrow-${id.replace(/^arrow-|-full$/g, "")}`, { full: id.endsWith("-full") }]}
              />
            </marker>
          ))
        }
      </defs>

      <g class="lanes" aria-hidden="true">
        {
          lanes.map((lane, i) => (
            <g class="lane" data-body={lane.body}>
              {i > 0 && (
                <line
                  x1={PAD / 2}
                  x2={width - PAD / 2}
                  y1={lane.y - 13}
                  y2={lane.y - 13}
                  class="lane-rule"
                />
              )}
              <text x={PAD} y={lane.y + 14} class="lane-label">
                {wrapLabel(BODY_LABEL[lane.body], 12, 2).map((line, j) => (
                  <tspan x={PAD} dy={j === 0 ? 0 : 17}>
                    {line}
                  </tspan>
                ))}
              </text>
            </g>
          ))
        }
      </g>

      <g class="edges" aria-hidden="true">
        {
          spineEdges.map((e) => (
            <path
              class="spine-halo"
              d={e.d}
              pathLength="1"
              style={`--i: ${spineStep.get(key(e))}; --n: ${spine.length}`}
            />
          ))
        }
        {
          edges.map((e) => {
            const step = spineStep.get(key(e));
            const onSpine = step !== undefined;
            return (
              <path
                class:list={[
                  "edge",
                  `edge-${e.relation.type}`,
                  { symmetric: e.symmetric, spine: onSpine },
                ]}
                d={e.d}
                pathLength={onSpine ? "1" : undefined}
                style={onSpine ? `--i: ${step}; --n: ${spine.length}` : undefined}
                data-relation={key(e)}
                data-type={e.relation.type}
                data-from={e.relation.from}
                data-to={e.relation.to}
                marker-end={
                  e.symmetric
                    ? undefined
                    : `url(#arrow-${e.relation.type}${onSpine ? "-full" : ""})`
                }
              >
                <title>
                  {edgeTitle(e.relation.type, e.relation.from, e.relation.to, e.relation.note)}
                </title>
              </path>
            );
          })
        }
      </g>

      <g class="nodes">
        {
          nodes.map((n) => {
            const lines = wrapLabel(n.spec.name, 24, 2);
            const label = `${n.spec.name}, ${BODY_LABEL[n.spec.body]}, ${MATURITY_LABEL[n.spec.maturity]}`;
            const tag = MATURITY_TAG[n.spec.maturity];
            return (
              <a
                href={`/standards/${n.spec.id}/`}
                class:list={["node", `maturity-${n.spec.maturity}`]}
                data-spec={n.spec.id}
                data-body={n.spec.body}
                data-maturity={n.spec.maturity}
                aria-label={label}
              >
                <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="10" class="node-box" />
                <rect
                  x={n.x + 10}
                  y={n.y + 9}
                  width={chipWidth(tag)}
                  height="19"
                  rx="9.5"
                  class:list={[
                    "node-chip",
                    { draft: draft.has(n.spec.maturity) },
                  ]}
                />
                <text x={n.x + 18} y={n.y + 23} class="node-tag">
                  {tag}
                </text>
                <text x={n.x + 10} y={n.y + 46} class="node-name">
                  {lines.map((line, i) => (
                    <tspan x={n.x + 10} dy={i === 0 ? 0 : 16}>
                      {line}
                    </tspan>
                  ))}
                </text>
              </a>
            );
          })
        }
      </g>
    </svg>
  </div>
  <figcaption id="map-caption">
    Rows are publishing bodies. A specification sits one column right of what it builds on,
    profiles or replaces.{" "}
    {
      spineFirst && spineLast && (
        <>
          The bold teal line is the longest chain of documents that build on each other, from{" "}
          {spineFirst.name} to {spineLast.name}.{" "}
        </>
      )
    }
    Hover or focus a node to trace its relations. The <a href="#spec-list">list below</a> carries
    the same information as text.
  </figcaption>
</figure>

<section class="legend" aria-labelledby="legend-title">
  <h2 id="legend-title">Legend</h2>
  <div class="legend__cols">
    <dl class="panel legend__list" data-legend="relations">
      {
        usedTypes.map((t) => (
          <>
            <dt>
              <svg class="sample" width="44" height="10" viewBox="0 0 44 10" aria-hidden="true">
                <path d="M2,5 L40,5" class:list={["edge", `edge-${t}`]} />
              </svg>
              {RELATION_LABEL[t].forward}
            </dt>
            <dd>{RELATION_DESCRIPTION[t]}</dd>
          </>
        ))
      }
    </dl>
    <dl class="panel legend__list" data-legend="maturity">
      {
        usedMaturities.map((m) => (
          <>
            <dt>
              <MaturityTag maturity={m} />
            </dt>
            <dd>{MATURITY_LABEL[m]}. The publisher's status, not a grade.</dd>
          </>
        ))
      }
    </dl>
  </div>
  <p class="note">
    Each relation type has its own colour and its own dash pattern, so the map also reads without
    colour. Maturity is the word in the chip, and a dashed chip is a draft. Focusing a node shows
    its relations at full strength and fades the rest.
  </p>
</section>

<style>
  .map {
    margin: 0 0 var(--space-6);
  }
  .map-frame {
    padding: 0;
    overflow: auto;
    max-height: 80vh;
  }
  .map-frame:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }
  svg {
    display: block;
    font-family: var(--font-body);
  }
  figcaption {
    margin-top: var(--space-3);
    color: var(--ink-2);
    font-size: var(--small);
    max-width: var(--measure);
  }

  .lane-rule {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .lane-label {
    font-size: 13px;
    font-weight: 500;
    fill: var(--ink-2);
  }

  /*
   * Edges: each relation type has its own colour and its own dash pattern and weight, so the
   * types read with colour and still read without it (greyscale, colour blindness). Lines sit at
   * reduced strength; the spine and the neighbourhood of the node in focus get the full colour.
   */
  .edge,
  .arrow {
    --c: var(--ink-2);
  }
  .arrow {
    fill: color-mix(in oklch, var(--c) 62%, transparent);
  }
  .edge {
    --edge: color-mix(in oklch, var(--c) 62%, transparent);
    fill: none;
    stroke: var(--edge);
    stroke-width: 1.5;
    transition:
      opacity var(--dur-fast) var(--ease),
      stroke var(--dur-fast) var(--ease);
  }
  .edge-builds-on,
  .arrow-builds-on {
    --c: var(--signal);
  }
  .edge-profiles,
  .arrow-profiles {
    --c: var(--boundary);
  }
  .edge-profiles {
    stroke-dasharray: 7 4;
  }
  .edge-replaces {
    stroke-width: 3;
  }
  .edge-references {
    stroke-dasharray: 0.5 4.5;
    stroke-linecap: round;
    stroke-width: 2;
  }
  .edge-competes-with {
    --c: var(--threat);
    stroke-dasharray: 11 3 2 3;
  }
  .edge-solves-same-problem-as {
    --c: var(--caution);
    stroke-dasharray: 0.5 7;
    stroke-linecap: round;
    stroke-width: 4;
  }
  .arrow.full {
    fill: var(--c);
  }

  /* the builds-on spine: full colour, drawn in once on load from the oldest end (M4) */
  .edge.spine {
    --edge: var(--c);
    stroke-width: 2;
    stroke-dasharray: 1;
  }
  .spine-halo {
    fill: none;
    stroke: var(--signal-soft);
    stroke-width: 9;
    stroke-linecap: round;
    stroke-dasharray: 1;
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .edge.spine {
      animation: map-draw calc(var(--dur-draw) / var(--n)) linear
        calc(var(--dur-draw) / var(--n) * var(--i)) both;
    }
    .spine-halo {
      animation:
        map-draw calc(var(--dur-draw) / var(--n)) linear
          calc(var(--dur-draw) / var(--n) * var(--i)) both,
        map-halo calc(var(--dur-draw) + var(--dur-slow)) linear both;
    }
  }
  /* a negative offset reveals the path from its end, where the older document sits */
  @keyframes map-draw {
    from {
      stroke-dashoffset: -1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  /* the halo shows while the spine draws (1200 of 1680ms), then fades out */
  @keyframes map-halo {
    0%,
    100% {
      opacity: 0;
    }
    2%,
    71% {
      opacity: 1;
    }
  }

  .node {
    cursor: pointer;
    text-decoration: none;
  }
  .node-box {
    fill: var(--ground);
    stroke: var(--rule-strong);
    stroke-width: 1;
    transition: stroke var(--dur-fast) var(--ease);
  }
  .node:hover .node-box {
    stroke: var(--ink);
  }
  .node:focus-visible {
    outline: none;
  }
  .node:focus-visible .node-box {
    stroke: var(--signal);
    stroke-width: 2.5;
  }
  .node-name {
    font-size: 13px;
    font-weight: 600;
    fill: var(--ink);
  }
  /*
   * maturity as a chip, matching MaturityTag: the word says it, the colour sorts it at a glance
   * (published teal, in force blue, candidate amber), a dashed outline marks a draft
   */
  .node {
    --m: var(--ink-2);
  }
  .maturity-published {
    --m: var(--signal);
  }
  .maturity-in-force {
    --m: var(--boundary);
  }
  .maturity-candidate {
    --m: var(--caution);
  }
  .node-chip {
    fill: color-mix(in oklch, var(--m) 8%, transparent);
    stroke: color-mix(in oklch, var(--m) 45%, transparent);
    stroke-width: 1;
  }
  .node-chip.draft {
    stroke-dasharray: 3 2;
  }
  .node-tag {
    font-size: 13px;
    font-weight: 500;
    fill: var(--m);
  }
  .maturity-expired .node-name,
  .maturity-withdrawn .node-name,
  .maturity-expired .node-tag,
  .maturity-withdrawn .node-tag {
    text-decoration: line-through;
    fill: var(--ink-2);
  }

  /*
   * Filtering and the neighbourhood highlight, driven by the island. Hidden items keep their box
   * (visibility, not display) so the spine's one-time draw-in does not restart on a filter.
   */
  :global(#map .is-hidden) {
    visibility: hidden;
  }
  :global(#map .is-far) {
    opacity: 0.18;
  }
  :global(#map .edge.is-near) {
    --edge: var(--c);
    stroke-width: 2.5;
  }
  :global(#map .edge-builds-on.is-near) {
    marker-end: url(#arrow-builds-on-full);
  }
  :global(#map .edge-profiles.is-near) {
    marker-end: url(#arrow-profiles-full);
  }
  :global(#map .edge-replaces.is-near) {
    marker-end: url(#arrow-replaces-full);
  }
  :global(#map .edge-references.is-near) {
    marker-end: url(#arrow-references-full);
  }
  :global(#map .node.is-near .node-box) {
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .legend {
    margin: 0 0 var(--space-7);
  }
  .legend h2 {
    font-size: var(--h3);
  }
  .legend__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .legend__list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-3) var(--space-4);
    font-size: var(--small);
    margin: 0;
    align-content: start;
  }
  .legend__list dt {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 500;
  }
  .legend__list dd {
    margin: 0;
    color: var(--ink-2);
  }
  .sample {
    flex: none;
  }
  .sample .edge {
    --edge: var(--c);
  }
  @media (max-width: 40rem) {
    .legend__list {
      grid-template-columns: 1fr;
      gap: var(--space-1) 0;
    }
    .legend__list dd {
      margin-bottom: var(--space-3);
    }
  }
</style>
