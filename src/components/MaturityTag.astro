---
import { MATURITY_LABEL, MATURITY_TAG } from "@/lib/labels";
import type { SpecMaturity } from "@/schema";

interface Props {
  maturity: SpecMaturity;
  /** The publisher's own label, shown as the title. */
  note?: string;
  /** "tag" is the short form used in lists; "label" spells the maturity out. */
  variant?: "tag" | "label";
}

const { maturity, note, variant = "tag" } = Astro.props;
const label = MATURITY_LABEL[maturity];
const draft =
  maturity === "individual-draft" || maturity === "working-group-draft" || maturity === "candidate";
---

<span
  class:list={["chip", "maturity", `maturity-${maturity}`, variant, { signal: maturity === "published", draft }]}
  data-maturity={maturity}
  title={note ? `${label}: ${note}` : label}
>
  {variant === "label" ? label : MATURITY_TAG[maturity]}
</span>

<style>
  /*
   * Maturity is a chip that says the word (plan 016, 5.3). The colour sorts it at a glance and
   * the outline repeats it as a shape, dashed for a draft, so it reads without colour too.
   * The map's node chips match.
   */
  .maturity-in-force {
    --m: var(--boundary);
  }
  .maturity-candidate {
    --m: var(--caution);
  }
  .maturity-in-force,
  .maturity-candidate {
    border-color: color-mix(in oklch, var(--m) 45%, transparent);
    background: color-mix(in oklch, var(--m) 8%, transparent);
    color: var(--m);
  }
  .draft {
    border-style: dashed;
  }
  .maturity-individual-draft,
  .maturity-working-group-draft {
    border-color: var(--rule-strong);
  }
  .maturity-expired,
  .maturity-withdrawn {
    text-decoration: line-through;
  }
</style>
