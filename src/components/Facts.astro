---
/*
 * A row of headline numbers (`.facts`). The figures are in the HTML and stand still: a figure
 * that counts up from zero reads as decoration, and until it has counted it reads as the
 * wrong number. Each figure is tabular. An item with `of` reads "611 of 897".
 */
interface Props {
  label: string;
  items: { label: string; value: number; of?: number }[];
}

const { label, items } = Astro.props;
---

<dl class="facts" aria-label={label}>
  {
    items.map((item) => (
      <div>
        <dt>{item.label}</dt>
        <dd>
          <span class="facts__n">{item.value}</span>
          {item.of !== undefined && <span class="facts__of">of {item.of}</span>}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .facts__of {
    margin-inline-start: 0.3em;
    font-size: var(--small);
    font-weight: 400;
    color: var(--ink-2);
  }
</style>
