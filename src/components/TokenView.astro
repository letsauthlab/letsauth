---
import type { ResolvedToken } from "@/lib/explorer";
import type { TokenValue } from "@/schema";

interface Props {
  token: ResolvedToken;
}

const { token } = Astro.props;
const changeOf = (name: string) =>
  token.diff.added.includes(name)
    ? "added"
    : token.diff.changed.includes(name)
      ? "changed"
      : "same";
const isBlock = (v: TokenValue) => typeof v === "object" && !Array.isArray(v);
const show = (v: TokenValue) =>
  Array.isArray(v) ? v.join(", ") : typeof v === "object" ? JSON.stringify(v, null, 2) : String(v);
const marks = token.diff.added.length + token.diff.changed.length + token.diff.removed.length;
const headerLine = token.header
  ? Object.entries(token.header)
      .map(([k, v]) => `${k} ${String(v)}`)
      .join(" · ")
  : undefined;
---

<div class="token" data-token>
  <p class="token__name">
    {token.name}
    {headerLine && <span class="token__header">{headerLine}</span>}
  </p>
  <dl class="claims">
    {
      Object.entries(token.claims).map(([name, value]) => {
        const change = changeOf(name);
        return (
          <div data-claim={name} data-change={change} data-changed={change !== "same" ? "" : undefined}>
            <dt>
              {name}
              {change !== "same" && <span class:list={["mark", change]}>{change === "added" ? "Added" : "Changed"}</span>}
            </dt>
            <dd>{isBlock(value) ? <pre>{show(value)}</pre> : show(value)}</dd>
          </div>
        );
      })
    }
    {
      token.diff.removed.map((name) => (
        <div data-removed-claim={name} data-changed class="removed">
          <dt>
            <s>{name}</s>
            <span class="mark removed">Removed</span>
          </dt>
          <dd>no longer in the token</dd>
        </div>
      ))
    }
  </dl>
  <p class="token__foot">
    {marks === 0 ? "Unchanged since the previous token in this chain." : `${marks} claim${marks === 1 ? "" : "s"} differ from the previous token in this chain.`}
    {token.note && <span> {token.note}</span>}
  </p>
</div>

<style>
  /* the decoded token: claims as a key/value grid on the code ground; changed claims carry a rail */
  .token {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--code-bg);
    font-size: var(--small);
  }
  .token__name {
    margin: 0 0 var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
    color: var(--ink);
    font-weight: 500;
    max-width: none;
  }
  .token__header {
    font-family: var(--font-mono);
    font-size: var(--tiny);
    font-weight: 400;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .claims {
    margin: 0;
    display: grid;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: var(--tiny);
  }
  .claims > div {
    display: grid;
    grid-template-columns: minmax(6rem, 9rem) minmax(0, 1fr);
    gap: var(--space-3);
    padding: 0.2em 0.5em;
    border-left: 2px solid transparent;
    align-items: start;
  }
  /* M7: the island starts these rails in the signal and settles them here, timed to the message */
  .claims > div[data-changed] {
    border-left-color: var(--rule);
  }
  .claims > div.removed {
    color: var(--ink-2);
  }
  .claims dt {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    color: var(--ink-2);
  }
  .claims dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--ink);
  }
  .claims pre {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    white-space: pre-wrap;
    font: inherit;
  }
  .mark {
    font-family: var(--font-body);
    font-size: var(--tiny);
    font-weight: 500;
    color: var(--signal);
  }
  .mark.removed {
    color: var(--threat);
  }
  .token__foot {
    margin: var(--space-2) 0 0;
    color: var(--ink-2);
    font-size: var(--tiny);
    max-width: none;
  }

  @media (max-width: 40rem) {
    .token {
      padding: var(--space-3);
    }
    .claims > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
