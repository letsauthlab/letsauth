---
/*
 * The matrix in small (spec 019): the picture in the head of every page below the matrix that
 * shows where the page sits in it. Servers run down and requirements across, as in the matrix
 * itself, and the marks keep StatusCell's colours and its distinctions: an observed status is a
 * filled square, a recorded unknown a hollow one, a derived unknown (no observation) a faint dot,
 * not applicable a dash. A page lights its own row (`server`), its own column (`feature`) or a
 * set of cells (`cells`); the rest is drawn faint. Each status is one path, so the drawing costs
 * a few kilobytes however many servers are listed. Carries `view-transition-name: matrix`, so it
 * morphs into the matrix when the visitor opens it (plan 016, M2).
 */
import { cellKey, currentRevision, matrixFor } from "@/lib/atlas";
import { getDataset } from "@/lib/data";

interface Props {
  /** The revision whose matrix to draw; the current one by default. */
  revisionId?: string;
  /** Light this server's row. */
  server?: string;
  /** Light this requirement's column. */
  feature?: string;
  /** Light these cells, as `cellKey(server, feature)`. */
  cells?: Set<string>;
  /** What is lit, in words, for the accessible name. */
  label?: string;
}

const data = getDataset();
const revisionId = Astro.props.revisionId ?? currentRevision(data).id;
const { server, feature, cells, label } = Astro.props;
const matrix = matrixFor(data, revisionId);
const focused = Boolean(server || feature || cells);

const CELL = 5;
const STEP = 6;
const width = matrix.columns.length * STEP - 1;
const height = matrix.rows.length * STEP - 1;

type Mark = "s" | "p" | "x" | "u" | "d" | "n";
const marks: Mark[] = ["s", "p", "x", "u", "d", "n"];
const faint: Record<Mark, string> = { s: "", p: "", x: "", u: "", d: "", n: "" };
const lit: Record<Mark, string> = { s: "", p: "", x: "", u: "", d: "", n: "" };
const square = (x: number, y: number) => `M${x} ${y}h${CELL}v${CELL}h-${CELL}z`;
const shape: Record<Mark, (x: number, y: number) => string> = {
  s: square,
  p: square,
  x: square,
  u: (x, y) => `M${x + 0.5} ${y + 0.5}h${CELL - 1}v${CELL - 1}h-${CELL - 1}z`,
  d: (x, y) => `M${x + 1.75} ${y + 1.75}h1.5v1.5h-1.5z`,
  n: (x, y) => `M${x + 0.5} ${y + 2}h${CELL - 1}v1h-${CELL - 1}z`,
};
matrix.rows.forEach((s, y) => {
  matrix.columns.forEach((f, x) => {
    const key = cellKey(s.id, f.id);
    const cell = matrix.cells.get(key);
    const status = cell?.status ?? "unknown";
    const mark: Mark =
      status === "supported"
        ? "s"
        : status === "partial"
          ? "p"
          : status === "unsupported"
            ? "x"
            : status === "not-applicable"
              ? "n"
              : (cell?.derived ?? true)
                ? "d"
                : "u";
    const on = !focused || s.id === server || f.id === feature || (cells?.has(key) ?? false);
    (on ? lit : faint)[mark] += shape[mark](x * STEP, y * STEP);
  });
});
---

<svg
  class="matrix-thumb"
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  role="img"
  aria-label={`The matrix in small: ${matrix.rows.length} servers down, ${matrix.columns.length} requirements across${label ? `, with ${label} lit` : ""}.`}
>
  {
    focused && (
      <g class="faint">
        {marks.map((m) => faint[m] && <path class={m} d={faint[m]} />)}
      </g>
    )
  }
  {marks.map((m) => lit[m] && <path class={m} d={lit[m]} />)}
</svg>

<style>
  .matrix-thumb {
    display: block;
    width: 100%;
    height: auto;
    view-transition-name: matrix;
  }
  .faint {
    opacity: 0.2;
  }
  .s {
    fill: var(--ok);
  }
  .p {
    fill: var(--caution);
  }
  .x {
    fill: var(--threat);
  }
  .u {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1;
    stroke-dasharray: 1.5 1;
  }
  .d {
    fill: var(--ink-2);
    opacity: 0.5;
  }
  .n {
    fill: var(--rule-strong);
  }
  :global(::view-transition-group(matrix)) {
    animation-duration: var(--dur-slow);
    animation-timing-function: var(--ease);
  }
</style>
