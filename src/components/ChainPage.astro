---
import Citation from "@/components/Citation.astro";
import Crumbs from "@/components/Crumbs.astro";
import Explorer from "@/components/Explorer.svelte";
import TokenView from "@/components/TokenView.astro";
import Base from "@/layouts/Base.astro";
import { getDataset } from "@/lib/data";
import { featureSupport, resolveChain } from "@/lib/explorer";
import { ACTOR_KIND_LABEL, PARTY_LABEL, TOGGLE_KIND_LABEL } from "@/lib/labels";
import type { Scenario } from "@/schema";

interface Props {
  scenario: Scenario;
  toggleId?: string;
}

const { scenario, toggleId } = Astro.props;
const data = getDataset();
const chain = resolveChain(scenario, toggleId);
const toggle = chain.toggle;
const path = toggle ? `/explorer/${scenario.id}/${toggle.id}/` : `/explorer/${scenario.id}/`;
const lanes = scenario.actors.length;
const laneOf = new Map(scenario.actors.map((a, i) => [a.id, i]));
const actorById = new Map(scenario.actors.map((a) => [a.id, a]));
const featureById = new Map(data.features.map((f) => [f.id, f]));
const exercised = scenario.features.flatMap((id) => {
  const f = featureById.get(id);
  return f ? [f] : [];
});
const violated = (toggle?.violates ?? []).map((id) => featureSupport(data, id));
const repo = "https://github.com/letsauthlab/letsauth";
const title = toggle ? `${scenario.title} · ${toggle.name}` : scenario.title;
const description = toggle
  ? `${scenario.title}, with ${toggle.name.toLowerCase()} (${TOGGLE_KIND_LABEL[toggle.kind].toLowerCase()}) turned on: ${toggle.summary.trim()}`
  : scenario.summary.trim();
const removedCount = chain.steps.filter((s) => s.removed).length;
const toggledCount = chain.steps.filter((s) => s.toggled && !s.removed).length;
// M8: the steps the toggle touched, in order, so their rails light up one after another
const touched = new Map(chain.steps.filter((s) => s.toggled).map((s, i) => [s.id, i]));

// the arrow of a step: which lane it starts in, how many lanes it spans, and its direction
function arrow(from: string, to: string) {
  const a = laneOf.get(from) ?? 0;
  const b = laneOf.get(to) ?? 0;
  return {
    start: Math.min(a, b),
    span: Math.abs(b - a),
    dir: a === b ? "self" : b > a ? "right" : "left",
    // a self arrow in the last lane loops to the left so it stays inside the chain
    end: a === b && a === lanes - 1,
  };
}
---

<Base title={title} description={description} path={path}>
  <div class="wrap">
    <Crumbs
      trail={
        toggle
          ? [
              { href: "/explorer/", label: "Delegation chain explorer" },
              { href: `/explorer/${scenario.id}/`, label: scenario.title },
            ]
          : [{ href: "/explorer/", label: "Delegation chain explorer" }]
      }
      current={toggle ? toggle.name : scenario.title}
    />
    <header class="page-head">
      <p class="eyebrow">Delegation chain explorer</p>
      <h1 style={`view-transition-name: scenario-${scenario.id}`}>{scenario.title}</h1>
      <p class="lede">{scenario.summary}</p>
    </header>

    <nav class="toggles" aria-label="Toggles">
      <a class:list={["toggle", { current: !toggle }]} href={`/explorer/${scenario.id}/`} aria-current={!toggle ? "page" : undefined}>
        Baseline
      </a>
      {
        scenario.toggles.map((t) => (
          <a
            class:list={["toggle", `kind-${t.kind}`, { current: toggle?.id === t.id }]}
            href={`/explorer/${scenario.id}/${t.id}/`}
            aria-current={toggle?.id === t.id ? "page" : undefined}
            data-toggle={t.id}
            title={TOGGLE_KIND_LABEL[t.kind]}
          >
            <span class="toggle__dot" aria-hidden="true" />
            {t.name}
          </a>
        ))
      }
    </nav>

    {
      toggle && (
        <section
          class:list={["notice", `kind-${toggle.kind}`, { caution: toggle.kind === "misconfiguration" }]}
          data-toggle-notice
          aria-labelledby="toggle-title"
        >
          <p class="notice__kind">{TOGGLE_KIND_LABEL[toggle.kind]}</p>
          <h2 id="toggle-title">{toggle.name}</h2>
          <p>{toggle.summary}</p>
          <p class="notice__meta">
            {toggledCount > 0 && <span>{toggledCount} step{toggledCount === 1 ? "" : "s"} changed</span>}
            {removedCount > 0 && <span>{removedCount} step{removedCount === 1 ? "" : "s"} removed</span>}
            <span>
              Against <Citation entry={toggle.cites} withRevision />
            </span>
          </p>
          {violated.length > 0 && (
            <ul class="violates" role="list" aria-label="Requirements this defeats">
              {violated.map((v) => (
                <li data-violates={v.feature.id}>
                  <span class="violates__name">
                    Defeats <a href={`/mcp/features/${v.feature.id}/`}>{v.feature.name}</a>
                    <span class="party">{PARTY_LABEL[v.feature.party]}</span>
                  </span>
                  <span class="violates__counts">
                    {v.observed
                      ? `Listed servers under MCP Authorization ${v.revisionId}: ${v.counts.supported} supported, ${v.counts.partial} partial, ${v.counts.unsupported} unsupported, ${v.counts.unknown} unknown${v.counts.notApplicable > 0 ? `, ${v.counts.notApplicable} not applicable` : ""}.`
                      : `${v.reason[0]?.toUpperCase()}${v.reason.slice(1)}.`}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    <Explorer client:idle />

    <section
      class:list={["chain", "plate", toggle && `kind-${toggle.kind}`]}
      id="chain"
      aria-labelledby="chain-title"
      style={`--lanes: ${lanes}`}
    >
      <h2 id="chain-title" class="visually-hidden">The chain, step by step</h2>
      <div class="chain__head">
        <div class="chain__actors" role="list" aria-label="Actors">
          {
            scenario.actors.map((a) => (
              <div class="actor" role="listitem" data-actor={a.id}>
                <span class="actor__name">{a.name}</span>
                <span class="actor__kind">{ACTOR_KIND_LABEL[a.kind]}</span>
              </div>
            ))
          }
        </div>
        <div class="chain__controls" id="chain-controls"></div>
      </div>
      <ol id="chain-steps" class="chain__steps" role="list" data-steps={chain.steps.length}>
        {
          chain.steps.map((s) => {
            const from = actorById.get(s.from);
            const to = actorById.get(s.to);
            const { start, span, dir, end } = arrow(s.from, s.to);
            const order = touched.get(s.id);
            return (
              <li
                id={`step-${s.id}`}
                class:list={["step", { "is-toggled": s.toggled && !s.removed, "is-removed": s.removed }]}
                data-step={s.id}
                data-index={s.index}
                data-toggled={s.toggled && !s.removed ? "" : undefined}
                data-removed={s.removed ? "" : undefined}
                data-replaces={s.replaces}
                style={order !== undefined ? `--touched: ${order}` : undefined}
              >
                <div class="step__lanes" aria-hidden="true">
                  {scenario.actors.map(() => (
                    <span class="lane" />
                  ))}
                  <span
                    class:list={["arrow", `arrow-${dir}`, { "arrow-end": end }]}
                    style={`--start: ${start}; --span: ${span}`}
                  >
                    <span class="arrow__line" />
                    <span class="arrow__num">{s.index}</span>
                  </span>
                </div>
                <div class="step__body">
                  <p class="step__who">
                    <span class="visually-hidden">Step {s.index}: </span>
                    {from?.name}
                    <span aria-hidden="true"> → </span>
                    <span class="visually-hidden"> to </span>
                    {s.from === s.to ? "itself" : to?.name}
                    {s.toggled && !s.removed && (
                      <span class="chip tag">{s.replaces ? `Replaces "${s.replaces}"` : "Changed by the toggle"}</span>
                    )}
                    {s.removed && <span class="chip tag">Removed by the toggle</span>}
                  </p>
                  <p class="step__message">{s.removed ? <s>{s.message}</s> : s.message}</p>
                  {s.note && <p class="step__note">{s.note}</p>}
                  <p class="step__cite">
                    <Citation entry={s.cites} withRevision />
                  </p>
                  {s.token && !s.removed && <TokenView token={s.token} />}
                </div>
              </li>
            );
          })
        }
      </ol>
    </section>

    <section id="requirements" class="requirements" aria-labelledby="requirements-title">
      <h2 id="requirements-title">Requirements this chain exercises</h2>
      <ul role="list" class="requirements__list">
        {
          exercised.map((f) => (
            <li data-feature={f.id}>
              <a href={`/mcp/features/${f.id}/`}>{f.name}</a>
              <span class="party">{PARTY_LABEL[f.party]}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="page-foot">
      <p class="page-foot__links">
        <a href="/explorer/data.json">All scenarios as JSON</a>
        <a href={`${repo}/blob/main/data/scenarios/${scenario.id}.yaml`} rel="noopener">Data file</a>
        <a href={`${repo}/edit/main/data/scenarios/${scenario.id}.yaml`} rel="noopener">Propose a change</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  /* toggle kinds: attack in the threat ink, misconfiguration in the caution ink (plan 3.2) */
  .kind-attack {
    --kind: var(--toggle-attack);
  }
  .kind-misconfiguration {
    --kind: var(--toggle-misconfiguration);
  }

  /* toggles: one row of links, the current one outlined in ink */
  .toggles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    max-width: 100%;
    padding: 0.35em 0.85em;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--small);
    line-height: 1.4;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .toggle:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }
  .toggle.current {
    color: var(--ink);
    border-color: var(--ink);
    font-weight: 500;
  }
  .toggle__dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--kind);
  }

  /* the global notice's oklab tint, in the toggle kind's colour */
  .notice {
    margin-bottom: var(--space-5);
    background: color-mix(in oklab, var(--kind) 12%, var(--ground));
  }
  .notice__kind {
    margin: 0 0 var(--space-1);
    font-size: var(--tiny);
    font-weight: 600;
    color: var(--kind);
  }
  .notice h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--h3);
  }
  .notice p {
    margin: 0 0 var(--space-2);
  }
  .notice__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-size: var(--small);
    color: var(--ink-2);
    max-width: none;
  }
  .violates {
    margin: var(--space-3) 0 0;
    padding: var(--space-3) 0 0;
    border-top: 1px solid color-mix(in oklch, var(--kind) 30%, transparent);
    display: grid;
    gap: var(--space-2);
    font-size: var(--small);
  }
  .violates li {
    display: grid;
    gap: 2px;
  }
  .violates__counts {
    color: var(--ink-2);
  }
  .party,
  .actor__kind {
    font-size: var(--tiny);
    color: var(--ink-2);
  }
  .party {
    margin-left: var(--space-2);
  }

  /*
   * The chain: lanes on the left carry the lifelines and arrows, the body on the right the text.
   * The frame is a .plate; the head stays in view while the steps scroll under it, so the plate
   * clips instead of hiding its overflow (hidden would make it the sticky head's scroller).
   */
  .chain {
    --lanes-w: minmax(0, 5fr);
    --body-w: minmax(0, 6fr);
    --row-top: 1.15rem;
    padding: 0;
    overflow: clip;
  }
  .chain__head {
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    display: grid;
    grid-template-columns: var(--lanes-w) var(--body-w);
    background: var(--ground-2);
    border-bottom: 1px solid var(--rule);
  }
  .chain__actors {
    display: grid;
    grid-template-columns: repeat(var(--lanes), minmax(0, 1fr));
  }
  .actor {
    display: grid;
    gap: 2px;
    justify-items: center;
    align-content: start;
    text-align: center;
    padding: var(--space-3) var(--space-1);
    min-width: 0;
  }
  .actor__name {
    font-size: var(--small);
    font-weight: 500;
    color: var(--ink);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .chain__controls {
    display: flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    min-width: 0;
  }
  .chain__controls:empty {
    display: none;
  }
  .chain__steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    display: grid;
    grid-template-columns: var(--lanes-w) var(--body-w);
    border-top: 1px solid var(--rule);
    border-left: 2px solid transparent;
    scroll-margin-top: calc(var(--header-h) + 5rem);
    transition: opacity var(--dur) var(--ease);
  }
  .step:first-child {
    border-top: 0;
  }
  .step__lanes {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--lanes), minmax(0, 1fr));
    color: var(--ink-2);
    cursor: pointer;
  }
  .lane {
    position: relative;
  }
  .lane::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 50%;
    border-left: 1px solid var(--rule);
  }

  /* the arrow sits at the row's top, between the centres of the lanes it joins */
  .arrow {
    --weight: 1.5px;
    position: absolute;
    top: var(--row-top);
    left: calc((var(--start) + 0.5) * 100% / var(--lanes));
    width: calc(var(--span) * 100% / var(--lanes));
    height: var(--weight);
    color: inherit;
  }
  .arrow__line {
    position: absolute;
    inset: 0;
    background: currentColor;
  }
  .arrow-right .arrow__line {
    transform-origin: left center;
  }
  .arrow-left .arrow__line {
    transform-origin: right center;
  }
  .arrow::after {
    content: "";
    position: absolute;
    top: 50%;
    border: 5px solid transparent;
    transform: translateY(-50%);
  }
  .arrow-right::after {
    right: -2px;
    border-left: 7px solid currentColor;
    border-right: 0;
  }
  .arrow-left::after {
    left: -2px;
    border-right: 7px solid currentColor;
    border-left: 0;
  }
  .arrow-self {
    width: 1.5rem;
    height: 1rem;
    border: var(--weight) solid currentColor;
    border-left: 0;
    border-radius: 0 6px 6px 0;
  }
  .arrow-self .arrow__line {
    display: none;
  }
  .arrow-self::after {
    top: auto;
    bottom: -6px;
    left: -3px;
    transform: none;
    border-right: 7px solid currentColor;
    border-left: 0;
  }
  .arrow-self.arrow-end {
    transform: translateX(-100%);
    border-left: var(--weight) solid currentColor;
    border-right: 0;
    border-radius: 6px 0 0 6px;
  }
  .arrow-self.arrow-end::after {
    left: auto;
    right: -3px;
    border-left: 7px solid currentColor;
    border-right: 0;
  }
  .arrow__num {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.3em;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    background: var(--ground-2);
    color: var(--ink-2);
    font-size: var(--tiny);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .arrow-self .arrow__num {
    left: auto;
    right: -0.75rem;
    transform: translate(100%, -50%);
  }
  .arrow-self.arrow-end .arrow__num {
    right: auto;
    left: -0.75rem;
    transform: translate(-100%, -50%);
  }

  .step__body {
    padding: var(--space-3) var(--space-4) var(--space-4);
    min-width: 0;
    border-left: 2px solid var(--rule);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .step__who {
    margin: 0 0 var(--space-1);
    font-size: var(--tiny);
    color: var(--ink-2);
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    line-height: 1.3;
  }
  .tag {
    white-space: normal;
    border-color: color-mix(in oklch, var(--kind) 45%, transparent);
    background: color-mix(in oklch, var(--kind) 8%, transparent);
    color: var(--kind);
  }
  .step__message {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--small);
    color: var(--ink);
    overflow-wrap: anywhere;
    max-width: none;
    line-height: 1.5;
  }
  .step__note {
    margin: 0 0 var(--space-2);
    color: var(--ink-2);
    font-size: var(--small);
  }
  .step__cite {
    margin: 0;
    font-size: var(--tiny);
    color: var(--ink-2);
  }

  /* toggled rows carry a rail and an arrow in the toggle's ink; removed rows are struck and dashed */
  .step:is([data-toggled], [data-removed]) {
    border-left-color: var(--kind);
  }
  .is-toggled .step__lanes {
    color: var(--kind);
  }
  .is-removed .step__lanes {
    color: var(--rule-strong);
  }
  .is-removed .arrow__line {
    background: none;
    border-top: var(--weight) dashed currentColor;
  }
  .is-removed .arrow-self {
    border-style: dashed;
  }
  .is-removed .step__message,
  .is-removed .step__note {
    color: var(--ink-2);
  }

  /* step-through, driven by the island: the current step in the signal, later ones dimmed */
  .step[aria-current="step"] .step__lanes {
    color: var(--signal);
  }
  .step[aria-current="step"] .arrow {
    --weight: 2px;
  }
  .step[aria-current="step"] .arrow__num {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--on-signal);
  }
  .step[aria-current="step"] .step__body {
    border-left-color: var(--signal);
  }
  .step.is-future {
    opacity: 0.45;
  }

  /*
   * M5: once the reader steps, the current arrow draws in (300ms) and its body rises 8px
   * (220ms). M8: on a toggle page the rails of the touched steps light up once, 40ms apart and
   * no later than 400ms. Neither runs under reduced motion; both end where the static page is.
   */
  @media (prefers-reduced-motion: no-preference) {
    .chain__steps[data-stepping] .step[aria-current="step"] .arrow__line {
      animation: draw-x 300ms var(--ease-draw) both;
    }
    .chain__steps[data-stepping] .step[aria-current="step"] .arrow::after,
    .chain__steps[data-stepping] .step[aria-current="step"] .arrow-self {
      animation: fade-in 300ms var(--ease) both;
    }
    .chain__steps[data-stepping] .step[aria-current="step"] .step__body > * {
      animation: rise var(--dur) var(--ease) both;
    }
    .step:is([data-toggled], [data-removed]) {
      animation: rail-in var(--dur-slow) var(--ease) both;
      animation-delay: min(calc(var(--touched, 0) * 40ms), 400ms);
    }
  }
  @keyframes draw-x {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes rail-in {
    from {
      border-left-color: transparent;
    }
  }

  .requirements {
    margin-top: var(--space-7);
  }
  .requirements h2 {
    font-size: var(--h3);
    margin-bottom: var(--space-3);
  }
  .requirements__list {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-1) var(--space-4);
    font-size: var(--small);
  }

  @media (max-width: 56rem) {
    .chain {
      --lanes-w: minmax(0, 1fr);
      --body-w: minmax(0, 1fr);
    }
  }
  @media (max-width: 40rem) {
    .chain__head,
    .step {
      grid-template-columns: minmax(0, 1fr);
    }
    .chain__head {
      top: 0;
    }
    .chain__controls {
      border-top: 1px solid var(--rule);
      padding: var(--space-2);
    }
    .step__lanes {
      height: 2.6rem;
    }
    .step__body {
      border-left-color: transparent;
      padding: 0 var(--space-3) var(--space-4);
    }
    .actor {
      padding: var(--space-2) 2px;
    }
    .actor__name {
      font-size: var(--tiny);
    }
    .actor__kind {
      display: none;
    }
    .step {
      scroll-margin-top: 7rem;
    }
  }
</style>
