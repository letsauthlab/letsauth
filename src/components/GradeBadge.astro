---
import type { Grade } from "@/scanner/grade";

interface Props {
  grade: Grade;
  /** "small" for table cells; "label" adds the word "Grade"; "cell" is the letter box alone. */
  variant?: "small" | "label" | "cell";
}

const { grade, variant = "small" } = Astro.props;
const word = grade.letter ? `Grade ${grade.letter}` : grade.label;
const title = grade.reasons.length > 0 ? grade.reasons.join(" ") : word;
---

<span
  class:list={["badge", `badge-${grade.letter ?? "none"}`, variant]}
  data-grade={grade.letter ?? grade.label}
  title={title}
>
  <span class="letter" aria-hidden="true">{grade.letter ?? "–"}</span>
  <span class="word">{variant === "label" ? word : grade.letter ?? grade.label}</span>
</span>

<style>
  /*
   * A letter in a 1px outline, coloured by grade with the status inks: A and B the supported
   * ink, C the partial one, F the unsupported one, a withheld grade a dashed unknown. No fill.
   * The letter never stands alone: the word beside it carries the meaning for every reader.
   */
  .badge {
    --c: var(--status-unknown);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--small);
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }
  .letter {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-focus);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
    color: var(--c);
    border: 1px solid var(--c);
  }
  .badge-none .letter {
    border-style: dashed;
  }
  .badge-none .word {
    color: var(--ink-2);
  }
  .badge.small .word,
  .badge.cell .word {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .badge.cell .letter {
    width: 1.5rem;
    height: 1.5rem;
    font-size: var(--small);
  }
  .badge.small.badge-none .word {
    position: static;
    width: auto;
    height: auto;
    clip: auto;
    font-size: var(--tiny);
  }
  .badge-A,
  .badge-B {
    --c: var(--status-supported);
  }
  .badge-C {
    --c: var(--status-partial);
  }
  .badge-F {
    --c: var(--status-unsupported);
  }
</style>
