---
/*
 * The home page's picture (spec 019): an abstract field of cells in the status colours, with a
 * slow diagonal wave of light passing over it, like a scan crossing the matrix. It is decoration
 * (aria-hidden), but not invented: the share of each colour is the share of each status in the
 * current matrix, laid out in a fixed shuffle so the picture is the same on every build of the
 * same data. Pure CSS motion on opacity; under reduced motion the field stands still.
 */
import { cellKey, currentRevision, matrixFor } from "@/lib/atlas";
import { getDataset } from "@/lib/data";

const COLS = 12;
const ROWS = 9;
const CELL = 10;
const STEP = 14;

type Mark = "s" | "p" | "x" | "u" | "n";
const data = getDataset();
const matrix = matrixFor(data, currentRevision(data).id);
const counts: Record<Mark, number> = { s: 0, p: 0, x: 0, u: 0, n: 0 };
for (const server of matrix.rows) {
  for (const feature of matrix.columns) {
    const status = matrix.cells.get(cellKey(server.id, feature.id))?.status ?? "unknown";
    const mark: Mark =
      status === "supported"
        ? "s"
        : status === "partial"
          ? "p"
          : status === "unsupported"
            ? "x"
            : status === "not-applicable"
              ? "n"
              : "u";
    counts[mark] += 1;
  }
}
const total = Object.values(counts).reduce((a, b) => a + b, 0) || 1;
const size = COLS * ROWS;
const marks: Mark[] = [];
for (const m of ["s", "p", "x", "n", "u"] as Mark[]) {
  const n = m === "u" ? size - marks.length : Math.round((counts[m] / total) * size);
  for (let i = 0; i < n && marks.length < size; i += 1) marks.push(m);
}
// a fixed shuffle (a small linear congruential generator), so every build draws the same field
let seed = 20260728;
const next = () => {
  seed = (seed * 1103515245 + 12345) % 2147483648;
  return seed / 2147483648;
};
for (let i = marks.length - 1; i > 0; i -= 1) {
  const j = Math.floor(next() * (i + 1));
  [marks[i], marks[j]] = [marks[j] as Mark, marks[i] as Mark];
}
const width = COLS * STEP - (STEP - CELL);
const height = ROWS * STEP - (STEP - CELL);
---

<svg
  class="matrix-pulse"
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  aria-hidden="true"
  focusable="false"
>
  {
    marks.map((m, i) => {
      const x = (i % COLS) * STEP;
      const y = Math.floor(i / COLS) * STEP;
      return (
        <rect
          class={m}
          x={m === "u" ? x + 0.75 : x}
          y={m === "u" ? y + 0.75 : y}
          width={m === "u" ? CELL - 1.5 : CELL}
          height={m === "u" ? CELL - 1.5 : CELL}
          rx="2"
          style={`--d:${((i % COLS) + Math.floor(i / COLS)) * -140}ms`}
        />
      );
    })
  }
</svg>

<style>
  .matrix-pulse {
    display: block;
    width: 100%;
    height: auto;
  }
  rect {
    opacity: 0.35;
    animation: pulse-wave 5.6s var(--ease) infinite;
    animation-delay: var(--d);
  }
  .s {
    fill: var(--ok);
  }
  .p {
    fill: var(--caution);
  }
  .x {
    fill: var(--threat);
  }
  .n {
    fill: var(--rule-strong);
  }
  .u {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1;
    stroke-dasharray: 2 1.5;
  }
  @keyframes pulse-wave {
    0%,
    100% {
      opacity: 0.3;
    }
    18% {
      opacity: 1;
    }
    40% {
      opacity: 0.3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    rect {
      animation: none;
      opacity: 0.8;
    }
  }
</style>
