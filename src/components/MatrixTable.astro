---
import { cellKey, featureInRevision, type Matrix, type RevisionDiff } from "@/lib/atlas";
import { ACCESS_LABEL, AUTH_LABEL, accessOf, authOf } from "@/lib/classes";
import { CATEGORY_LABEL, PARTY_LABEL, PARTY_SHORT } from "@/lib/labels";
import type { ScanView } from "@/lib/scanner";
import GradeBadge from "./GradeBadge.astro";
import ObservationDetail from "./ObservationDetail.astro";
import StatusCell from "./StatusCell.astro";

interface Props {
  matrix: Matrix;
  /** Diff against the previous revision, used to badge columns whose level changed. */
  diff?: RevisionDiff;
  /**
   * The nightly scanner's latest view per server id. Its grade sits next to the server's name
   * and links to the report; it is derived from the cells by a published rule and is never a
   * sort key.
   */
  scans?: Map<string, ScanView>;
}

const { matrix, diff, scans } = Astro.props;
const { columns, rows, cells, revision } = matrix;

// group columns by category for the top header row
const groups: { category: string; count: number }[] = [];
for (const f of columns) {
  const last = groups[groups.length - 1];
  if (last && last.category === f.category) last.count += 1;
  else groups.push({ category: f.category, count: 1 });
}

const changedIds = new Map(diff?.changed.map((c) => [c.feature.id, c]) ?? []);
const addedIds = new Set(diff?.added.map((f) => f.id) ?? []);
const changesHref = diff ? `/mcp/changes/${diff.from.id}/${diff.to.id}/` : undefined;
const shortLabel = (id: string) => id.split(".").slice(2).join(".") || id;
---

<div class="matrix-scroll" tabindex="0" role="region" aria-label="Support matrix, scrolls horizontally">
  <table class="matrix" id="matrix" data-matrix-revision={revision.id}>
    <caption class="visually-hidden">
      Support for each feature of MCP Authorization {revision.id} by server. Rows are servers in
      alphabetical order; columns are features grouped by category.
    </caption>
    <thead>
      <tr class="groups">
        <td></td>
        {
          groups.map((g) => (
            <th scope="colgroup" colspan={g.count} data-category={g.category}>
              <span>{CATEGORY_LABEL[g.category as keyof typeof CATEGORY_LABEL] ?? g.category}</span>
            </th>
          ))
        }
      </tr>
      <tr class="features">
        <th scope="col" class="server-head">
          <span class="server-head__label">Server</span>
          <span class="server-head__hint">
            {rows.length} listed, A to Z
            {scans && (
              <>
                {" · "}
                <a href="/mcp/scanner/">nightly scan grade</a>
              </>
            )}
          </span>
        </th>
        {
          columns.map((f) => {
            const entry = featureInRevision(f, revision.id);
            const level = entry?.level ?? "MUST";
            const changed = changedIds.get(f.id);
            const added = addedIds.has(f.id);
            return (
              <th
                scope="col"
                data-feature={f.id}
                data-level={level}
                data-category={f.category}
                data-party={f.party}
                title={`${f.name} — ${PARTY_LABEL[f.party]} — ${level}`}
              >
                <div class="feature-head">
                  <span class="feature-marks">
                    {changed && changesHref && (
                      <a
                        class="changed"
                        href={changesHref}
                        title={`Level changed from ${changed.from} to ${changed.to} in ${revision.id}`}
                      >
                        <span class="visually-hidden">Level changed in {revision.id}</span>
                      </a>
                    )}
                    {added && changesHref && (
                      <a class="changed new" href={changesHref} title={`New in ${revision.id}`}>
                        <span class="visually-hidden">New in {revision.id}</span>
                      </a>
                    )}
                  </span>
                  <a class="feature-link" href={`/mcp/features/${f.id}/`}>
                    <span class="feature-short">{shortLabel(f.id)}</span>
                    <span class="visually-hidden">{f.name}</span>
                  </a>
                  <span class="feature-tags">
                    <span class:list={["level", `level-${level}`]} aria-label={`Level ${level}`}>
                      {level}
                    </span>
                    <span class="party" title={PARTY_LABEL[f.party]}>
                      <span aria-hidden="true">{PARTY_SHORT[f.party]}</span>
                      <span class="visually-hidden">{PARTY_LABEL[f.party]}</span>
                    </span>
                  </span>
                </div>
              </th>
            );
          })
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((server) => {
          const access = accessOf(server);
          const auth = authOf(server);
          return (
          <tr
            data-server={server.id}
            data-name={server.name.toLowerCase()}
            data-access={access.value}
            data-auth={auth.value}
          >
            <th scope="row" class="server-cell">
              <span class="server-cell__row">
                <a class="server-link" href={`/mcp/servers/${server.id}/`}>{server.name}</a>
                {(() => {
                  const scan = scans?.get(server.id);
                  if (!scan) return null;
                  const word = scan.grade.letter ? `grade ${scan.grade.letter}` : scan.grade.label.toLowerCase();
                  return (
                    <a
                      class="grade-link"
                      href={`/mcp/servers/${server.id}/scan/`}
                      data-grade={scan.grade.letter ?? scan.grade.label}
                      aria-label={`${server.name}, nightly scan: ${word}. Open the report`}
                    >
                      <GradeBadge grade={scan.grade} variant="cell" />
                    </a>
                  );
                })()}
              </span>
              <span class="classes">
                <span
                  class:list={["class", `class-access-${access.value}`, { derived: access.derived }]}
                  title={`Access: ${ACCESS_LABEL[access.value]}${access.derived ? " (not yet stated)" : ""}`}
                >
                  <span class="visually-hidden">Access: </span>
                  {ACCESS_LABEL[access.value].toLowerCase()}
                </span>
                <span
                  class:list={["class", `class-auth-${auth.value}`, { derived: auth.derived }]}
                  title={`Auth: ${AUTH_LABEL[auth.value]}${auth.derived ? " (not yet stated)" : ""}`}
                >
                  <span class="visually-hidden">Auth: </span>
                  {AUTH_LABEL[auth.value].toLowerCase()}
                </span>
              </span>
            </th>
            {columns.map((feature) => {
              const cell = cells.get(cellKey(server.id, feature.id));
              if (!cell) throw new Error(`missing cell ${server.id}/${feature.id}`);
              return (
                <td
                  data-server={server.id}
                  data-feature={feature.id}
                  data-status={cell.status}
                  data-derived={cell.derived ? "true" : "false"}
                >
                  <details class="cell">
                    <summary aria-label={`${server.name}, ${feature.name}: ${cell.status}`}>
                      <StatusCell status={cell.status} derived={cell.derived} />
                    </summary>
                    <ObservationDetail cell={cell} server={server} feature={feature} />
                  </details>
                </td>
              );
            })}
          </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  .matrix-scroll {
    /* positioned so visually-hidden (absolute) labels inside the table stay inside the clip */
    position: relative;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow), var(--inset-highlight);
  }
  .matrix-scroll:focus-visible {
    outline-offset: 4px;
  }
  .matrix {
    border-collapse: separate;
    border-spacing: 0;
    margin: 0;
    width: max-content;
    min-width: 100%;
    font-variant-numeric: tabular-nums;
  }
  .matrix th,
  .matrix td {
    border-bottom: 1px solid var(--line-soft);
    padding: var(--space-2) var(--space-1);
    text-align: center;
    vertical-align: middle;
  }
  .matrix tbody tr:last-child > * {
    border-bottom: 0;
  }

  /* category groups */
  .groups th {
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-size: var(--text-2xs);
    font-weight: 500;
    color: var(--ink-muted);
    background: var(--bg-sunken);
    padding: var(--space-2) var(--space-2);
    border-left: 1px solid var(--line);
  }
  .groups th span {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .groups td {
    background: var(--bg-sunken);
    position: sticky;
    left: 0;
    z-index: 3;
    border-right: 1px solid var(--line);
  }

  /* feature columns: a narrow column with its id written upwards */
  .features th[data-feature] {
    width: 3rem;
    min-width: 3rem;
    max-width: 3rem;
    padding: var(--space-3) 0 var(--space-2);
    vertical-align: bottom;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink);
  }
  .features .server-head + th {
    border-left: 1px solid var(--line);
  }
  .feature-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .feature-link {
    display: block;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    height: 10rem;
    padding-inline: 0.4rem;
    text-decoration: none;
    color: var(--ink);
    border-radius: var(--radius-sm);
  }
  .feature-short {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-height: 100%;
    padding: 0.1rem 0;
  }
  .feature-link:hover .feature-short {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .feature-marks {
    display: flex;
    justify-content: center;
    min-height: 0;
  }
  .feature-tags {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }
  .feature-tags .level {
    font-size: 0.56rem;
    padding: 0.25em 0.35em;
  }
  .party {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }
  .changed {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    text-decoration: none;
    --dot: var(--accent-2);
    --halo: var(--accent-2-soft);
  }
  .changed::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: 0 0 0 3px var(--halo);
    transition: transform var(--dur-fast) var(--ease);
  }
  .changed.new {
    --dot: var(--accent);
    --halo: var(--accent-soft);
  }
  .changed:hover::before {
    transform: scale(1.3);
  }

  /* the sticky server column */
  .server-head,
  .server-cell {
    position: sticky;
    left: 0;
    z-index: 2;
    background: var(--bg-elevated);
    text-align: left;
    border-right: 1px solid var(--line);
    min-width: 12rem;
    padding-inline: var(--space-4);
  }
  .server-head {
    vertical-align: bottom;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink);
  }
  .server-head__label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
  }
  .server-head__hint {
    display: block;
    font-size: var(--text-2xs);
    color: var(--ink-faint);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    margin-top: 0.15rem;
  }
  .server-cell {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
    font-size: var(--text-sm);
    line-height: 1.2;
  }
  .server-cell__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .server-link {
    color: var(--ink);
    text-decoration: none;
  }
  .server-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .grade-link {
    display: inline-flex;
    flex: none;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .grade-link:hover {
    transform: scale(1.08);
  }
  .server-head__hint a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .classes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.3rem;
  }
  .class {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.6rem;
    line-height: 1;
    letter-spacing: 0.02em;
    padding: 0.2rem 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-muted);
    background: var(--bg-sunken);
  }
  .class.derived {
    border-style: dashed;
    background: transparent;
    color: var(--ink-faint);
  }
  .class-access-closed {
    border-color: color-mix(in oklch, var(--accent-2) 55%, var(--line));
    color: var(--ink);
  }
  .class-auth-oauth {
    border-color: color-mix(in oklch, var(--accent) 55%, var(--line));
    color: var(--ink);
  }
  /* group header rows the island inserts when the reader groups by a class */
  .matrix tbody tr.group > th {
    position: sticky;
    left: 0;
    z-index: 2;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-size: var(--text-2xs);
    font-weight: 500;
    color: var(--ink-muted);
    background: var(--bg-sunken);
    padding: var(--space-2) var(--space-4);
    border-right: 1px solid var(--line);
  }
  .matrix tbody tr.group > td {
    background: var(--bg-sunken);
  }
  .matrix tbody tr.group .n {
    font-family: var(--font-mono);
    color: var(--ink-faint);
    margin-left: var(--space-2);
  }
  tbody tr:hover > * {
    background: color-mix(in oklch, var(--accent-soft) 55%, var(--bg-elevated));
  }

  /* cells */
  .cell {
    position: relative;
  }
  .cell summary {
    list-style: none;
    cursor: pointer;
    display: inline-grid;
    place-items: center;
    padding: 0.15rem;
    border-radius: 9px;
    transition: transform var(--dur-fast) var(--ease);
  }
  .cell summary::-webkit-details-marker {
    display: none;
  }
  .cell summary:hover {
    transform: scale(1.12);
  }
  .cell summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }
  .cell[open] > :global(.detail) {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    background: var(--bg-elevated);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    padding: var(--space-4);
    text-align: left;
    width: 22rem;
    max-width: 80vw;
  }
  .matrix [hidden] {
    display: none;
  }
</style>
