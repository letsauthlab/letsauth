---
import { cellKey, featureInRevision, type Matrix, type RevisionDiff } from "@/lib/atlas";
import { ACCESS_LABEL, AUTH_LABEL, accessOf, authOf } from "@/lib/classes";
import { CATEGORY_LABEL, PARTY_LABEL, PARTY_SHORT } from "@/lib/labels";
import type { ScanView } from "@/lib/scanner";
import ObservationDetail from "./ObservationDetail.astro";
import StatusCell from "./StatusCell.astro";

interface Props {
  matrix: Matrix;
  /** Diff against the previous revision, used to badge columns whose level changed. */
  diff?: RevisionDiff;
  /**
   * The nightly scanner's latest view per server id. A quiet link next to the server's name
   * opens the requests behind it on the server page; the row's cells already show what the scan found, so nothing is added
   * here and nothing is a sort key.
   */
  scans?: Map<string, ScanView>;
}

const { matrix, diff, scans } = Astro.props;
const { columns, rows, cells, revision } = matrix;

// group columns by category for the top header row
const groups: { category: string; count: number }[] = [];
for (const f of columns) {
  const last = groups[groups.length - 1];
  if (last && last.category === f.category) last.count += 1;
  else groups.push({ category: f.category, count: 1 });
}

/*
 * On phones (below 40rem) the matrix is read one way at a time: "All" draws every requirement
 * as a dense strip per server, and each group shows only its own columns at a readable width.
 * The choice is a row of plain anchors, so it works without JavaScript through :target; the
 * island records it as data-view instead, so it can switch without a scroll jump. Each group's
 * columns are a contiguous run, so hiding the others is one nth-child range per group.
 */
let firstColumn = 1;
const ranges = groups.map((g) => {
  const range = { ...g, from: firstColumn, to: firstColumn + g.count - 1 };
  firstColumn += g.count;
  return range;
});
const inGroup = (c: string) =>
  `.matrix-view:is([data-view="${c}"], :not([data-view]):has(#mx-${c}:target))`;
const atAll =
  '.matrix-view:is([data-view="all"], :not([data-view]):not(:has(.matrix-tabs a:not(#mx-all):target)))';
const phoneCss = `@layer product{@media (max-width: 40rem){${ranges
  .map(
    (r) =>
      `${inGroup(r.category)} tr[data-server]>td:not(:nth-child(n+${r.from + 1}):nth-child(-n+${r.to + 1})),${inGroup(r.category)} thead th[data-category]:not([data-category="${r.category}"]){display:none}`,
  )
  .join("")}${atAll} tr[data-server]>td:is(${ranges
  .slice(1)
  .map((r) => `:nth-child(${r.from + 1})`)
  .join(",")}){border-left:1px solid var(--rule)}}}`;

/*
 * Wide screens (follow-up 6): the table fits the column instead of scrolling past its edge. A
 * group whose label is wider than its columns, such as a one-column "Transport", takes the
 * label's width; the other columns share what is left. The label width is an estimate from its
 * length in --tiny Geist, a little generous; the island redoes the sums when a filter changes
 * the groups.
 */
const NARROW_COLUMN_REM = 2.75;
const labelOf = (c: string) => CATEGORY_LABEL[c as keyof typeof CATEGORY_LABEL] ?? c;
const labelRem = (c: string) => Math.ceil((labelOf(c).length * 0.42 + 0.875) * 4) / 4;
const narrow = groups.filter((g) => labelRem(g.category) > g.count * NARROW_COLUMN_REM);
const narrowRem = narrow.reduce((sum, g) => sum + labelRem(g.category), 0);
const wideCols = columns.length - narrow.reduce((sum, g) => sum + g.count, 0);

const changedIds = new Map(diff?.changed.map((c) => [c.feature.id, c]) ?? []);
const addedIds = new Set(diff?.added.map((f) => f.id) ?? []);
const changesHref = diff ? `/mcp/changes/${diff.from.id}/${diff.to.id}/` : undefined;
const columnTitle = (name: string, party: string, level: string) => `${name}, ${party}, ${level}`;
const shortLabel = (id: string) => id.split(".").slice(2).join(".") || id;
---

<div class="matrix-view" data-matrix-view>
<nav class="matrix-tabs" aria-label="Requirement groups">
  <a id="mx-all" href="#mx-all">All <span class="matrix-tabs__count">{columns.length}</span></a>
  {
    groups.map((g) => (
      <a id={`mx-${g.category}`} href={`#mx-${g.category}`}>
        {CATEGORY_LABEL[g.category as keyof typeof CATEGORY_LABEL] ?? g.category}{" "}
        <span class="matrix-tabs__count">{g.count}</span>
      </a>
    ))
  }
</nav>
<p class="matrix-tabs__hint">
  All shows every requirement at a glance. A group shows its cells, and each cell opens its
  observation. A server's name opens its page with every requirement.
</p>
<style is:inline set:html={phoneCss}></style>
<div class="matrix-scroll" tabindex="0" role="region" aria-label="Support matrix, scrolls horizontally">
  <div class="matrix-clip">
    <table
      class="matrix"
      id="matrix"
      data-matrix-revision={revision.id}
      style={`--cols: ${columns.length}; --wide-cols: ${wideCols}; --narrow-w: ${narrowRem}rem`}
    >
      <caption class="visually-hidden">
        Support for each feature of MCP Authorization {revision.id} by server. Rows are servers in
        alphabetical order; columns are features grouped by category.
      </caption>
      <colgroup>
        <col class="matrix__server-col" />
        <col class="matrix__feature-col" span={columns.length} />
      </colgroup>
      <thead>
        <tr class="groups">
          <td></td>
          {
            groups.map((g) => (
              <th
                scope="colgroup"
                colspan={g.count}
                data-category={g.category}
                data-label-rem={labelRem(g.category)}
                data-narrow={narrow.includes(g) ? "" : undefined}
                style={`--n: ${g.count}; --label: ${labelRem(g.category)}rem`}
              >
                <span>{labelOf(g.category)}</span>
              </th>
            ))
          }
        </tr>
        <tr class="features">
          <th scope="col" class="server-head">
            <span class="server-head__label">Server</span>
            <span class="server-head__hint">
              {rows.length} listed, A to Z
              {scans && (
                <>
                  {" · "}
                  <a href="/mcp/scanner/">nightly scan</a>
                </>
              )}
            </span>
          </th>
          {
            columns.map((f) => {
              const entry = featureInRevision(f, revision.id);
              const level = entry?.level ?? "MUST";
              const changed = changedIds.get(f.id);
              const added = addedIds.has(f.id);
              return (
                <th
                  scope="col"
                  data-feature={f.id}
                  data-level={level}
                  data-category={f.category}
                  data-party={f.party}
                  title={columnTitle(f.name, PARTY_LABEL[f.party], level)}
                >
                  <div class="feature-head">
                    <span class="feature-marks">
                      {changed && changesHref && (
                        <a
                          class="changed"
                          href={changesHref}
                          title={`Level changed from ${changed.from} to ${changed.to} in ${revision.id}`}
                        >
                          <span class="visually-hidden">Level changed in {revision.id}</span>
                        </a>
                      )}
                      {added && changesHref && (
                        <a class="changed new" href={changesHref} title={`New in ${revision.id}`}>
                          <span class="visually-hidden">New in {revision.id}</span>
                        </a>
                      )}
                    </span>
                    <a class="feature-link" href={`/mcp/features/${f.id}/`}>
                      <span class="feature-short">{shortLabel(f.id)}</span>
                      <span class="visually-hidden">{f.name}</span>
                    </a>
                    <span class:list={["level", `level-${level}`]} aria-label={`Level ${level}`}>
                      {level}
                    </span>
                    <span class="party" title={PARTY_LABEL[f.party]}>
                      <span aria-hidden="true">{PARTY_SHORT[f.party]}</span>
                      <span class="visually-hidden">{PARTY_LABEL[f.party]}</span>
                    </span>
                  </div>
                </th>
              );
            })
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((server) => {
            const access = accessOf(server);
            const auth = authOf(server);
            const scan = scans?.get(server.id);
            return (
              <tr
                data-server={server.id}
                data-name={server.name.toLowerCase()}
                data-access={access.value}
                data-auth={auth.value}
              >
                <th scope="row" class="server-cell">
                  <span class="server-cell__row">
                    <a class="server-link" href={`/mcp/servers/${server.id}/`}>{server.name}</a>
                    {scan && (
                      <a
                        class="scan-link"
                        href={`/mcp/servers/${server.id}/#scan`}
                        data-scan={scan.summary.state}
                        title={scan.summary.label}
                      >
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                          <path d="M2.5 8h2l1.5-4 3 8 1.5-4h3" />
                        </svg>
                        <span class="visually-hidden">{server.name} scan</span>
                      </a>
                    )}
                  </span>
                  <span class="classes">
                    <span
                      class:list={["class", { derived: access.derived }]}
                      title={`Access: ${ACCESS_LABEL[access.value]}${access.derived ? " (not yet stated)" : ""}`}
                    >
                      <span class="visually-hidden">Access: </span>
                      {ACCESS_LABEL[access.value].toLowerCase()}
                    </span>
                    <span
                      class:list={["class", { derived: auth.derived }]}
                      title={`Auth: ${AUTH_LABEL[auth.value]}${auth.derived ? " (not yet stated)" : ""}`}
                    >
                      <span class="visually-hidden">Auth: </span>
                      {AUTH_LABEL[auth.value].toLowerCase()}
                    </span>
                  </span>
                </th>
                {columns.map((feature) => {
                  const cell = cells.get(cellKey(server.id, feature.id));
                  if (!cell) throw new Error(`missing cell ${server.id}/${feature.id}`);
                  return (
                    <td
                      data-server={server.id}
                      data-feature={feature.id}
                      data-status={cell.status}
                      data-derived={cell.derived ? "true" : "false"}
                    >
                      <details class="cell">
                        <summary aria-label={`${server.name}, ${feature.name}: ${cell.status}`}>
                          <StatusCell status={cell.status} derived={cell.derived} />
                        </summary>
                        <ObservationDetail cell={cell} server={server} feature={feature} />
                      </details>
                    </td>
                  );
                })}
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</div>
</div>

<style is:global>
  @layer reset, tokens, base, layout, components, product, utilities, print;

  /*
   * The matrix. Global rather than scoped: a scoped style puts an attribute on each of the
   * table's thousands of elements, and the page's blocking time grows with them (016 WP4).
   */
  @layer product {
    .matrix-scroll {
      /* positioned so visually-hidden (absolute) labels inside the table stay inside the clip */
      position: relative;
      /* as wide as the table, up to the column: no empty strip to the right of the last column */
      width: fit-content;
      max-width: 100%;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      border-block: 1px solid var(--rule);
      background: var(--ground);
      /* M2: the home page's matrix thumbnail carries the same name and morphs into this */
      view-transition-name: matrix;
    }

    .matrix-scroll:focus-visible {
      outline-offset: 4px;
    }

    /*
     * Clips the column highlight (M9), which reaches far above and below its cell, to the table,
     * and gives it a stacking context to sit in behind the cells.
     */
    .matrix-clip {
      width: max-content;
      overflow: clip;
      isolation: isolate;
    }

    /*
     * A fixed layout: the columns take their widths from the colgroup instead of from measuring
     * every cell, which is most of the page's layout time. The island keeps --cols and the
     * feature column's span equal to the columns shown.
     */
    .matrix {
      --server-w: clamp(11rem, 36vw, 15rem);
      --feature-w: 3rem;
      table-layout: fixed;
      border-collapse: separate;
      border-spacing: 0;
      margin: 0;
      width: calc(var(--server-w) + var(--cols) * var(--feature-w));
      font-variant-numeric: tabular-nums;
    }

    .matrix__server-col {
      width: var(--server-w);
    }

    .matrix__feature-col {
      width: var(--feature-w);
    }

    .matrix th,
    .matrix td {
      border-bottom: 1px solid var(--rule);
      padding: var(--space-2) var(--space-1);
      text-align: center;
      vertical-align: middle;
      font-weight: 500;
      color: var(--ink);
    }

    .matrix tbody tr:last-child > * {
      border-bottom: 0;
    }

    .matrix [hidden] {
      display: none;
    }

    /* category groups */
    .matrix .groups th {
      font-size: var(--tiny);
      color: var(--ink-2);
      background: var(--ground-2);
      padding: var(--space-2);
      border-left: 1px solid var(--rule);
    }

    .matrix .groups th span {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .matrix .groups td {
      background: var(--ground-2);
      position: sticky;
      left: 0;
      z-index: 3;
      border-right: 1px solid var(--rule);
    }

    /* feature columns: a narrow column with its id, level and party written upwards */
    .matrix .features th[data-feature] {
      padding: var(--space-3) 0 var(--space-2);
      vertical-align: bottom;
    }

    .matrix .server-head + th {
      border-left: 1px solid var(--rule);
    }

    .matrix .feature-head {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
    }

    .matrix .feature-link,
    .matrix .feature-head .level {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }

    .matrix .feature-link {
      display: block;
      height: 9.5rem;
      padding-inline: 0.35rem;
      color: var(--ink);
      text-decoration: none;
      border-radius: var(--radius-focus);
    }

    .matrix .feature-short {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--tiny);
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-height: 100%;
    }

    .matrix .feature-link:hover {
      color: var(--signal);
    }

    .matrix .feature-link:hover .feature-short {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    /*
     * The level is quiet text beside the party, not an outlined pill in its level colour: it
     * repeats on every column, and the status glyphs below are what the matrix is for.
     */
    .matrix .feature-head .level {
      padding: 0;
      border: 0;
      color: var(--ink-2);
      font-weight: 500;
      letter-spacing: 0.04em;
    }

    .matrix .party {
      font-family: var(--font-mono);
      font-size: var(--tiny);
      color: var(--ink-2);
    }

    .matrix .feature-marks {
      display: flex;
      justify-content: center;
    }

    /* a column whose level changed is a filled dot, a new one a ring; both link to the diff */
    .matrix .changed {
      display: grid;
      place-items: center;
      width: 1.5rem;
      height: 1.5rem;
      text-decoration: none;
    }

    .matrix .changed::before {
      content: "";
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      border: 1.5px solid var(--signal);
      background: var(--signal);
    }

    .matrix .changed.new::before {
      background: transparent;
    }

    /* the sticky server column, on the ground so the cells pass under it */
    .matrix .server-head,
    .matrix .server-cell {
      position: sticky;
      left: 0;
      z-index: 2;
      background: var(--ground);
      text-align: left;
      border-right: 1px solid var(--rule);
      padding-inline: var(--space-3) var(--space-4);
    }

    .matrix .server-head {
      vertical-align: bottom;
    }

    .matrix .server-head__label {
      display: block;
      font-size: var(--small);
      font-weight: 600;
    }

    .matrix .server-head__hint {
      display: block;
      margin-top: 0.15rem;
      font-size: var(--tiny);
      font-weight: 400;
      color: var(--ink-2);
    }

    .matrix .server-head__hint a {
      color: inherit;
    }

    .matrix .server-cell {
      font-size: var(--small);
      line-height: var(--leading-snug);
    }

    .matrix .server-cell__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }

    .matrix .server-link {
      color: var(--ink);
      text-decoration: none;
    }

    .matrix .server-link:hover {
      color: var(--signal);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    /* the row's own cells are the scan's result; this only opens the requests behind them */
    /*
     * A small trace glyph rather than the word on every row: faint until its row is under the
     * pointer or the focus. Its name is the hidden text, its tooltip the scan's summary.
     */
    .matrix .scan-link {
      flex: none;
      display: inline-grid;
      place-items: center;
      width: 1.25rem;
      height: 1.25rem;
      color: color-mix(in oklch, var(--ink-2) 55%, transparent);
      border-radius: var(--radius-focus);
      transition: color var(--dur-fast) var(--ease);
    }
    .matrix .scan-link svg {
      width: 0.9rem;
      height: 0.9rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .matrix tr:is(:hover, :focus-within) .scan-link {
      color: var(--ink-2);
    }
    .matrix .scan-link:is(:hover, :focus-visible) {
      color: var(--signal);
    }

    /* the row's classes, one quiet line under the name: "public · oauth" */
    .matrix .classes {
      display: flex;
      flex-wrap: wrap;
      margin-top: 0.1rem;
      font-size: var(--tiny);
      color: var(--ink-2);
    }

    .matrix .classes .class + .class::before {
      content: "\00b7";
      /* an inline block takes no part in a derived class's underline */
      display: inline-block;
      padding-inline: 0.4em;
    }

    /* a class nobody has stated yet: dashed underline, like the dashed ring of a recorded unknown */
    .matrix .classes .class.derived {
      text-decoration: underline dashed;
      text-decoration-color: var(--rule-strong);
      text-underline-offset: 0.25em;
    }

    /* group header rows the island inserts when the reader groups by a class */
    .matrix tbody tr.group > th {
      position: sticky;
      left: 0;
      z-index: 2;
      text-align: left;
      font-size: var(--tiny);
      color: var(--ink-2);
      background: var(--ground-2);
      padding: var(--space-2) var(--space-3);
      border-right: 1px solid var(--rule);
    }

    .matrix tbody tr.group > td {
      background: var(--ground-2);
    }

    .matrix tbody tr.group .n {
      margin-left: var(--space-2);
    }

    /*
     * M9, the crosshair: the row under the pointer or the focus takes the signal tint, and its
     * column takes it through a pseudo-element that reaches past the table and is clipped to it.
     * Plain CSS, so it works before and without the island.
     */
    .matrix tbody tr[data-server] > * {
      transition: background-color var(--dur-fast) var(--ease);
    }

    .matrix tbody tr[data-server]:is(:hover, :focus-within) > td {
      background-color: var(--signal-soft);
    }

    .matrix tbody tr[data-server]:is(:hover, :focus-within) > .server-cell {
      background-color: color-mix(in oklch, var(--signal) 14%, var(--ground));
    }

    /* only the cell under the pointer or the focus has the pseudo-element, so the other cells
       stay plain boxes */
    .matrix tbody td:is(:hover, :focus-within) {
      position: relative;
    }

    .matrix tbody td:is(:hover, :focus-within)::after {
      content: "";
      position: absolute;
      inset: -500rem 0;
      z-index: -1;
      pointer-events: none;
      background-color: var(--signal-soft);
    }

    /* cells */
    .matrix .cell summary {
      list-style: none;
      cursor: pointer;
      display: inline-grid;
      place-items: center;
      padding: 0.2rem;
      border-radius: var(--radius-focus);
    }

    .matrix .cell summary::-webkit-details-marker {
      display: none;
    }

    .matrix .cell summary:focus-visible {
      outline: 2px solid var(--signal);
      outline-offset: 1px;
    }

    /* without JavaScript the observation opens under its cell, above it in the last rows and
       leaning left in the last columns, so the table's clip never cuts it */
    .matrix .cell[open] {
      position: relative;
    }

    .matrix .cell[open] > .obs {
      position: absolute;
      top: calc(100% + 0.4rem);
      left: 50%;
      translate: -50% 0;
      z-index: 4;
      width: 22rem;
      max-width: 80vw;
      padding: var(--space-4);
      text-align: left;
      font-weight: 400;
      background: var(--ground-2);
      border: 1px solid var(--rule-strong);
      border-radius: var(--radius);
    }

    .matrix tbody tr:nth-last-child(-n + 6) .cell[open] > .obs {
      top: auto;
      bottom: calc(100% + 0.4rem);
    }

    .matrix tbody td:nth-last-child(-n + 4) .cell[open] > .obs {
      left: auto;
      right: 0;
      translate: none;
    }

    /*
     * Wide screens: the table fits the column. Its widths come from the group row, so a group
     * whose label needs more room than its columns (data-narrow) takes the label's width, and
     * the other columns share the rest, down to a floor below which the frame scrolls.
     */
    @media (width > 40rem) {
      .matrix {
        --feature-w: max(
          2.25rem,
          calc((100cqi - var(--server-w) - var(--narrow-w, 0rem)) / var(--wide-cols, var(--cols)))
        );
        width: calc(
          var(--server-w) + var(--wide-cols, var(--cols)) * var(--feature-w) + var(--narrow-w, 0rem)
        );
      }

      .matrix .matrix__feature-col {
        width: auto;
      }

      .matrix .groups th {
        width: calc(var(--n, 1) * var(--feature-w));
      }

      .matrix .groups th[data-narrow] {
        width: var(--label);
        padding-inline: var(--space-1);
      }
    }

    /* the group picker and its hint exist for phones only */
    .matrix-tabs,
    .matrix-tabs__hint {
      display: none;
    }

    /*
     * Phones (follow-up 5). Two views instead of the desktop table squeezed: "All" fits every
     * requirement into the column as a strip of small glyphs per server, with no sideways scroll;
     * a group shows its own columns at a readable width, with horizontal two-line headers, a
     * peek of the next column and shadows at the edges that scroll. The names link to the server
     * page, which is the same data transposed. .matrix-view:is([data-view="all"], :not([data-view]):not(:has(.matrix-tabs a:not(#mx-all):target))) is the "All" view, .matrix-view:is([data-view]:not([data-view="all"]), :not([data-view]):has(.matrix-tabs a:not(#mx-all):target)) a group's.
     */
    .matrix-view {
      container-type: inline-size;
    }

    @media (max-width: 40rem) {
      .matrix-view {
        --server-w: 7rem;
      }

      .matrix-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1);
        margin: 0 0 var(--space-2);
        /* the anchors are their own targets; keep the jump from hiding the row under the top */
        scroll-margin-top: var(--space-4);
      }

      .matrix-tabs a {
        display: inline-flex;
        gap: 0.35em;
        padding: 0.35em 0.75em;
        min-height: 2.25rem;
        box-sizing: border-box;
        align-items: center;
        font-size: var(--small);
