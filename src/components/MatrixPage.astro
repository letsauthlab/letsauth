---
import {
  currentRevision,
  getSpec,
  matrixFor,
  revisionDiff,
  revisionHref,
  revisionsNewestFirst,
} from "@/lib/atlas";
import {
  ACCESS_DESCRIPTION,
  ACCESS_LABEL,
  ACCESS_ORDER,
  AUTH_DESCRIPTION,
  AUTH_LABEL,
  AUTH_ORDER,
  accessOf,
  authOf,
  countBy,
} from "@/lib/classes";
import { getDataset } from "@/lib/data";
import { CATEGORY_LABEL, PARTY_LABEL, STATUS_ORDER } from "@/lib/labels";
import { latestScan, passiveChecks } from "@/lib/scanner";
import ClassIcon from "./ClassIcon.astro";
import Crumbs from "./Crumbs.astro";
import Matrix from "./Matrix.svelte";
import MatrixTable from "./MatrixTable.astro";
import StatusCell from "./StatusCell.astro";

interface Props {
  revisionId: string;
  /** an older revision's page passes its breadcrumb, which takes the eyebrow's place */
  crumbs?: { trail: { href: string; label: string }[]; current: string };
  /** the home page (spec 019) gives the matrix the site's own title and statement */
  home?: boolean;
  /** cells whose status changed lately, dotted in the matrix */
  changed?: Set<string>;
}

const { revisionId, crumbs, home = false, changed } = Astro.props;
const data = getDataset();
const spec = getSpec(data);
const matrix = matrixFor(data, revisionId);
const current = currentRevision(data);
const isCurrent = revisionId === current.id;
const revisions = revisionsNewestFirst(data);
const previous = matrix.revision.supersedes;
const diff = previous ? revisionDiff(data, previous, revisionId) : undefined;
const levels = ["MUST", "SHOULD", "MAY", "DEPRECATED", "REMOVED"] as const;
const usedLevels = new Set(
  matrix.columns.map((f) => f.revisions.find((r) => r.revision === revisionId)?.level),
);
const usedCategories = [...new Set(matrix.columns.map((f) => f.category))];
// the revisions with a matrix page of their own: one without any observation has none
const otherRevisions = revisions.filter(
  (r) => r.id !== revisionId && revisionHref(data, r.id) !== undefined,
);
const hrefFor = (id: string) => revisionHref(data, id) ?? "/";

// the nightly scanner's view per server: its requests are linked next to the name, never sorted on
const scans = new Map(matrix.rows.map((s) => [s.id, latestScan(data, s, revisionId)]));
const scannerChecks = passiveChecks(data, revisionId).length;

// the access and auth classes of the listed servers (009), for the filters and the legend
const accessCounts = countBy(matrix.rows, ACCESS_ORDER, accessOf);
const authCounts = countBy(matrix.rows, AUTH_ORDER, authOf);
---

{home && <slot name="hero" />}
<div class="wrap">
  {crumbs && <Crumbs trail={crumbs.trail} current={crumbs.current} />}
  {!home && (
  <header class="page-head">
    {!crumbs && (
      <p class="eyebrow">{home ? "An independent lab for agent authorization" : "Matrix"}</p>
    )}
    <h1>{home ? "How MCP servers authorize AI agents" : "Who supports what"}</h1>
    <p class="lede">
      {home
        ? `${matrix.rows.length} MCP servers, checked against the ${matrix.columns.length} requirements of the MCP Authorization spec.`
        : "The public MCP servers we list, against what the MCP Authorization specification requires of servers and their authorization servers. Each cell links to the observation behind it on the server's page."}
    </p>
    <slot name="aside" />
    {!home && (
    <p class="page-head__meta revision-line">
      <span>
        Measured against <a href={matrix.revision.url} rel="noopener">MCP Authorization</a>{" "}
        <strong class="revision-id" data-revision>{matrix.revision.id}</strong>{" "}
        <span class:list={["chip", { signal: isCurrent }]}>
          {isCurrent ? "current" : matrix.revision.status}
        </span>
      </span>
      {otherRevisions.length > 0 && (
      <span>
        {isCurrent ? "Earlier" : "Other revisions"}:{" "}
        {otherRevisions.map((r, i) => (
            <>
              {i > 0 && ", "}
              <a class="revision-other" href={hrefFor(r.id)}>
                {r.id}
              </a>
            </>
          ))}
      </span>
      )}
      {diff && <a href={`/mcp/changes/${diff.from.id}/${diff.to.id}/`}>What changed since {diff.from.id}</a>}
    </p>
    )}
  </header>
  )}

  <div class="matrix-bar">
    <slot name="bar" />
    <details class="filters" id="matrix-filter-panel">
      <summary class="button small quiet">Filter and group</summary>
      <form id="matrix-filters" class="toolbar explainer" method="get" action={hrefFor(revisionId)}>
        <div class="field search">
          <label for="f-q">Search servers</label>
          <div class="search__box">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
            <input id="f-q" name="q" type="search" placeholder="e.g. stripe" autocomplete="off" />
          </div>
        </div>
        <div class="field">
          <label for="f-access">Access</label>
          <select id="f-access" name="access">
            <option value="">Any access</option>
            {accessCounts.map((c) => <option value={c.value}>{ACCESS_LABEL[c.value]} ({c.count})</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-auth">Auth</label>
          <select id="f-auth" name="auth">
            <option value="">Any auth</option>
            {authCounts.map((c) => <option value={c.value}>{AUTH_LABEL[c.value]} ({c.count})</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-group">Group rows</label>
          <select id="f-group" name="group">
            <option value="">A to Z</option>
            <option value="access">By access</option>
            <option value="auth">By auth</option>
          </select>
        </div>
        <div class="field">
          <label for="f-level">Level</label>
          <select id="f-level" name="level">
            <option value="">All levels</option>
            {levels.filter((l) => usedLevels.has(l)).map((l) => <option value={l}>{l}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-category">Category</label>
          <select id="f-category" name="category">
            <option value="">All categories</option>
            {usedCategories.map((c) => <option value={c}>{CATEGORY_LABEL[c]}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-party">Party</label>
          <select id="f-party" name="party">
            <option value="">Both parties</option>
            <option value="mcp-server">{PARTY_LABEL["mcp-server"]}</option>
            <option value="authorization-server">{PARTY_LABEL["authorization-server"]}</option>
          </select>
        </div>
        <div class="field actions">
          <button type="submit" class="button small">Apply</button>
          <button type="reset" class="button small quiet">Reset</button>
        </div>
      </form>
    </details>
  </div>

  <MatrixTable matrix={matrix} diff={diff} scans={scans} changed={changed} />
  <Matrix client:idle />

  <div class="matrix-key">
    <ul class="legend__statuses" aria-label="Legend">
      {
        STATUS_ORDER.map((s) => (
          <li>
            <StatusCell status={s} variant="label" />
          </li>
        ))
      }
      <li>
        <StatusCell status="unknown" derived variant="label" />
      </li>
    </ul>
    <p class="matrix-key__aside">
      <span id="matrix-count" class="count" aria-live="polite" hidden>
        {matrix.rows.length} of {matrix.rows.length} servers, {matrix.columns.length} of{" "}
        {matrix.columns.length} features
      </span>
    </p>
  </div>

  <section class="legend" aria-label="Reading the matrix">
    <div class="legend__group">
      <h2 class="legend__head">Column heads</h2>
      <dl class="legend__list">
        <div>
          <dt>
            <span class="level level-MUST">MUST</span> · <span class="level level-SHOULD">SHOULD</span> ·{" "}
            <span class="level level-MAY">MAY</span>
          </dt>
          <dd>the level the revision puts on the requirement</dd>
        </div>
        <div>
          <dt>
            <abbr title="MCP server (resource server)">RS</abbr> · <abbr title="Authorization server">AS</abbr>
          </dt>
          <dd>the party it is observed on</dd>
        </div>
      </dl>
    </div>
    <div class="legend__group">
      <h2 class="legend__head">Access <span>who can connect</span></h2>
      <ul class="legend__classes">
        {accessCounts.map((c) => (
          <li>
            <ClassIcon kind="access" value={c.value} class="legend__icon" />
            <dfn title={ACCESS_DESCRIPTION[c.value]}>{ACCESS_LABEL[c.value]}</dfn>
            <span class="legend__n">{c.count}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="legend__group">
      <h2 class="legend__head">Auth <span>how clients authenticate</span></h2>
      <ul class="legend__classes">
        {authCounts.map((c) => (
          <li>
            <ClassIcon kind="auth" value={c.value} class="legend__icon" />
            <dfn title={AUTH_DESCRIPTION[c.value]}>{AUTH_LABEL[c.value]}</dfn>
            <span class="legend__n">{c.count}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="legend__group">
      <h2 class="legend__head">Rows</h2>
      <ul class="legend__notes">
        <li>
          <svg class="legend__scan" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8h2l1.5-4 3 8 1.5-4h3" /></svg>
          <span>
            opens what the <a href="/mcp/scanner/">nightly scanner</a> asked; it reads{" "}
            {scannerChecks} requirements from public metadata, on OAuth servers only
          </span>
        </li>
        <li>
          <ClassIcon kind="access" value="unknown" class="legend__icon legend__icon--faint" />
          <span>a faint mark is a class nobody has stated yet</span>
        </li>
        <li class="legend__plain">Alphabetical; nothing is scored or ranked.</li>
      </ul>
    </div>
  </section>

  <slot name="after" />

  <footer class="page-foot prose">
    <p>
      Servers come from public directories and maintainers; the listing reason and source are on
      each server page. A cell shows the newest observation for that server and feature; older
      observations stay in the history. <strong>Unknown</strong> means there is no observation on
      record. The site build contacts no server. The <a href="/mcp/scanner/">scanner</a> reads
      each server's public metadata every night, and its observations arrive here by pull request.
    </p>
    <p class="page-foot__links">
      <a class="button small quiet" href="/mcp/data.json">Download this matrix as JSON</a>
      <a class="button small quiet" href="/contribute/">Add or correct an observation</a>
    </p>
  </footer>
</div>

<style>
  /* the revision the matrix is measured against, and the way to the others, as the head's meta line */
  .revision-line {
    column-gap: var(--space-5);
  }
  .revision-id,
  .revision-other {
    white-space: nowrap;
  }
  .revision-id {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--ink);
  }

  /*
   * The bar right above the matrix: on the left what the page wants to point out in the matrix
   * (the home page: the cells that changed last), on the right the filters folded into one quiet
   * button; opened, they take the bar's full width.
   */
  .matrix-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin: 0 0 var(--space-3);
    font-size: var(--small);
    color: var(--ink-2);
  }
  .filters {
    margin-left: auto;
  }
  .filters > summary {
    list-style: none;
  }
  .filters > summary::-webkit-details-marker {
    display: none;
  }
  .filters > summary::after {
    content: "";
    width: 0.4em;
    height: 0.4em;
    margin: -0.2em 0 0 0.15em;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    rotate: 45deg;
  }
  /* opened, the button stays where it was and the form runs under the whole line */
  .filters[open] {
    flex-basis: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .filters[open] > summary::after {
    margin-top: 0.2em;
    rotate: -135deg;
  }
  .filters[open] > .toolbar {
    align-self: stretch;
    margin: var(--space-3) 0 0;
    color: var(--ink);
  }

  /* under the matrix: the status key and the live count */
  .matrix-key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin: var(--space-4) 0 0;
  }
  .legend__statuses {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    margin: 0;
  }
  .matrix-key__aside .count {
    margin: 0;
  }
  .matrix-key__aside .count[hidden] {
    display: none;
  }
  .matrix-key__aside {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0 0 0 auto;
    font-size: var(--small);
    color: var(--ink-2);
  }

  /* the filters: the part of the page the reader operates, so it sits in an explainer */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3) var(--space-4);
  }
  .search__box {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search__box svg {
    position: absolute;
    left: 0.7em;
    color: var(--ink-2);
    pointer-events: none;
  }
  .search__box input {
    padding-left: 2.2em;
    min-width: 13rem;
  }
  .toolbar .actions {
    flex-direction: row;
    align-items: end;
  }

  /*
   * The legend: four short columns across the page's width, each a heading and a list a glance
   * can take in. The class counts sit in it, so the page needs no facts row of its own.
   */
  .legend {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5) var(--space-6);
    margin: var(--space-5) 0 var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
    font-size: var(--small);
    color: var(--ink-2);
  }
  .legend__head {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--small);
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
  }
  .legend__head span {
    font-weight: 400;
    color: var(--ink-2);
  }
  .legend__head span::before {
    content: "· ";
  }
  .legend__list,
  .legend__classes,
  .legend__notes {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    line-height: 1.45;
  }
  .legend__list dt {
    color: var(--ink);
  }
  .legend__list dd {
    margin: 0;
  }
  /* the levels as the column heads show them: plain text, not in their level colours */
  .legend .level {
    color: var(--ink);
  }
  .legend__classes li {
    display: grid;
    grid-template-columns: 1.1rem 1fr auto;
    align-items: center;
    gap: var(--space-2);
    max-width: 16rem;
  }
  .legend__n {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  .legend dfn {
    font-style: normal;
    color: var(--ink);
    text-decoration: underline dotted;
        text-underline-offset: 0.2em;
    cursor: help;
  }
  .legend :global(.legend__icon) {
    color: var(--ink);
  }
  .legend :global(.legend__icon--faint) {
    color: var(--ink-2);
    opacity: 0.5;
  }
  .legend__notes li {
    display: grid;
    grid-template-columns: 1.1rem 1fr;
    gap: var(--space-2);
    align-items: start;
  }
  .legend__notes li > :first-child {
    margin-top: 0.2em;
  }
  .legend__notes .legend__plain {
    display: block;
    padding-left: calc(1.1rem + var(--space-2));
  }
  .legend__scan {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 64rem) {
    .legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* on a phone the two class lists sit side by side, the two notes run the full width */
  @media (max-width: 40rem) {
    .legend {
      gap: var(--space-5) var(--space-4);
    }
    .legend__group:first-child,
    .legend__group:last-child {
      grid-column: 1 / -1;
    }
    .legend__head span {
      display: block;
    }
    .legend__head span::before {
      content: none;
    }
  }

  @media (max-width: 40rem) {
    .matrix-key {
      gap: var(--space-2) var(--space-4);
    }
    .matrix-key__aside {
      margin-left: 0;
    }
    .legend__statuses {
      gap: var(--space-2) var(--space-3);
    }
    .search__box input {
      min-width: 0;
      width: 100%;
    }
    .field.search {
      width: 100%;
    }
    .toolbar .field:not(.search, .actions) {
      flex: 1 1 8rem;
    }
    .toolbar .field select {
      min-width: 0;
      width: 100%;
    }
  }
</style>
