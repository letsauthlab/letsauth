---
import {
  currentRevision,
  getSpec,
  matrixFor,
  revisionDiff,
  revisionsNewestFirst,
} from "@/lib/atlas";
import {
  ACCESS_DESCRIPTION,
  ACCESS_LABEL,
  ACCESS_ORDER,
  AUTH_DESCRIPTION,
  AUTH_LABEL,
  AUTH_ORDER,
  accessOf,
  authOf,
  countBy,
} from "@/lib/classes";
import { getDataset } from "@/lib/data";
import { CATEGORY_LABEL, PARTY_LABEL, STATUS_ORDER } from "@/lib/labels";
import { latestScan, passiveChecks } from "@/lib/scanner";
import Matrix from "./Matrix.svelte";
import MatrixTable from "./MatrixTable.astro";
import StatusCell from "./StatusCell.astro";

interface Props {
  revisionId: string;
}

const { revisionId } = Astro.props;
const data = getDataset();
const spec = getSpec(data);
const matrix = matrixFor(data, revisionId);
const current = currentRevision(data);
const isCurrent = revisionId === current.id;
const revisions = revisionsNewestFirst(data);
const previous = matrix.revision.supersedes;
const diff = previous ? revisionDiff(data, previous, revisionId) : undefined;
const levels = ["MUST", "SHOULD", "MAY", "DEPRECATED", "REMOVED"] as const;
const usedLevels = new Set(
  matrix.columns.map((f) => f.revisions.find((r) => r.revision === revisionId)?.level),
);
const usedCategories = [...new Set(matrix.columns.map((f) => f.category))];
const hrefFor = (id: string) => (id === current.id ? "/mcp/" : `/mcp/revisions/${id}/`);

// the nightly scanner's grade per server, shown next to the name and never sorted on
const scans = new Map(matrix.rows.map((s) => [s.id, latestScan(data, s, revisionId)]));
const scannerChecks = passiveChecks(data, revisionId).length;

// how much of the matrix has been observed, for the head line
let observedCells = 0;
for (const cell of matrix.cells.values()) if (cell.observation) observedCells += 1;
const totalCells = matrix.rows.length * matrix.columns.length;

// the access and auth classes of the listed servers (009), for the facts, the filters and the legend
const accessCounts = countBy(matrix.rows, ACCESS_ORDER, accessOf);
const authCounts = countBy(matrix.rows, AUTH_ORDER, authOf);
const classWords = (counts: { value: string; count: number }[], label: Record<string, string>) =>
  counts
    .filter((c) => c.count > 0)
    .map((c) => `${c.count} ${label[c.value]?.toLowerCase()}`)
    .join(", ");
---

<div class="wrap">
  <header class="page-head">
    <p class="eyebrow">MCP auth atlas</p>
    <h1>Who supports what in <span class="nowrap">MCP Authorization</span></h1>
    <p class="lede">
      The public MCP servers we list, against the requirements MCP Authorization{" "}
      {matrix.revision.id} puts on servers and their authorization servers. Each cell opens the observation behind it.
    </p>
    <dl class="facts" aria-label="Atlas at a glance">
      <div>
        <dt>Servers</dt>
        <dd class="num">{matrix.rows.length}</dd>
      </div>
      <div>
        <dt>Requirements</dt>
        <dd class="num">{matrix.columns.length}</dd>
      </div>
      <div>
        <dt>Cells observed</dt>
        <dd class="num">{observedCells}<span class="of"> / {totalCells}</span></dd>
      </div>
      <div>
        <dt>Access</dt>
        <dd class="words" data-classes="access">{classWords(accessCounts, ACCESS_LABEL)}</dd>
      </div>
      <div>
        <dt>Auth</dt>
        <dd class="words" data-classes="auth">{classWords(authCounts, AUTH_LABEL)}</dd>
      </div>
    </dl>
  </header>

  <div class="revision-bar" aria-label="Specification revision">
    <div class="revision-bar__id">
      <span class="revision-label">Revision</span>
      <strong class="revision-id" data-revision>{matrix.revision.id}</strong>
      <span class:list={["chip", { signal: isCurrent }]}>
        {isCurrent ? "current" : matrix.revision.status}
      </span>
      <span class="revision-date">
        Published <time datetime={matrix.revision.date}>{matrix.revision.date}</time>
        {" · "}
        <a href={matrix.revision.url} rel="noopener">{spec.name} {matrix.revision.id}</a>
        {" · "}
        <a href="/standards/mcp-authorization/">About this specification</a>
      </span>
    </div>
    <nav class="revision-switch" aria-label="Other revisions">
      <span class="segmented">
        {
          revisions.map((r) =>
            r.id === revisionId ? (
              <span class="segmented__item current" aria-current="page">
                {r.id}
              </span>
            ) : (
              <a class="segmented__item" href={hrefFor(r.id)}>
                {r.id}
              </a>
            ),
          )
        }
      </span>
      {
        diff && (
          <a class="button small quiet" href={`/mcp/changes/${diff.from.id}/${diff.to.id}/`}>
            What changed since {diff.from.id}
          </a>
        )
      }
    </nav>
  </div>

  <form id="matrix-filters" class="toolbar explainer" method="get" action={hrefFor(revisionId)}>
    <div class="field search">
      <label for="f-q">Search servers</label>
      <div class="search__box">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <input id="f-q" name="q" type="search" placeholder="e.g. stripe" autocomplete="off" />
      </div>
    </div>
    <div class="field">
      <label for="f-access">Access</label>
      <select id="f-access" name="access">
        <option value="">Any access</option>
        {accessCounts.map((c) => <option value={c.value}>{ACCESS_LABEL[c.value]} ({c.count})</option>)}
      </select>
    </div>
    <div class="field">
      <label for="f-auth">Auth</label>
      <select id="f-auth" name="auth">
        <option value="">Any auth</option>
        {authCounts.map((c) => <option value={c.value}>{AUTH_LABEL[c.value]} ({c.count})</option>)}
      </select>
    </div>
    <div class="field">
      <label for="f-group">Group rows</label>
      <select id="f-group" name="group">
        <option value="">A to Z</option>
        <option value="access">By access</option>
        <option value="auth">By auth</option>
      </select>
    </div>
    <div class="field">
      <label for="f-level">Level</label>
      <select id="f-level" name="level">
        <option value="">All levels</option>
        {levels.filter((l) => usedLevels.has(l)).map((l) => <option value={l}>{l}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="f-category">Category</label>
      <select id="f-category" name="category">
        <option value="">All categories</option>
        {usedCategories.map((c) => <option value={c}>{CATEGORY_LABEL[c]}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="f-party">Party</label>
      <select id="f-party" name="party">
        <option value="">Both parties</option>
        <option value="mcp-server">{PARTY_LABEL["mcp-server"]}</option>
        <option value="authorization-server">{PARTY_LABEL["authorization-server"]}</option>
      </select>
    </div>
    <div class="field actions">
      <button type="submit" class="button small">Apply</button>
      <button type="reset" class="button small quiet">Reset</button>
    </div>
    <p id="matrix-count" class="count" aria-live="polite">
      {matrix.rows.length} of {matrix.rows.length} servers, {matrix.columns.length} of{" "}
      {matrix.columns.length} features
    </p>
  </form>

  <section class="legend" aria-label="Legend">
    <ul class="legend__statuses">
      {
        STATUS_ORDER.map((s) => (
          <li>
            <StatusCell status={s} variant="label" />
          </li>
        ))
      }
      <li>
        <StatusCell status="unknown" derived variant="label" />
      </li>
    </ul>
    <p class="legend__note">
      <span class="level level-MUST">MUST</span>, <span class="level level-SHOULD">SHOULD</span>
      {" and "}
      <span class="level level-MAY">MAY</span> are the requirement levels the revision puts on the
      feature. <abbr title="MCP server (resource server)">RS</abbr>
      {" and "}
      <abbr title="Authorization server">AS</abbr> name the party the feature is observed on. The
      letter next to a server's name is the <a href="/mcp/scanner/">nightly scanner</a>'s grade over
      the {scannerChecks} requirements it can read from public metadata, by a published rule. It
      opens the server's report. Rows are alphabetical and nothing here ranks servers.
    </p>
    <dl class="legend__classes" aria-label="Access and auth classes">
      <div>
        <dt>Access</dt>
        <dd>
          {ACCESS_ORDER.map((v, i) => (
            <>
              {i > 0 && " · "}
              <dfn title={ACCESS_DESCRIPTION[v]}>{ACCESS_LABEL[v].toLowerCase()}</dfn>
            </>
          ))}
          : who can connect, as the server page's evidence says.
        </dd>
      </div>
      <div>
        <dt>Auth</dt>
        <dd>
          {AUTH_ORDER.map((v, i) => (
            <>
              {i > 0 && " · "}
              <dfn title={AUTH_DESCRIPTION[v]}>{AUTH_LABEL[v].toLowerCase()}</dfn>
            </>
          ))}
          : how the endpoint authenticates clients. A dashed chip is a class nobody has stated
          yet. Both come from the evidence on the server page. API-key and unauthenticated
          servers get no grade.
        </dd>
      </div>
    </dl>
  </section>

  <MatrixTable matrix={matrix} diff={diff} scans={scans} />
  <Matrix client:idle />

  <footer class="page-foot prose">
    <p>
      Servers come from public directories and maintainers; the listing reason and source are on
      each server page. A cell shows the newest observation for that server and feature; older
      observations stay in the history. <strong>Unknown</strong> means there is no observation on
      record. The site build contacts no server. The <a href="/mcp/scanner/">scanner</a> reads
      each server's public metadata every night, and its observations arrive here by pull request.
    </p>
    <p class="page-foot__links">
      <a class="button small quiet" href="/mcp/data.json">Download this matrix as JSON</a>
      <a class="button small quiet" href="/contribute/">Add or correct an observation</a>
    </p>
  </footer>
</div>

<style>
  .nowrap {
    white-space: nowrap;
  }

  /* the revision line: what the matrix is measured against, and the way to the others */
  .revision-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-3) 0;
    border-block: 1px solid var(--rule);
    font-size: var(--small);
    margin-bottom: var(--space-5);
  }
  .revision-bar__id {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .revision-label {
    font-size: var(--tiny);
    font-weight: 500;
    color: var(--ink-2);
  }
  .revision-id {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
  }
  .revision-date {
    color: var(--ink-2);
  }
  .revision-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .segmented {
    display: inline-flex;
    padding: 2px;
    border-radius: var(--radius);
    border: 1px solid var(--rule-strong);
  }
  .segmented__item {
    font-family: var(--font-mono);
    font-size: var(--tiny);
    font-weight: 500;
    padding: 0.4em 0.8em;
    border-radius: calc(var(--radius) - 3px);
    color: var(--ink-2);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .segmented__item:hover {
    color: var(--ink);
  }
  .segmented__item.current {
    background: var(--ground-3);
    color: var(--ink);
  }

  /* the filters: the part of the page the reader operates, so it sits in an explainer */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-5);
  }
  .search__box {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search__box svg {
    position: absolute;
    left: 0.7em;
    color: var(--ink-2);
    pointer-events: none;
  }
  .search__box input {
    padding-left: 2.2em;
    min-width: 13rem;
  }
  .toolbar .actions {
    flex-direction: row;
    align-items: end;
  }
  .count {
    margin-bottom: 0.45em;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    align-items: center;
    margin-bottom: var(--space-5);
    font-size: var(--small);
  }
  .legend__statuses {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    margin: 0;
  }
  .legend__note {
    margin: 0;
    color: var(--ink-2);
    max-width: 62ch;
    font-size: var(--tiny);
    line-height: 1.55;
  }
  .legend__classes {
    flex-basis: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    font-size: var(--tiny);
    color: var(--ink-2);
    line-height: 1.55;
  }
  .legend__classes > div {
    display: contents;
  }
  .legend__classes dt {
    font-weight: 600;
    color: var(--ink);
  }
  .legend__classes dd {
    margin: 0;
    max-width: 80ch;
  }
  .legend__classes dfn {
    font-style: normal;
    color: var(--ink);
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
    cursor: help;
  }

  @media (max-width: 40rem) {
    .count {
      margin-left: 0;
    }
    .search__box input {
      min-width: 0;
      width: 100%;
    }
    .field.search {
      width: 100%;
    }
    .toolbar .field:not(.search, .actions) {
      flex: 1 1 8rem;
    }
    .toolbar .field select {
      min-width: 0;
      width: 100%;
    }
  }
</style>
