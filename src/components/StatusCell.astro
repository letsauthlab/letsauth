---
import { STATUS_META } from "@/lib/labels";
import type { ObservationStatus } from "@/schema";

interface Props {
  status: ObservationStatus;
  derived?: boolean;
  /** "cell" renders the compact glyph used in the matrix; "label" adds the status word. */
  variant?: "cell" | "label";
}

const { status, derived = false, variant = "cell" } = Astro.props;

const meta = STATUS_META[status];
const title = derived ? `${meta.label} (no observation recorded)` : meta.label;
// the glyph on a filled chip: one path, stroked (check, cross) or filled (ring with a half disc)
const GLYPH: Partial<Record<ObservationStatus, string>> = {
  supported: "M4.2 8.4 6.9 11 11.8 5.2",
  partial: "M8 3.4a4.6 4.6 0 1 0 0 9.2a4.6 4.6 0 1 0 0-9.2ZM8 5a3 3 0 0 0 0 6Z",
  unsupported: "M5.2 5.2l5.6 5.6M10.8 5.2l-5.6 5.6",
};
const glyph = GLYPH[status];
---

{
  /*
   * The chip is one element; only the three observed statuses add a one-path SVG for their
   * glyph (a check drawn from CSS stripes did not join cleanly at 20px). The cell variant names
   * itself as an image; the label variant puts the same glyph before the status word.
   */
  variant === "cell" ? (
    <span
      class:list={["status-cell", `status-${status}`, { derived }]}
      data-status={status}
      title={title}
      role="img"
      aria-label={title}
    >
      {glyph && (
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d={glyph} />
        </svg>
      )}
    </span>
  ) : (
    <span class="status-label" data-status={status} title={title}>
      <span class:list={["status-cell", `status-${status}`, { derived }]} aria-hidden="true">
        {glyph && (
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d={glyph} />
        </svg>
      )}
      </span>
      {meta.label}
      {derived && <span class="status-label__note"> no observation</span>}
    </span>
  )
}

<style is:global>
  @layer reset, tokens, base, layout, components, product, utilities, print;

  /*
   * Status glyphs (plan 3.2). Observed statuses are a filled square with the glyph on it; a
   * recorded unknown is a dashed ring, a derived one a faint dot, not applicable a dash. The
   * shapes differ, so the five read apart without colour. No masks, pseudo-elements or
   * transforms: across the matrix's 900 cells each of those cost measurable blocking time.
   */
  @layer product {
    .status-cell {
      --c: var(--status-unknown);
      --on: var(--status-on);
      --size: 1.25rem;
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      width: var(--size);
      height: var(--size);
      border-radius: 22%;
      background-color: var(--c);
      vertical-align: middle;
    }

    .status-label {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      font-size: var(--small);
      font-weight: 500;
      line-height: 1;
      color: var(--ink);
      white-space: nowrap;
      vertical-align: middle;
    }

    .status-label > .status-cell {
      --size: 1rem;
    }

    .status-label__note {
      color: var(--ink-2);
      font-weight: 400;
      font-size: var(--tiny);
    }

    /* supported, partial, unsupported: the glyph is a 16-unit path on the chip */
    .status-supported {
      --c: var(--status-supported);
    }

    .status-partial {
      --c: var(--status-partial);
    }

    .status-unsupported {
      --c: var(--status-unsupported);
    }

    .status-cell > svg {
      width: 100%;
      height: 100%;
      fill: none;
      stroke: var(--on);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .status-partial > svg {
      fill: var(--on);
      fill-rule: evenodd;
      stroke: none;
    }

    /* outline-only forms: the shape alone, centred in the same footprint */
    .status-unknown {
      --inset: calc(var(--size) * 0.14);
      width: calc(var(--size) - 2 * var(--inset));
      height: calc(var(--size) - 2 * var(--inset));
      margin: var(--inset);
      border: 1.5px dashed var(--c);
      border-radius: 50%;
      background: none;
    }

    .status-unknown.derived {
      --inset: calc(var(--size) * 0.37);
      border: 0;
      background-color: color-mix(in oklch, var(--c) 45%, transparent);
    }

    .status-not-applicable {
      --c: var(--status-not-applicable);
      width: calc(var(--size) * 0.45);
      height: 2px;
      margin: calc((var(--size) - 2px) / 2) calc(var(--size) * 0.275);
      border-radius: 1px;
    }

    @media (forced-colors: active) {
      .status-cell {
        forced-color-adjust: none;
        --c: CanvasText;
        --on: Canvas;
      }
    }
  }
</style>
