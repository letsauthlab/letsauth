---
import { STATUS_META } from "@/lib/labels";
import type { ObservationStatus } from "@/schema";

interface Props {
  status: ObservationStatus;
  derived?: boolean;
  /** "cell" renders the compact glyph used in the matrix; "label" adds the status word. */
  variant?: "cell" | "label";
}

const { status, derived = false, variant = "cell" } = Astro.props;

const meta = STATUS_META[status];
const title = derived ? `${meta.label} (no observation recorded)` : meta.label;
---

{
  /*
   * One element per glyph, drawn with its own background, border and ::after, so the matrix
   * carries no SVG per cell (016 WP4). The cell variant names itself as an image; the label
   * variant puts the same glyph before the status word.
   */
  variant === "cell" ? (
    <span
      class:list={["status-cell", `status-${status}`, { derived }]}
      data-status={status}
      title={title}
      role="img"
      aria-label={title}
    />
  ) : (
    <span class="status-label" data-status={status} title={title}>
      <span class:list={["status-cell", `status-${status}`, { derived }]} aria-hidden="true" />
      {meta.label}
      {derived && <span class="status-label__note"> no observation</span>}
    </span>
  )
}

<style is:global>
  @layer reset, tokens, base, layout, components, product, utilities, print;

  /*
   * Status glyphs (plan 3.2). Observed statuses are a filled square with the glyph on it; a
   * recorded unknown is a dashed ring, a derived one a faint dot, not applicable a dash. The
   * shapes differ, so the five read apart without colour. Borders and backgrounds only: an image
   * mask or a grid per glyph cost the matrix a tenth of a second.
   */
  @layer product {
    .status-cell {
      --c: var(--status-unknown);
      --on: var(--status-on);
      --size: 1.25rem;
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      width: var(--size);
      height: var(--size);
      border-radius: 22%;
      background-color: var(--c);
      vertical-align: middle;
    }

    .status-label {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      font-size: var(--small);
      font-weight: 500;
      line-height: 1;
      color: var(--ink);
      white-space: nowrap;
      vertical-align: middle;
    }

    .status-label > .status-cell {
      --size: 1rem;
    }

    .status-label__note {
      color: var(--ink-2);
      font-weight: 400;
      font-size: var(--tiny);
    }

    /*
     * The glyphs are background layers on the chip itself: no pseudo-element and no transform,
     * so a cell stays one plain box. --bar is a 2px stripe along a box's diagonal.
     */
    .status-supported,
    .status-partial,
    .status-unsupported {
      --bar: transparent calc(50% - 1.1px), var(--on) calc(50% - 1.1px) calc(50% + 1.1px),
        transparent calc(50% + 1.1px);
      background-repeat: no-repeat;
    }

    /* supported: a check, two stripes meeting at its foot */
    .status-supported {
      --c: var(--status-supported);
      background-image:
        linear-gradient(to bottom left, var(--bar)), linear-gradient(to bottom right, var(--bar));
      background-size:
        24% 24%,
        40% 44%;
      background-position:
        24% 66%,
        78% 30%;
    }

    /* partial: a ring, half filled */
    .status-partial {
      --c: var(--status-partial);
      background-image:
        radial-gradient(
          circle closest-side,
          transparent calc(100% - 1.6px),
          var(--on) calc(100% - 1.6px) 100%,
          transparent 100%
        ),
        radial-gradient(
          circle calc(var(--size) * 0.31) at left center,
          var(--on) calc(100% - 0.5px),
          transparent 100%
        );
      background-size:
        62% 62%,
        31% 62%;
      /* the half disc's box starts at the chip's centre */
      background-position:
        center,
        calc(var(--size) / 2) 50%;
    }

    /* unsupported: a cross */
    .status-unsupported {
      --c: var(--status-unsupported);
      background-image:
        linear-gradient(to bottom left, var(--bar)), linear-gradient(to bottom right, var(--bar));
      background-size: 50% 50%;
      background-position: center;
    }

    /* outline-only forms: the shape alone, centred in the same footprint */
    .status-unknown {
      --inset: calc(var(--size) * 0.14);
      width: calc(var(--size) - 2 * var(--inset));
      height: calc(var(--size) - 2 * var(--inset));
      margin: var(--inset);
      border: 1.5px dashed var(--c);
      border-radius: 50%;
      background: none;
    }

    .status-unknown.derived {
      --inset: calc(var(--size) * 0.37);
      border: 0;
      background-color: color-mix(in oklch, var(--c) 45%, transparent);
    }

    .status-not-applicable {
      --c: var(--status-not-applicable);
      width: calc(var(--size) * 0.45);
      height: 2px;
      margin: calc((var(--size) - 2px) / 2) calc(var(--size) * 0.275);
      border-radius: 1px;
    }

    @media (forced-colors: active) {
      .status-cell {
        forced-color-adjust: none;
        --c: CanvasText;
        --on: Canvas;
      }
    }
  }
</style>
