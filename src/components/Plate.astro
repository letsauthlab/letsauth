---
import { plate, plateSvg } from "@/lib/plate";

// The decorative plate (plan WP8): a small label-free delegation chain in the explorer's own
// vocabulary (actor heads, lifelines, messages, the trust boundary dash), set into the page head
// beside the title on wide screens. Derived from the page's id and title, so it never changes
// between builds. Hidden from assistive technology and on narrow screens. The highlighted path
// draws in once on load (M4), with no halo or glow under it; under reduced motion it is drawn
// complete. A page that shows data
// above the fold does not place it. Place it as the first child of `header.page-head`, or, with
// `field`, as the field of a `PageBand`, where it is drawn large at the band's right.
interface Props {
  id: string;
  title: string;
  /** Draw it as the field of a page band instead of beside the title. */
  field?: boolean;
}

const { id, title, field = false } = Astro.props;
---

<div class:list={["decor", { "decor--field": field }]} set:html={plateSvg(plate(id, title))} />

<style>
  .decor {
    display: none;
  }
  @media (min-width: 64rem) {
    :global(.page-head:has(> .decor)) {
      display: flow-root;
    }
    .decor {
      display: block;
      float: right;
      width: 18rem;
      margin: 0 0 var(--space-4) var(--space-8);
    }
  }
  /* in a band: as tall as the band allows, at its right edge, lines kept at their own weight */
  @media (min-width: 64rem) {
    .decor--field {
      position: relative;
      float: none;
      width: 100%;
      height: 100%;
      margin: 0;
    }
    .decor--field :global(svg) {
      position: absolute;
      /* from just under the header down past the band's foot, where the lifelines run out */
      top: var(--space-6);
      right: max(var(--gutter), calc((100% - var(--page-max)) / 2));
      width: auto !important;
      height: calc(100% + var(--space-7)) !important;
      max-width: 48%;
    }
    .decor--field :global(svg *) {
      vector-effect: non-scaling-stroke;
    }
    .decor--field :global(.pp) {
      stroke-width: 2.5;
    }
  }
  .decor :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .decor :global(.pb) {
    stroke: var(--boundary);
    stroke-dasharray: 4 4;
    opacity: 0.7;
  }
  .decor :global(.pl) {
    stroke: var(--rule);
  }
  .decor :global(.pa) {
    fill: var(--ground-2);
    stroke: var(--rule-strong);
  }
  .decor :global(.pm) {
    stroke: var(--rule-strong);
  }
  .decor :global(.pp) {
    stroke: var(--signal);
    stroke-width: 2;
  }
  .decor :global(.po) {
    fill: var(--signal);
  }
  @media (prefers-reduced-motion: no-preference) {
    .decor :global(.pp) {
      stroke-dasharray: 1;
      animation: plate-draw var(--dur-draw) var(--ease-draw) both;
    }
    .decor :global(.po) {
      animation: plate-end var(--dur-slow) var(--ease) var(--dur-draw) both;
    }
  }
  @keyframes plate-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  /* the path's ends appear once the path has reached them */
  @keyframes plate-end {
    from {
      opacity: 0;
    }
  }
</style>
