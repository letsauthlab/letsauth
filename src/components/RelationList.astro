---
import { RELATION_LABEL } from "@/lib/labels";
import { RELATION_TYPES, type RelationEntry, type RelationGroups } from "@/lib/standards";
import type { RelationType } from "@/schema";
import MaturityTag from "./MaturityTag.astro";

interface Props {
  groups: RelationGroups;
}

const { groups } = Astro.props;

interface Section {
  id: string;
  heading: string;
  entries: RelationEntry[];
}

// the page's own name is the subject, so the group heading is the verb phrase alone
const sentence = (phrase: string) => phrase.charAt(0).toUpperCase() + phrase.slice(1);

const sections: Section[] = [];
for (const type of RELATION_TYPES) {
  const out = groups.outgoing.get(type);
  if (out?.length) {
    sections.push({
      id: `out-${type}`,
      heading: sentence(RELATION_LABEL[type].forward),
      entries: out,
    });
  }
}
for (const type of RELATION_TYPES) {
  const rel = groups.related.get(type);
  if (rel?.length) {
    sections.push({
      id: `rel-${type}`,
      heading: sentence(RELATION_LABEL[type].forward),
      entries: rel,
    });
  }
}
for (const type of RELATION_TYPES) {
  const inc = groups.incoming.get(type);
  if (inc?.length) {
    sections.push({
      id: `in-${type}`,
      heading: sentence(RELATION_LABEL[type].backward),
      entries: inc,
    });
  }
}
const typeOf = (id: string) => id.replace(/^(out|rel|in)-/, "") as RelationType;
---

{
  sections.length === 0 ? (
    <p class="note">No relations recorded yet. Add one in <code>data/relations.yaml</code>.</p>
  ) : (
    <div class="relations">
      {sections.map((s) => (
        <section class="group" aria-labelledby={s.id} data-relation-group={s.id}>
          <h3 id={s.id}>
            {s.heading} <span class="n">{s.entries.length}</span>
          </h3>
          <ul class="entries" role="list">
            {s.entries.map(({ relation, other }) => (
              <li data-other={other.id} data-type={typeOf(s.id)}>
                <span class="who">
                  <a href={`/standards/${other.id}/`}>{other.name}</a>
                  <MaturityTag maturity={other.maturity} note={other.maturityNote} />
                </span>
                {(relation.note || relation.source) && (
                  <span class="why">
                    {relation.note}
                    {relation.source && (
                      <>
                        {" "}
                        <a class="src" href={relation.source} rel="noopener">
                          Source
                        </a>
                      </>
                    )}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )
}

<style>
  /*
   * The groups flow into as many columns as the width holds, packed top to bottom so a long
   * group leaves no hole beside a short one. Each opens on a hairline with its verb phrase and
   * a count, and lists the other documents without rules between them.
   */
  .relations {
    columns: 19rem;
    column-gap: var(--space-6);
  }
  .group {
    break-inside: avoid;
    margin-bottom: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule-strong);
  }
  .group h3 {
    font-size: var(--small);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink-2);
    margin: 0 0 var(--space-3);
  }
  .entries {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    font-size: var(--small);
  }
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }
  .who a {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .who a:hover {
    color: var(--signal);
  }
  .why {
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .src {
    font-size: var(--tiny);
    white-space: nowrap;
  }
</style>
