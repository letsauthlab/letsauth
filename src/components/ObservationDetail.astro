---
import type { Cell } from "@/lib/atlas";
import type { Feature, Server } from "@/schema";
import StatusCell from "./StatusCell.astro";

interface Props {
  cell: Cell;
  server: Server;
  feature: Feature;
}

const { cell, server, feature } = Astro.props;
const obs = cell.observation;
const evidenceMatch = obs ? obs.evidence.match(/^(https:\/\/\S+)(.*)$/s) : null;
const evidenceUrl = evidenceMatch?.[1];
const evidenceNote = evidenceMatch?.[2]?.trim();
const date = obs ? obs.observedAt.slice(0, 10) : undefined;
---

<div class="obs" data-detail>
  <p class="obs__head">
    <a href={`/mcp/servers/${server.id}/`}>{server.name}</a>
    <span aria-hidden="true">×</span>
    <a href={`/mcp/features/${feature.id}/`}>{feature.name}</a>
  </p>
  <p><StatusCell status={cell.status} derived={cell.derived} variant="label" /></p>
  {
    obs ? (
      <dl class="kv obs__kv">
        <dt>Method</dt>
        <dd>{obs.method}</dd>
        <dt>Observed</dt>
        <dd>
          <time datetime={obs.observedAt}>{date}</time> by {obs.observedBy}
        </dd>
        <dt>Evidence</dt>
        <dd>
          {evidenceUrl ? (
            <>
              <a href={evidenceUrl} rel="noopener">
                {evidenceUrl}
              </a>
              {evidenceNote && <span class="muted"> {evidenceNote}</span>}
            </>
          ) : (
            obs.evidence
          )}
        </dd>
        <dt>Revision</dt>
        <dd>{obs.revision.revision}</dd>
      </dl>
    ) : (
      <p class="muted">
        No observation on record for this server and feature under revision {cell.revision}.
        {cell.status === "not-applicable"
          ? " The server has no HTTP transport, so the feature does not apply."
          : " The status stays unknown until someone records one."}
      </p>
    )
  }
</div>

<style is:global>
  @layer reset, tokens, base, layout, components, product, utilities, print;

  /* Global rather than scoped: the matrix renders one per cell, and scoping adds an attribute
     to every element of every one (016 WP4). */
  @layer product {
    .obs {
      font-size: var(--small);
      min-width: 16rem;
    }

    .obs > p {
      margin: 0 0 var(--space-3);
    }

    .obs__head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-2);
      font-weight: 600;
      line-height: var(--leading-snug);
    }

    .obs__head a {
      color: var(--ink);
      text-decoration: none;
    }

    .obs__head a:hover {
      color: var(--signal);
      text-decoration: underline;
    }

    .obs__head [aria-hidden] {
      color: var(--ink-2);
      font-weight: 400;
    }

    .obs__kv {
      padding-top: var(--space-3);
      border-top: 1px solid var(--rule);
    }
  }
</style>
