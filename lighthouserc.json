{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/mcp/index.html",
        "http://localhost/mcp/servers/stripe/index.html",
        "http://localhost/mcp/features/mcp.as.cimd/index.html",
        "http://localhost/standards/index.html",
        "http://localhost/standards/rfc8693/index.html",
        "http://localhost/explorer/index.html",
        "http://localhost/explorer/mcp-authorization/index.html",
        "http://localhost/breaches/index.html",
        "http://localhost/breaches/cve-2025-4144/index.html",
        "http://localhost/mcp/scanner/index.html",
        "http://localhost/mcp/servers/notion/scan/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 153600
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/report"
    }
  }
}
